---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import PhotoFrame from '../../components/PhotoFrame.astro';
import PortfolioListCard from '../../components/PortfolioListCard.astro';
import { portfolioCases } from '../../data/portfolio';
import { products } from '../../data/products';
import { homeGraph } from '../../lib/seo';

const jsonLd = homeGraph();

const portfolioItems = portfolioCases.slice(0, 3).map((c, i) => ({
  title: c.titleEn || c.title,
  tags: [c.materialEn || c.material],
  description: c.cardLeadEn || c.cardLead,
  href: `/en/work/${c.slugEn || c.slug}/`,
  label: `Story 0${i + 1}`,
  image: c.cardImage,
  image2x: c.cardImage2x,
  alt: c.cardAltEn || c.cardAlt,
}));

const skladem = products.slice(0, 3).map((p, i) => ({
  title: p.titleEn || p.title,
  tags: [p.materialEn || p.material, `Silver · ${p.priceSilverEn || p.priceSilver}`],
  description: p.descriptionEn || p.description,
  href: `/en/jewelry/${p.slugEn || p.slug}/`,
  label: `In stock 0${i + 1}`,
  image: p.imageCard || p.image,
  image2x: p.imageCard || p.image,
  alt: p.altEn || p.alt,
}));

const processSteps = [
  {
    number: '01',
    title: 'Consultation',
    description: 'We meet at the workshop or over the phone. We discuss your idea, materials, and budget. No obligation.',
    image: '/images/homepage--jak-pracuji-01--vykresy.webp',
    image2x: '/images/homepage--jak-pracuji-01--vykresy.webp',
    alt: 'Sketches and design for a piece — consultation at the workshop',
  },
  {
    number: '02',
    title: 'Made by hand',
    description: "I make every piece by hand — from the first sketch to the final polish. I photograph the process so you can see how it comes together.",
    image: '/images/homepage--jak-pracuji-02--snubaky-cerveny-hadr.webp',
    image2x: '/images/homepage--jak-pracuji-02--snubaky-cerveny-hadr.webp',
    alt: 'Wedding bands held on a red cloth — Pod Kesnerkou workshop',
  },
  {
    number: '03',
    title: 'Handover with certificate',
    description: "I hand the piece over in person at the workshop or send it as an insured parcel. Always with a certificate of authenticity.",
    image: '/images/homepage--jak-pracuji-03--predani-sperku.webp',
    image2x: '/images/homepage--jak-pracuji-03--predani-sperku.webp',
    alt: 'Handing over a finished piece with a certificate',
  },
];
---

<Layout
  locale="en"
  title="Martin Ševr — Goldsmith workshop in Prague | Handmade jewellery"
  description="Handmade jewellery in gold, silver and natural stones. Every piece an original. Custom commissions in Prague."
  jsonLd={jsonLd}
  navOverlay
  lcpImageMobile="/images/homepage--hero--vltavin-privesek-mobile.webp"
  lcpImageMobile2x="/images/homepage--hero--vltavin-privesek-mobile@2x.webp"
  lcpImageDesktop="/images/homepage--hero--vltavin-privesek.webp"
  lcpImageDesktop2x="/images/homepage--hero--vltavin-privesek@2x.webp"
>

  <!-- ====== HERO ====== -->
  <section class="relative bg-bg-primary border-b border-border overflow-hidden">
    <div class="radial-overlay"></div>

    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14 relative">
      <div class="grid lg:grid-cols-2 gap-10 sm:gap-12 lg:gap-20 items-start lg:items-center min-h-[80vh] lg:min-h-dvh section-hero">

        <div class="hero-label">
          <span class="label-dot">Goldsmith workshop in Prague — Pod Kesnerkou</span>

          <h1 class="mt-6 hero-headline">
            <span class="block">Jewellery made <em>by hand</em>.</span>
            <span class="block">Not stamped out in batches.</span>
          </h1>

          <p class="subtitle mt-6 hero-copy">
            Custom commissions in gold, silver, and natural stones in a Prague workshop. Every piece comes with a certificate of authenticity and a lifetime guarantee on the workmanship.
          </p>

          <div class="mt-10 flex flex-col sm:flex-row gap-4 hero-btn-group">
            <Button href="/en/custom-jewelry/" variant="primary">I want a piece made for me</Button>
            <Button href="/en/in-stock/" variant="secondary">Finished pieces</Button>
          </div>

          <span class="hero-status mt-8 inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.2em] text-text-secondary font-sans font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-success pulse-dot"></span>
            Taking commissions
          </span>

          <div class="hidden sm:grid grid-cols-3 gap-4 sm:gap-6 mt-10 pt-6 border-t border-border hero-meta">
            <div>
              <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-text-muted font-sans">Location</span>
              <p class="text-[13px] sm:text-[14px] text-text-primary mt-1 font-sans leading-snug">Prague 5 — in-person meetings at the workshop</p>
            </div>
            <div>
              <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-text-muted font-sans">Focus</span>
              <p class="text-[13px] sm:text-[14px] text-text-primary mt-1 font-sans leading-snug">Commissions / made by hand</p>
            </div>
            <div>
              <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-text-muted font-sans">Experience</span>
              <p class="text-[13px] sm:text-[14px] text-text-primary mt-1 font-sans leading-snug">More than 20 years</p>
            </div>
          </div>
        </div>

        <div class="relative hero-img-wrap lg:order-none w-full max-w-[440px] sm:max-w-[520px] md:max-w-[600px] mx-auto lg:max-w-none lg:mx-0 overflow-hidden">
          <picture>
            <source
              media="(min-width: 1024px)"
              srcset="/images/homepage--hero--vltavin-privesek.webp 1x, /images/homepage--hero--vltavin-privesek@2x.webp 2x"
              width="1200" height="900"
            />
            <source
              media="(max-width: 1023px)"
              srcset="/images/homepage--hero--vltavin-privesek-mobile.webp 1x, /images/homepage--hero--vltavin-privesek-mobile@2x.webp 2x"
              width="800" height="600"
            />
            <img
              src="/images/homepage--hero--vltavin-privesek.webp"
              width="1200" height="900"
              alt="Moldavite and rose-quartz pendant — custom commission"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="block w-full h-auto"
            />
          </picture>
          <PhotoFrame />
        </div>

      </div>
    </div>
  </section>

  <!-- ====== SELECTED WORKS ====== -->
  <section class="bg-bg-primary border-b border-border section-lg">
    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">

      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-14">
        <div>
          <span class="label-dot" data-anim="fade">Selected works</span>
          <h2 class="mt-5" data-anim="stagger">
            What's been made at the <em>Pod Kesnerkou</em> workshop
          </h2>
        </div>
        <div data-anim="up">
          <Button href="/en/portfolio/" variant="text">View portfolio</Button>
        </div>
      </div>

      <div class="flex flex-col">
        {portfolioItems.map((item) => (
          <PortfolioListCard
            locale="en"
            href={item.href}
            image={item.image}
            image2x={item.image2x}
            alt={item.alt}
            label={item.label}
            title={item.title}
            description={item.description}
            tags={item.tags}
            imageRatio="wide"
            showCta
            prominentTitle
          />
        ))}
        <div class="border-t border-border"></div>
      </div>

      <div class="mt-12 text-center" data-anim="up">
        <Button href="/en/portfolio/" variant="secondary">Full portfolio</Button>
      </div>

    </div>
  </section>


  <!-- ====== PHILOSOPHY ====== -->
  <section class="relative bg-bg-primary border-b border-border section-lg overflow-hidden">
    <div class="radial-overlay"></div>

    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14 relative">
      <div class="grid lg:grid-cols-[0.34fr_1fr] gap-12 lg:gap-16">

        <div class="lg:border-r lg:border-border lg:pr-10">
          <div class="lg:sticky lg:top-32">
            <span class="label-dot" data-anim="fade">Workshop philosophy</span>
            <p class="body-md text-text-secondary leading-relaxed mt-5 max-w-[260px] font-sans">
              Approaching a piece of jewellery like architecture in miniature. Less is always more.
            </p>
          </div>
        </div>

        <div>
          <p class="font-serif italic display-quote-lg text-text-primary font-normal max-w-3xl" data-anim="up">
            I believe in pieces that
            <em class="text-gold-deep">breathe</em>
            — a craft that strips away what's unnecessary and reveals the
            <em class="text-gold-deep">beauty</em>
            of the material.
          </p>

          <div class="grid md:grid-cols-2 gap-10 mt-14">
            <div data-anim="up">
              <p class="text-text-secondary body-lg font-sans">
                I've been working with gold and silver for more than twenty years. Every piece I make by hand — from the first sketch to the final polish. It isn't only a craft, it's the way I see the world.
              </p>
              <p class="text-text-secondary body-lg mt-4 font-sans">
                Every piece that leaves the workshop carries a bit of my story — and a lot of yours. That's why I don't rush and I don't compromise.
              </p>
            </div>
            <div class="relative overflow-hidden" data-anim="up">
              <img
                src="/images/homepage--o-dilne-preview--ruce-bruseni.webp"
                srcset="/images/homepage--o-dilne-preview--ruce-bruseni.webp 1x, /images/homepage--o-dilne-preview--ruce-bruseni@2x.webp 2x"
                width="800" height="600"
                alt="Close-up of polishing a piece at the workshop"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover grayscale-[15%] sepia-[10%]"
              />
              <PhotoFrame />
              <div class="absolute bottom-4 left-4 bg-bg-primary/90 backdrop-blur-md px-4 py-2.5 shadow-soft">
                <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-gold-on-light font-sans">Workshop on Pod Kesnerkou</span>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-14" data-anim="stagger">
            <div class="border-t border-border pt-5">
              <span class="text-[12px] text-text-muted font-sans">01</span>
              <p class="mt-2 body-md font-medium text-text-primary font-sans">Handmade, no compromise</p>
            </div>
            <div class="border-t border-border pt-5">
              <span class="text-[12px] text-text-muted font-sans">02</span>
              <p class="mt-2 body-md font-medium text-text-primary font-sans">I know where every stone comes from</p>
            </div>
            <div class="border-t border-border pt-5">
              <span class="text-[12px] text-text-muted font-sans">03</span>
              <p class="mt-2 body-md font-medium text-text-primary font-sans">Fewer details, more material</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- ====== METHODOLOGY ====== -->
  <section class="bg-bg-primary border-b border-border section-lg">
    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">

      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-14">
        <div>
          <span class="label-dot" data-anim="fade">How I work</span>
          <h2 class="mt-5" data-anim="stagger">
            From idea to finished piece in <em>three</em> steps.
          </h2>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10" data-anim="stagger">
        {processSteps.map((step) => (
          <div data-anim-child class="group h-full flex flex-col border-b border-border">
            <div class="relative aspect-[4/3] overflow-hidden">
              <img
                src={step.image}
                srcset={`${step.image} 1x, ${step.image2x} 2x`}
                width="800" height="600"
                alt={step.alt}
                loading="lazy"
                decoding="async"
                class="absolute inset-0 w-full h-full object-cover grayscale-[15%] sepia-[10%]"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-text-primary/25 via-transparent to-transparent pointer-events-none"></div>
              <div class="absolute top-4 left-4 h-11 w-11 rounded-full border border-white/60 bg-button-text/85 backdrop-blur-sm flex items-center justify-center text-gold-deep text-[11px] font-medium uppercase tracking-[0.15em] font-sans shadow-plaque">
                {step.number}
              </div>
            </div>
            <div class="pt-5 pb-5 flex-1">
              <h3>{step.title}</h3>
              <p class="body-md text-text-secondary leading-relaxed mt-2 font-sans">
                {step.description}
              </p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ====== IN STOCK PREVIEW ====== -->
  <section class="bg-bg-primary border-b border-border section-lg">
    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">

      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-14">
        <div>
          <span class="label-dot" data-anim="fade">In stock</span>
          <h2 class="mt-5" data-anim="stagger">
            Finished pieces — <em>ready to take home</em>
          </h2>
        </div>
        <div data-anim="up">
          <Button href="/en/in-stock/" variant="text">View stock</Button>
        </div>
      </div>

      <div class="flex flex-col">
        {skladem.map((item) => (
          <PortfolioListCard
            locale="en"
            href={item.href}
            image={item.image}
            image2x={item.image2x}
            alt={item.alt}
            label={item.label}
            title={item.title}
            description={item.description}
            tags={item.tags}
            imageRatio="wide"
            showCta
            prominentTitle
          />
        ))}
        <div class="border-t border-border"></div>
      </div>

      <div class="mt-12 text-center" data-anim="up">
        <Button href="/en/in-stock/" variant="secondary">Full stock</Button>
      </div>

    </div>
  </section>

</Layout>
