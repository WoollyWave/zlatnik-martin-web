---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import FilterPills from '../../components/FilterPills.astro';
import { products } from '../../data/products';
import { graph, productItemList, breadcrumbSchema } from '../../lib/seo';

const categories = [...new Set(products.map(p => p.category))];
const filterLabels = ['All', ...categories.map(c => {
  const map: Record<string, string> = {
    'prsteny': 'Rings',
    'nausnice': 'Earrings',
    'privesky': 'Pendants',
    'retizky': 'Chains',
    'sady': 'Sets',
  };
  return map[c] || c;
})];

const jsonLd = graph(
  productItemList(products),
  breadcrumbSchema([
    { name: 'Home', url: '/en/' },
    { name: 'In stock', url: '/en/in-stock/' },
  ]),
);
---

<Layout
  locale="en"
  title="In stock | Martin Ševr — Goldsmith workshop in Prague"
  ogImage="/images/og/og-skladem.jpg"
  description="Silver pieces with natural stones — ready to collect at the workshop or shipped anywhere. Most models can also be made in gold within three weeks."
  jsonLd={jsonLd}
  navOverlay
  ctaHeading="Something caught your eye? <em>Write to me.</em>"
  ctaSubtitle="Come see the piece at the workshop Pod Kesnerkou, or I'll ship it insured anywhere in Europe."
>

  <!-- ====== HERO ====== -->
  <section class="relative bg-bg-primary border-b border-border section-hero overflow-hidden">
    <div class="radial-overlay"></div>
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <div class="max-w-3xl" data-anim="up">
        <span class="label-dot">In stock</span>
        <h1 class="mt-6">
          Pieces you <em>take home today</em>
        </h1>
        <p class="mt-6 text-text-secondary body-lg max-w-xl">
          Silver rings and pendants with natural stones. Pick up directly at the Pod Kesnerkou workshop, or shipped as an insured parcel anywhere in Czechia within two business days.
        </p>
      </div>
    </div>
  </section>

  <!-- ====== PRODUCTS ====== -->
  <section class="relative bg-bg-primary section-md overflow-hidden">
    <div class="radial-overlay"></div>
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">

      <FilterPills items={filterLabels} activeIndex={0} />

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8 lg:gap-10" id="products-grid">
        {products.map((product) => (
          <ProductCard
            locale="en"
            title={product.titleEn || product.title}
            material={product.materialEn || product.material}
            priceSilver={product.priceSilverEn || product.priceSilver}
            priceGold={product.priceGoldEn || product.priceGold}
            goldNote={product.goldNoteEn || product.goldNote}
            href={`/en/jewelry/${product.slugEn || product.slug}/`}
            category={product.category}
            image={product.imageCard || product.image}
            alt={product.altEn || product.alt}
            description={product.descriptionEn || product.description}
            stockBadge={product.stockBadge}
            headingLevel="h2"
          />
        ))}
      </div>

      <p class="mt-12 max-w-3xl font-serif italic text-[15px] text-text-muted leading-[1.7]" data-anim="up">
        Prices of gold versions are indicative and valid as of {new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}. The gold price changes daily — I'll be happy to give you the current rate over the phone: <a href="tel:+420774598181" class="not-italic font-sans text-gold-on-light hover:text-gold-deep transition-colors font-medium whitespace-nowrap">+420 774 598 181</a>.
      </p>

    </div>
  </section>

</Layout>
