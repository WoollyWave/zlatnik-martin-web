---
import CaseStudyPage from '../../../page-templates/CaseStudyPage.astro';
import { portfolioCases, type PortfolioCase } from '../../../data/portfolio';

export function getStaticPaths() {
  return portfolioCases
    .filter((c) => !!c.slugEn)
    .map((c) => ({
      params: { slug: c.slugEn! },
      props: { caseStudy: c },
    }));
}

interface Props {
  caseStudy: PortfolioCase;
}

const { caseStudy } = Astro.props;
---

<CaseStudyPage locale="en" caseStudy={caseStudy} />
