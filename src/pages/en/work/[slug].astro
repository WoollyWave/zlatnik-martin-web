---
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';
import PhotoFrame from '../../../components/PhotoFrame.astro';
import { portfolioCases, type PortfolioCase } from '../../../data/portfolio';
import { breadcrumbSchema, graph } from '../../../lib/seo';
import { SITE } from '../../../data/site';

const categoryTypeLabels: Record<string, string> = {
  'autorska-tvorba': 'Signature piece',
  'snubni-prsteny': 'Wedding bands',
  'zasnubni-prsteny': 'Engagement',
  'personalizovane': 'Commission',
};

function materialTags(material: string): string[] {
  return material
    .split(/[,·]/)
    .map((t) => t.trim())
    .filter(Boolean)
    .slice(0, 2);
}

export function getStaticPaths() {
  return portfolioCases
    .filter((c) => !!c.slugEn)
    .map((c) => ({
      params: { slug: c.slugEn! },
      props: { caseStudy: c },
    }));
}

interface Props {
  caseStudy: PortfolioCase;
}

const { caseStudy } = Astro.props;
const title = caseStudy.titleEn || caseStudy.title;
const material = caseStudy.materialEn || caseStudy.material;
const intro = caseStudy.introEn || caseStudy.intro;
const heroAlt = caseStudy.heroAltEn || caseStudy.heroAlt;
const processSteps = caseStudy.processStepsEn || caseStudy.processSteps;
const slugEn = caseStudy.slugEn!;

const tags = [...materialTags(material), categoryTypeLabels[caseStudy.category] || 'Commission'];

const currentIndex = portfolioCases.findIndex((c) => c.slug === caseStudy.slug);
const relatedCases = [
  ...portfolioCases.slice(currentIndex + 1),
  ...portfolioCases.slice(0, currentIndex),
].filter((c) => !!c.slugEn).slice(0, 2);

const jsonLd = graph(
  {
    '@type': 'CreativeWork',
    name: title,
    description: intro.slice(0, 200),
    image: `${SITE.url}${caseStudy.cardImage}`,
    creator: {
      '@type': 'Person',
      name: 'Martin Ševr',
      url: `${SITE.url}/en/about/`,
    },
    material,
    inLanguage: 'en-GB',
  },
  breadcrumbSchema([
    { name: 'Home', url: '/en/' },
    { name: 'Portfolio', url: '/en/portfolio/' },
    { name: title, url: `/en/work/${slugEn}/` },
  ]),
);
---

<Layout
  locale="en"
  title={`${title} | Portfolio | Martin Ševr`}
  description={intro.slice(0, 160)}
  ogImage={caseStudy.cardImage}
  jsonLd={jsonLd}
  navOverlay
>

  <!-- ====== HERO ====== -->
  <section class="relative bg-bg-primary border-b border-border section-hero overflow-clip">
    <div class="radial-overlay"></div>
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <div class="grid lg:grid-cols-[0.85fr_1.15fr] gap-10 lg:gap-16 items-start">

        <div data-anim="up">
          <a href="/en/portfolio/" class="inline-flex items-center gap-2 text-[clamp(0.6875rem,0.6rem+0.15vw,0.8125rem)] text-text-muted hover:text-gold-deep transition-colors duration-200 uppercase tracking-[0.2em] font-sans font-medium">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
            </svg>
            Back to portfolio
          </a>

          <h1 class="mt-6">{title}</h1>

          <p class="mt-6 text-text-secondary body-lg max-w-lg">
            {intro}
          </p>

          <div class="mt-10 pt-8 border-t border-border grid grid-cols-2 gap-6">
            <div>
              <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-text-muted font-sans">Material</span>
              <p class="text-[13px] sm:text-[14px] text-text-primary mt-1 font-sans leading-snug">{material}</p>
            </div>
            <div>
              <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-text-muted font-sans">Type</span>
              <div class="flex flex-wrap gap-2 mt-1">
                {tags.map((tag) => (
                  <span class="text-[11px] uppercase tracking-[0.15em] text-text-muted font-sans border border-border px-2.5 py-1">{tag}</span>
                ))}
              </div>
            </div>
          </div>

          <div class="mt-8 flex flex-col sm:flex-row gap-4">
            <Button href="/en/contact/" variant="primary">I want something similar</Button>
            <Button href={SITE.whatsapp} variant="secondary">Message on WhatsApp</Button>
          </div>
        </div>

        <div class="relative order-first lg:order-none lg:sticky lg:top-28 lg:self-start">
          <div class="relative overflow-hidden aspect-square max-w-[640px] mx-auto" data-anim="scale">
            <img
              src={caseStudy.heroImage}
              srcset={`${caseStudy.heroImage} 1x, ${caseStudy.heroImage2x} 2x`}
              width="1280" height="1280"
              sizes="(min-width: 1024px) 640px, 100vw"
              alt={heroAlt}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover"
            />
            <PhotoFrame />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ====== PROCESS ====== -->
  <section class="relative bg-bg-primary border-b border-border section-md overflow-hidden">
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <div data-anim="up">
        <span class="label-dot">Process</span>
        <h2 class="mt-5 max-w-2xl">How it came to be</h2>
      </div>
      <div class="mt-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10" data-anim="stagger">
        {processSteps.map((step) => (
          <div class="border-t border-border pt-5" data-anim-child>
            <span class="text-[12px] text-text-muted font-sans">{step.number}</span>
            <h3 class="mt-3">{step.title}</h3>
            <p class="mt-4 text-text-secondary body-md leading-relaxed font-sans">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ====== GALLERY ====== -->
  <section class="relative bg-bg-primary border-b border-border section-md overflow-hidden">
    <div class="radial-overlay"></div>
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <div data-anim="up">
        <span class="label-dot">Details</span>
        <h2 class="mt-5">Gallery</h2>
        <p class="mt-4 text-text-secondary body-md max-w-md">
          Click to enlarge. Use the arrows or swipe to navigate.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 sm:gap-4 lg:gap-6" data-anim="stagger">
        {caseStudy.gallery.map((photo, i) => {
          const photoAlt = photo.altEn || photo.alt;
          const photoCaption = photo.captionEn || photo.caption;
          return (
            <figure data-anim-child class="relative">
              <button
                type="button"
                data-gallery-item
                data-index={i}
                data-src={photo.src}
                data-src2x={photo.src2x || ''}
                data-alt={photoAlt}
                data-caption={photoCaption || ''}
                class="group relative block w-full aspect-square overflow-hidden cursor-zoom-in focus:outline-none focus-visible:ring-2 focus-visible:ring-gold-deep"
                aria-label={`Enlarge photo: ${photoAlt}`}
              >
                <img
                  src={photo.src}
                  srcset={photo.src2x ? `${photo.src} 1x, ${photo.src2x} 2x` : undefined}
                  sizes="(min-width: 1024px) 430px, (min-width: 640px) 50vw, 100vw"
                  alt={photoAlt}
                  width="1200" height="1200"
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.02]"
                  loading="lazy"
                  decoding="async"
                />
                <PhotoFrame />
                <span class="absolute top-3 right-3 w-9 h-9 rounded-full bg-bg-primary/85 backdrop-blur-md border border-border/60 flex items-center justify-center opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-opacity duration-300 pointer-events-none">
                  <svg class="w-4 h-4 text-text-primary" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6" />
                  </svg>
                </span>
              </button>
              {photoCaption && (
                <figcaption class="mt-3 text-text-muted body-md italic font-sans">
                  {photoCaption}
                </figcaption>
              )}
            </figure>
          );
        })}
      </div>
    </div>

    <dialog id="gallery-lightbox" aria-label="Photo gallery" class="lightbox">
      <div class="lightbox__counter" id="lightbox-counter" aria-live="polite"></div>
      <button type="button" id="lightbox-close" aria-label="Close gallery" class="lightbox__close">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <button type="button" id="lightbox-prev" aria-label="Previous photo" class="lightbox__nav lightbox__nav--prev">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <figure class="lightbox__figure">
        <img id="lightbox-img" alt="" />
        <figcaption id="lightbox-caption" class="lightbox__caption"></figcaption>
      </figure>
      <button type="button" id="lightbox-next" aria-label="Next photo" class="lightbox__nav lightbox__nav--next">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </dialog>
  </section>

  <!-- ====== RELATED ====== -->
  <section class="relative bg-bg-primary border-b border-border section-md overflow-hidden">
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">

      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-12">
        <div data-anim="up">
          <span class="label-dot">More from portfolio</span>
          <h2 class="mt-5">You might also <em>like</em></h2>
        </div>
        <div data-anim="up">
          <a href="/en/portfolio/" class="inline-flex items-center gap-2 text-[clamp(0.6875rem,0.6rem+0.15vw,0.8125rem)] text-text-secondary hover:text-gold-deep transition-colors duration-200 uppercase tracking-[0.2em] font-sans font-medium">
            All commissions
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" /></svg>
          </a>
        </div>
      </div>

      <div class="flex flex-col" data-anim="stagger">
        {relatedCases.map((c) => {
          const num = String(portfolioCases.findIndex((p) => p.slug === c.slug) + 1).padStart(2, '0');
          const cTitle = c.titleEn || c.title;
          const cLead = c.cardLeadEn || c.cardLead;
          const cMat = c.materialEn || c.material;
          const cAlt = c.cardAltEn || c.cardAlt;
          const relTags = [...materialTags(cMat), categoryTypeLabels[c.category] || 'Commission'];
          return (
            <a href={`/en/work/${c.slugEn || c.slug}/`}
               class="group relative block border-t border-border py-10 md:py-14"
               data-anim-child>
              <div class="grid grid-cols-1 md:grid-cols-[0.35fr_1fr] gap-8 md:gap-12 lg:gap-16 items-center">

                <div class="relative aspect-[3/2] overflow-hidden">
                  <img
                    src={c.cardImage}
                    srcset={`${c.cardImage} 1x, ${c.cardImage2x} 2x`}
                    width="800" height="600"
                    sizes="(min-width: 768px) 30vw, 100vw"
                    alt={cAlt}
                    loading="lazy"
                    decoding="async"
                    class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700"
                  />
                  <PhotoFrame />
                  <div class="absolute bottom-4 left-4 bg-bg-primary/90 backdrop-blur-md px-4 py-2.5 shadow-soft">
                    <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-gold-on-light font-sans">{`Commission ${num}`}</span>
                  </div>
                </div>

                <div class="pr-14 md:pr-16">
                  <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-gold-on-light font-sans">{`Commission ${num}`}</span>
                  <h3 class="mt-2 card-title group-hover:text-gold-deep transition-colors duration-300">{cTitle}</h3>
                  <p class="body-md text-text-secondary leading-relaxed mt-3 max-w-xl font-sans">{cLead}</p>
                  <div class="flex flex-wrap gap-3 mt-5">
                    {relTags.map((tag) => (
                      <span class="text-[11px] uppercase tracking-[0.15em] text-text-muted font-sans border border-border px-3 py-1.5">{tag}</span>
                    ))}
                  </div>
                  <div class="mt-6">
                    <span class="text-[clamp(0.6875rem,0.6rem+0.15vw,0.8125rem)] text-text-secondary uppercase tracking-[0.2em] font-sans font-medium group-hover:text-gold-deep transition-colors duration-300 inline-flex items-center gap-2">
                      Details
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" /></svg>
                    </span>
                  </div>
                </div>

              </div>

              <div class="hidden md:flex absolute top-10 md:top-14 right-0 h-10 w-10 rounded-full border border-border items-center justify-center group-hover:bg-text-primary group-hover:border-text-primary transition-colors duration-300">
                <svg class="w-4 h-4 text-text-primary group-hover:text-white transition-colors duration-300" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" /></svg>
              </div>
            </a>
          );
        })}
        <div class="border-t border-border"></div>
      </div>

    </div>
  </section>

  <style is:global>
    .lightbox {
      width: 100vw; height: 100vh; max-width: 100vw; max-height: 100vh;
      padding: 0; border: 0; background: transparent; color: var(--color-button-text);
      inset: 0;
    }
    .lightbox::backdrop {
      background: rgba(30, 27, 24, 0.94);
      backdrop-filter: blur(10px);
    }
    .lightbox[open] { display: flex; align-items: center; justify-content: center; }
    .lightbox__figure {
      margin: 0; display: flex; flex-direction: column; align-items: center; justify-content: center;
      max-width: min(92vw, 1400px); max-height: 88vh;
    }
    .lightbox__figure img {
      max-width: 100%; max-height: 78vh; width: auto; height: auto;
      object-fit: contain;
      box-shadow: 0 20px 60px rgba(0,0,0,0.4);
    }
    .lightbox__caption {
      margin-top: 1.5rem; padding: 0 1rem;
      font-family: var(--font-sans); font-style: italic;
      font-size: clamp(0.875rem, 0.8rem + 0.2vw, 1rem);
      color: rgba(250, 251, 248, 0.85);
      text-align: center; max-width: 60ch;
    }
    .lightbox__caption:empty { display: none; }
    .lightbox__counter {
      position: absolute; top: 1.5rem; left: 1.5rem;
      font-family: var(--font-sans); font-size: 0.75rem;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: rgba(250, 251, 248, 0.7);
    }
    .lightbox__close, .lightbox__nav {
      position: absolute; display: inline-flex; align-items: center; justify-content: center;
      width: 48px; height: 48px; border-radius: 9999px;
      background: rgba(250, 251, 248, 0.08); color: var(--color-button-text);
      border: 1px solid rgba(250, 251, 248, 0.18); cursor: pointer;
      transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
    }
    .lightbox__close:hover, .lightbox__nav:hover {
      background: rgba(250, 251, 248, 0.18); border-color: rgba(250, 251, 248, 0.32);
    }
    .lightbox__close:focus-visible, .lightbox__nav:focus-visible {
      outline: 2px solid var(--color-gold-primary); outline-offset: 2px;
    }
    .lightbox__close { top: 1.5rem; right: 1.5rem; }
    .lightbox__nav--prev { left: max(1.5rem, calc((100vw - 1400px) / 2 - 64px)); }
    .lightbox__nav--next { right: max(1.5rem, calc((100vw - 1400px) / 2 - 64px)); }
    @media (max-width: 640px) {
      .lightbox__nav--prev { left: 0.75rem; }
      .lightbox__nav--next { right: 0.75rem; }
      .lightbox__close { top: 0.75rem; right: 0.75rem; width: 40px; height: 40px; }
      .lightbox__counter { top: 0.75rem; left: 0.75rem; }
    }
    @media (prefers-reduced-motion: reduce) {
      .lightbox img { transition: none !important; }
    }
  </style>

  <script>
    const lightbox = document.getElementById('gallery-lightbox') as HTMLDialogElement | null;
    if (lightbox) {
      const imgEl = document.getElementById('lightbox-img') as HTMLImageElement;
      const captionEl = document.getElementById('lightbox-caption') as HTMLElement;
      const counterEl = document.getElementById('lightbox-counter') as HTMLElement;
      const prevBtn = document.getElementById('lightbox-prev')!;
      const nextBtn = document.getElementById('lightbox-next')!;
      const closeBtn = document.getElementById('lightbox-close')!;

      type Photo = { src: string; src2x?: string; alt: string; caption?: string };
      const items = Array.from(document.querySelectorAll<HTMLElement>('[data-gallery-item]'));
      const photos: Photo[] = items.map((el) => ({
        src: el.dataset.src!,
        src2x: el.dataset.src2x || undefined,
        alt: el.dataset.alt!,
        caption: el.dataset.caption || undefined,
      }));
      let idx = 0;

      function render() {
        const p = photos[idx];
        imgEl.src = p.src;
        if (p.src2x) imgEl.srcset = `${p.src} 1x, ${p.src2x} 2x`;
        else imgEl.removeAttribute('srcset');
        imgEl.alt = p.alt;
        captionEl.textContent = p.caption || '';
        counterEl.textContent = `${idx + 1} / ${photos.length}`;
      }

      function open(i: number) {
        idx = i;
        render();
        lightbox!.showModal();
        document.documentElement.style.overflow = 'hidden';
      }
      function close() {
        lightbox!.close();
        document.documentElement.style.overflow = '';
      }
      function next() { idx = (idx + 1) % photos.length; render(); }
      function prev() { idx = (idx - 1 + photos.length) % photos.length; render(); }

      items.forEach((el, i) => {
        el.addEventListener('click', (e) => { e.preventDefault(); open(i); });
      });
      closeBtn.addEventListener('click', close);
      prevBtn.addEventListener('click', prev);
      nextBtn.addEventListener('click', next);

      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) close();
      });
      lightbox.addEventListener('close', () => {
        document.documentElement.style.overflow = '';
      });

      document.addEventListener('keydown', (e) => {
        if (!lightbox.open) return;
        if (e.key === 'ArrowRight') { e.preventDefault(); next(); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); prev(); }
      });

      let touchStartX = 0;
      lightbox.addEventListener('touchstart', (e) => {
        touchStartX = e.touches[0].clientX;
      }, { passive: true });
      lightbox.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - touchStartX;
        if (Math.abs(dx) > 60) { dx > 0 ? prev() : next(); }
      });
    }
  </script>


</Layout>
