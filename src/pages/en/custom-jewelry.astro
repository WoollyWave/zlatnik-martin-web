---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import FAQ from '../../components/FAQ.astro';
import PhotoFrame from '../../components/PhotoFrame.astro';
import ResponsivePicture from '../../components/ResponsivePicture.astro';
import { SITE } from '../../data/site';
import { graph, faqPageSchema, customJewelryServiceSchema, breadcrumbSchema } from '../../lib/seo';

const processSteps = [
  {
    number: '01',
    title: 'Consultation',
    description: "We meet at the workshop or have a call. You show me what you have in mind — a sketch, a photo, or just words. We discuss the material, the timing and the budget.",
    image: '/images/zakazkova--proces-01--vykresy.webp',
    image2x: '/images/zakazkova--proces-01--vykresy.webp',
    alt: 'Drawings and first sketch of a piece',
  },
  {
    number: '02',
    title: 'Design',
    description: "I prepare a design for your piece. For more complex pieces I make a 3D model or a wax prototype. Nothing is made until you've agreed.",
    image: '/images/zakazkova--proces-02--vykres2.webp',
    image2x: '/images/zakazkova--proces-02--vykres2.webp',
    alt: 'Detailed drawing of a piece',
  },
  {
    number: '03',
    title: 'Making',
    description: "Every piece I make by hand in my workshop. I photograph each step — you'll know how your piece is coming together. No production line, no compromises.",
    image: '/images/zakazkova--proces-03--vyroba.webp',
    image2x: '/images/zakazkova--proces-03--vyroba.webp',
    alt: 'Handmaking a piece at the Pod Kesnerkou workshop',
  },
  {
    number: '04',
    title: 'Handover',
    description: "Collect the piece in person at the workshop, or I'll ship it insured. Every piece comes with a certificate of authenticity — and the option to bring it in once a year for a free professional clean, for the lifetime of the piece.",
    image: '/images/zakazkova--proces-04--predani.webp',
    image2x: '/images/zakazkova--proces-04--predani.webp',
    alt: 'Finished piece — handing it to the client',
  },
];

const materials = [
  {
    title: 'Gold and silver',
    description: 'I work with 585/1000 (14 kt) and 750/1000 (18 kt) gold, and 925/1000 sterling silver. All metals certified and hallmarked.',
  },
  {
    title: 'Precious stones',
    description: 'Diamonds, sapphires, rubies, emeralds. Every stone hand-picked from verified suppliers with certification.',
  },
  {
    title: 'Natural stones',
    description: 'Opals, garnets, amethysts, moonstones, tourmalines. I select a stone that matches your wish and your budget.',
  },
];

const pricingSilver = [
  { item: 'Simple ring', price: 'from CZK 2,500' },
  { item: 'Ring with a stone', price: 'from CZK 3,500' },
  { item: 'Earrings (pair)', price: 'from CZK 2,800' },
  { item: 'Pendant', price: 'from CZK 1,800' },
  { item: 'Necklace', price: 'from CZK 4,500' },
];

const pricingGold = [
  { item: 'Simple ring (585/1000)', price: 'from CZK 8,000' },
  { item: 'Ring with a stone (585/1000)', price: 'from CZK 12,000' },
  { item: 'Wedding bands (pair, 585/1000)', price: 'from CZK 18,000' },
  { item: 'Earrings (pair, 585/1000)', price: 'from CZK 9,000' },
  { item: 'Necklace (585/1000)', price: 'from CZK 15,000' },
];

const scatteredGallery = [
  { pos: 'top-[5%] left-[-3%] w-[28%] max-w-[320px]',    float: 0.3, base: 'zakazkova--proces-03--snubaky-v-ruce-vyroba',     w: 800,  h: 600 },
  { pos: 'top-[3%] left-[35%] w-[18%] max-w-[220px]',    float: 0.4, base: 'zakazkova--proces-01--3d-cad-navrh',               w: 800,  h: 600 },
  { pos: 'top-[2%] right-[5%] w-[25%] max-w-[300px]',    float: 0.3, base: 'homepage--portfolio-3--snubni-prsteny-zlate',      w: 800,  h: 600 },
  { pos: 'top-[40%] left-[-5%] w-[14%] max-w-[160px]',   float: 0.6, base: 'zakazkova--materialy--opal-na-dreve',              w: 800,  h: 600 },
  { pos: 'top-[35%] right-[-2%] w-[22%] max-w-[260px]',  float: 0.5, base: 'homepage--portfolio-2--privesek-citrin',           w: 800,  h: 600 },
  { pos: 'bottom-[8%] left-[8%] w-[22%] max-w-[270px]',  float: 0.7, base: 'zakazkova--proces-04--privesek-J-na-krku-predani', w: 800,  h: 600 },
  { pos: 'bottom-[3%] right-[25%] w-[20%] max-w-[240px]', float: 0.6, base: 'zakazkova--proces-02--3d-cad-perspektiva',         w: 800,  h: 600 },
  { pos: 'bottom-[5%] right-[2%] w-[18%] max-w-[200px]', float: 0.8, base: 'zakazkova--parallax--tricolor-prsten-na-kovadline', w: 1920, h: 1080 },
];

const secondLife = [
  {
    number: '01',
    title: "Grandmother's piece",
    description: "I'll remake a worn band and keep the stone. The character of the piece stays — you just get to wear it again.",
  },
  {
    number: '02',
    title: 'Lost pair',
    description: "I'll make the missing earring or ring so it's indistinguishable from the original. Working from photos and the surviving piece.",
  },
  {
    number: '03',
    title: 'Discreet commission',
    description: 'An engagement ring that should stay a secret. Consultation by phone, work done quietly, standard timeline 3–4 weeks.',
  },
];

const faqItems = [
  {
    question: 'What do I get extra when I buy a piece from you?',
    answer: "Every piece I make for you can be brought in once a year for a free professional clean — for the lifetime of the piece. Just get in touch and we'll arrange a date. You keep the piece in its original shine without needing to go anywhere else.",
  },
  {
    question: 'How long does a custom piece take?',
    answer: "A simple piece (a ring, a pendant) I make within 2–3 weeks. More complex pieces with stones or engravings take 4–6 weeks. For rush orders we agree individually.",
  },
  {
    question: 'How much does a custom piece cost?',
    answer: "The price depends on the material, complexity, and stones. Silver pieces start at CZK 2,500, gold at CZK 8,000. I prepare a precise quote after the consultation.",
  },
  {
    question: 'Can you repair or alter an existing piece?',
    answer: 'Yes — I repair and alter pieces. Resizing rings, replacing stones, fixing clasps. Bring the piece into the workshop and we can discuss what is possible.',
  },
  {
    question: 'How does the consultation work?',
    answer: "Call or message on WhatsApp. We can meet at the workshop in Prague 5, or do everything remotely — by phone, email or video call.",
  },
  {
    question: 'Do you offer a warranty on your pieces?',
    answer: "Every piece carries a lifetime warranty on material and workmanship defects. Normal wear (scratches, patina) isn't covered, but I'm happy to help with maintenance.",
  },
];

const jsonLd = graph(
  faqPageSchema(faqItems),
  customJewelryServiceSchema(),
  breadcrumbSchema([
    { name: 'Home', url: '/en/' },
    { name: 'Custom jewellery', url: '/en/custom-jewelry/' },
  ]),
);
---

<Layout
  locale="en"
  title="Custom jewellery | Martin Ševr — Goldsmith workshop in Prague"
  description="Your piece made for you. I work with gold, silver and natural stones. Consultation, design, making, handover."
  navOverlay
  jsonLd={jsonLd}
  ctaHeading="Tell me what you have <em>in mind</em>."
  ctaSubtitle="A quick call or message is enough. We'll talk through materials, budget and timing — no commitment, no pressure."
>

  <!-- ====== HERO ====== -->
  <section class="relative bg-bg-primary border-b border-border overflow-hidden min-h-0 md:min-h-dvh">

    <div class="hidden md:block absolute inset-0 pointer-events-none" aria-hidden="true">
      {scatteredGallery.map((img) => (
        <div class={`absolute ${img.pos}`} data-float={img.float}>
          <img
            src={`/images/${img.base}.webp`}
            srcset={`/images/${img.base}.webp 1x, /images/${img.base}@2x.webp 2x`}
            alt="" width={img.w} height={img.h} loading="lazy" decoding="async"
            class="w-full h-auto object-cover shadow-scatter"
          />
        </div>
      ))}
    </div>

    <div class="relative z-10 flex flex-col items-start text-left justify-start md:items-center md:text-center md:justify-center px-6 sm:px-8 lg:px-14 section-hero md:py-0 min-h-[80vh] md:min-h-dvh">
      <span class="label-dot" data-anim="fade">Custom jewellery</span>
      <h1 class="mt-6 max-w-3xl" data-anim="up">
        A piece <em>made for you</em>. You approve the design before anything is made.
      </h1>
      <p class="subtitle mt-6" data-anim="up">
        Tell me your idea. Together we'll pick the material, the stone and the timing. The consultation is free and without obligation — you only pay once the design is approved.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-4 w-full sm:w-auto" data-anim="up">
        <Button href="#process" variant="primary">Request a piece</Button>
        <Button href="#pricing" variant="secondary">Price guide</Button>
      </div>

      <div class="md:hidden mt-12 w-full">
        <ResponsivePicture
          base="zakazkova--hero--privesek-quartz-na-krku"
          width="1920" height="1080"
          alt="Custom jewellery making"
          loading="eager"
          fetchpriority="high"
          class="w-full h-auto object-cover" />
      </div>
    </div>
  </section>

  <!-- ====== PROCESS ====== -->
  <section id="process" class="relative bg-bg-primary border-b border-border section-md overflow-hidden">
    <div class="radial-overlay"></div>
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <span class="label-dot" data-anim="fade">Process</span>
      <h2 class="mt-5 max-w-2xl" data-anim="up">How your piece comes together — step by step</h2>
      <p class="mt-4 text-text-secondary max-w-lg" data-anim="up">From the first word to the finished piece. You see every stage.</p>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10 mt-14" data-anim="stagger">
        {processSteps.map((step) => (
          <div data-anim-child class="group">
            <div class="relative aspect-square overflow-hidden">
              <img
                src={step.image}
                srcset={`${step.image} 1x, ${step.image2x} 2x`}
                width="1200" height="1200"
                alt={step.alt}
                loading="lazy"
                decoding="async"
                class="absolute inset-0 w-full h-full object-cover grayscale-[15%] sepia-[10%]"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[rgba(30,27,24,0.25)] via-transparent to-transparent pointer-events-none"></div>
              <div class="absolute top-4 left-4 h-11 w-11 rounded-full border border-white/60 bg-button-text/85 backdrop-blur-sm flex items-center justify-center text-gold-deep text-[11px] font-medium uppercase tracking-[0.15em] font-sans shadow-plaque">
                {step.number}
              </div>
            </div>
            <div class="pt-5 pb-5 border-b border-border">
              <h3>{step.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-text-secondary font-sans">{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ====== MATERIALS ====== -->
  <section class="relative bg-bg-primary border-b border-border section-md">
    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <span class="label-dot" data-anim="fade">Materials</span>
      <h2 class="mt-5 max-w-2xl" data-anim="up">Certified metals, hand-picked stones</h2>
      <p class="mt-4 text-text-secondary max-w-lg" data-anim="up">I know where every material comes from — and why I'm using it.</p>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center mt-14" data-anim="up">
        <div class="relative overflow-hidden" data-anim="scale">
          <img
            src="/images/zakazkova--materialy--opal-na-dreve.webp"
            srcset="/images/zakazkova--materialy--opal-na-dreve.webp 1x, /images/zakazkova--materialy--opal-na-dreve@2x.webp 2x"
            width="800" height="600"
            alt="Opal on a wooden surface — raw material"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover grayscale-[15%] sepia-[10%]"
          />
          <PhotoFrame />
        </div>
        <div class="space-y-8">
          {materials.map((mat) => (
            <div>
              <h3>{mat.title}</h3>
              <p class="mt-2 text-text-secondary body-md leading-relaxed">{mat.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ====== SECOND LIFE ====== -->
  <section id="second-life" class="relative bg-bg-primary border-b border-border section-lg overflow-hidden">
    <div class="radial-overlay"></div>

    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14 relative">
      <div class="grid lg:grid-cols-[0.34fr_1fr] gap-12 lg:gap-16">

        <div class="lg:border-r lg:border-border lg:pr-10">
          <div class="lg:sticky lg:top-32">
            <span class="label-dot" data-anim="fade">Repairs and remakes</span>
            <p class="body-md text-text-secondary leading-relaxed mt-5 max-w-[260px] font-sans">
              Grandmother's pieces, lost pairs, old bands. Most things I can handle within a few weeks.
            </p>
          </div>
        </div>

        <div>
          <p class="font-serif italic display-quote-lg text-text-primary font-normal max-w-3xl" data-anim="up">
            I give pieces
            <em class="text-gold-deep">a second life</em>
            — so you can keep wearing what you
            <em class="text-gold-deep">love</em>.
          </p>

          <div class="grid md:grid-cols-2 gap-10 mt-14">
            <div data-anim="up">
              <p class="text-text-secondary body-lg font-sans">
                Repairs, remakes, completing lost pairs. I work with what you have — a stone from your grandmother, a surviving earring from a pair, an old band that has run its course.
              </p>
              <p class="text-text-secondary body-lg mt-4 font-sans">
                If you have your own material, you can bring it in and I'll use it. For pairs, one surviving piece is enough to work from.
              </p>
            </div>
            <div class="relative overflow-hidden" data-anim="up">
              <img
                src="/images/druhy-zivot--hero--martin-pri-praci.webp"
                srcset="/images/druhy-zivot--hero--martin-pri-praci.webp 1x, /images/druhy-zivot--hero--martin-pri-praci@2x.webp 2x"
                width="800" height="600"
                alt="Martin Ševr at the bench with a torch"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover grayscale-[15%] sepia-[10%]"
              />
              <PhotoFrame />
              <div class="absolute bottom-4 left-4 bg-bg-primary/90 backdrop-blur-md px-4 py-2.5 shadow-soft">
                <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-gold-on-light font-sans">Hand repair</span>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-14" data-anim="stagger">
            {secondLife.map((s) => (
              <div data-anim-child class="border-t border-border pt-5">
                <span class="text-[12px] text-text-muted font-sans">{s.number}</span>
                <p class="mt-2 body-md font-medium text-text-primary font-sans">{s.title}</p>
                <p class="mt-2 text-text-secondary body-md leading-relaxed font-sans">{s.description}</p>
              </div>
            ))}
          </div>

          <div class="mt-12 flex flex-col sm:flex-row gap-4">
            <Button href="/en/contact/" variant="primary">Book a consultation</Button>
            <Button href={SITE.whatsapp} variant="secondary">Message on WhatsApp</Button>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ====== PRICING ====== -->
  <section id="pricing" class="relative bg-bg-primary border-b border-border section-md">
    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <span class="label-dot" data-anim="fade">Price guide</span>
      <h2 class="mt-5" data-anim="up">A guide to where it starts</h2>
      <p class="mt-4 text-text-secondary max-w-xl" data-anim="up">Prices depend on the complexity, material and stones. I prepare a precise quote after the consultation — free and without obligation.</p>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 mt-14" data-anim="up">
        <div>
          <h3 class="mb-6">Silver 925/1000</h3>
          <div class="border-t border-border">
            {pricingSilver.map((row) => (
              <div class="flex items-center justify-between py-4 border-b border-border">
                <span class="text-text-primary">{row.item}</span>
                <span class="text-text-secondary font-medium whitespace-nowrap ml-4">{row.price}</span>
              </div>
            ))}
          </div>
        </div>

        <div>
          <h3 class="mb-6">Gold 585/1000</h3>
          <div class="border-t border-border">
            {pricingGold.map((row) => (
              <div class="flex items-center justify-between py-4 border-b border-border">
                <span class="text-text-primary">{row.item}</span>
                <span class="text-text-secondary font-medium whitespace-nowrap ml-4">{row.price}</span>
              </div>
            ))}
          </div>
          <p class="mt-4 body-md text-text-muted">For 750/1000 gold add roughly 30%.</p>
        </div>
      </div>

      <p class="mt-12 max-w-3xl font-serif italic text-[15px] text-text-muted leading-[1.7]" data-anim="up">
        Prices are indicative and valid as of {new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}. The gold price changes daily — I'll be happy to give you the current rate over the phone: <a href={SITE.phoneHref} class="not-italic font-sans text-gold-on-light hover:text-gold-deep transition-colors font-medium whitespace-nowrap">{SITE.phone}</a>.
      </p>
    </div>
  </section>

  <!-- ====== EXPRESS ====== -->
  <section id="express" class="relative bg-bg-primary border-b border-border section-md">
    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <div class="grid lg:grid-cols-[1fr_0.5fr] gap-12 lg:gap-16 items-center" data-anim="up">
        <div>
          <span class="label-dot">Rush orders</span>
          <h2 class="mt-5">Five days is enough. Sometimes <em>less</em>.</h2>
          <p class="mt-4 text-text-secondary body-lg max-w-xl">
            A proposal on Saturday. An anniversary you remembered late. A birthday gift you almost forgot. Simpler pieces — a ring without a stone, a plain chain, a stamped signet — I can make within five working days in 585/1000 gold. Call right away, I'll tell you whether it can be done and what it will cost.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-4">
            <Button href={SITE.phoneHref} variant="primary">Call</Button>
            <Button href={SITE.whatsapp} variant="secondary">Message on WhatsApp</Button>
          </div>
        </div>
        <div class="hidden lg:block" data-anim="scale">
          <img
            src="/images/zakazkova--express--prsten-safir.webp"
            srcset="/images/zakazkova--express--prsten-safir.webp 1x, /images/zakazkova--express--prsten-safir@2x.webp 2x"
            width="600" height="600"
            alt="Pink sapphire ring — rush order"
            loading="lazy"
            decoding="async"
            class="w-full h-auto object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ====== FAQ ====== -->
  <section class="relative bg-bg-primary section-md overflow-hidden">
    <div class="radial-overlay"></div>
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <span class="label-dot" data-anim="fade">FAQ</span>
      <h2 class="mt-5 mb-12" data-anim="up">Frequently asked questions</h2>
      <FAQ items={faqItems} />
    </div>
  </section>


</Layout>
