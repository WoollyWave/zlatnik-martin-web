---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import FAQ from '../components/FAQ.astro';
import { SITE } from '../data/site';
import { graph, jewelryRepairServiceSchema, faqPageSchema, breadcrumbSchema } from '../lib/seo';

const repairTypes = [
  {
    number: '01',
    title: 'Zmenšení a zvětšení prstenu',
    description: 'Změna velikosti prstenu o 1–3 čísla. U zlatých prstenů ze 14k i 18k zlata bez ztráty pevnosti. Hotovo obvykle do 5 pracovních dnů.',
  },
  {
    number: '02',
    title: 'Výměna a doplnění kamenu',
    description: 'Praskl vám kámen v prstenu? Vypadl turmalín z náušnice? Vyměním kámen za nový stejné kvality nebo vám pomůžu vybrat alternativu.',
  },
  {
    number: '03',
    title: 'Oprava ulomených částí',
    description: 'Přetržený řetízek, ulomené zapínání, prasklý kroužek u přívěsku. Opravím i šperky, které vám jinde vrátí jako „neopravitelné".',
  },
  {
    number: '04',
    title: 'Rytí a personalizace',
    description: 'Datum svatby, jméno, motiv. Vyryjte si do vnitřku snubního prstenu nebo přívěsku — strojně i ručně. Možné i u starších kusů.',
  },
  {
    number: '05',
    title: 'Profesionální čištění',
    description: 'Ultrazvukové čištění + leštění. Šperk se vrátí do původního stavu, bez škrábanců a usazenin. Hotovo na počkání.',
  },
  {
    number: '06',
    title: 'Renovace starých šperků',
    description: 'Šperk po babičce, který se nedá nosit? Vyrobím nově obroučku, ponechám původní kámen. Charakter zůstane, šperk znovu ožije.',
  },
];

const faqItems = [
  {
    question: 'Kolik stojí oprava prstenu?',
    answer: 'Záleží na typu opravy. Zmenšení nebo zvětšení prstenu obvykle 400–900 Kč podle materiálu. Výměna kamenu od 600 Kč + cena nového kamene. Oprava řetízku od 300 Kč. Přesnou cenu řeknu po prohlídce šperku.',
  },
  {
    question: 'Jak dlouho oprava trvá?',
    answer: 'Většinu oprav (zmenšení prstenu, oprava zapínání, čištění) zvládnu do 5 pracovních dnů. U složitějších úprav nebo objednání kamenů 2–3 týdny. Expresní opravu domluvíme individuálně.',
  },
  {
    question: 'Opravujete i šperky, které jste nevyrobil?',
    answer: 'Ano, opravuji jakékoli zlaté, stříbrné nebo platinové šperky bez ohledu na to, kdo je vyrobil. Posuďte si stav osobně v dílně Pod Kesnerkou 46, Praha 5.',
  },
  {
    question: 'Můžu vám šperk poslat poštou?',
    answer: 'Ano. Pošlete šperk pojištěnou zásilkou na adresu dílny. Po prohlídce vám zavolám s cenovým návrhem. Hotový šperk zašlu zpět také pojištěně.',
  },
  {
    question: 'Vyrobíte mi i nový šperk z mého starého zlata?',
    answer: 'Pracuji i s vašim materiálem — zlato přetavím a vyrobím z něj nový kus. Jen je potřeba mít alespoň 8 gramů původního zlata stejné ryzosti. Probereme to při konzultaci.',
  },
];

const jsonLd = graph(
  jewelryRepairServiceSchema(),
  faqPageSchema(faqItems),
  breadcrumbSchema([
    { name: 'Domů', url: '/' },
    { name: 'Opravy šperků Praha', url: '/opravy-sperku-praha/' },
  ]),
);
---

<Layout
  title="Opravy šperků Praha | Zlatnická dílna Pod Kesnerkou — Martin Ševr"
  description="Opravy a úpravy šperků v Praze 5. Zmenšení prstenu, výměna kamenu, oprava řetízku, rytí, čištění. 20+ let praxe. Pošlete poštou nebo přineste osobně."
  jsonLd={jsonLd}
  navOverlay
  lcpImageDesktop="/images/opravy--hero--martin-portret.webp"
  lcpImageDesktop2x="/images/opravy--hero--martin-portret@2x.webp"
  ctaHeading="Máte šperk, který potřebuje <em>opravit</em>?"
  ctaSubtitle="Přineste ho do dílny v Praze 5 nebo pošlete pojištěnou poštou. Většinu oprav hotovou do 5 pracovních dnů."
  ctaPrimaryLabel="Domluvit opravu"
>

  <!-- ====== HERO — split layout ====== -->
  <section class="relative bg-bg-primary border-b border-border overflow-hidden">
    <div class="radial-overlay"></div>
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <div class="grid lg:grid-cols-2 gap-10 sm:gap-12 lg:gap-20 items-center min-h-[80vh] lg:min-h-screen section-hero">

        <!-- Text -->
        <div data-anim="up">
          <span class="label-dot">Opravy šperků Praha 5</span>
          <h1 class="mt-6">
            Opravím i šperky, které vám jinde <em>vrátí</em>.
          </h1>
          <p class="mt-6 text-text-secondary body-lg max-w-xl">
            Zmenšení prstenu, výměna kamenu, oprava řetízku, rytí, čištění. Ve vlastní dílně Pod Kesnerkou 46. Většinu oprav hotovou do 5 pracovních dnů.
          </p>
          <div class="mt-10 flex flex-col sm:flex-row gap-4">
            <Button href={SITE.phoneHref} variant="primary">Zavolat zlatníkovi</Button>
            <Button href="/kontakt" variant="secondary">Napsat e-mail</Button>
          </div>
        </div>

        <!-- Photo -->
        <div class="relative">
          <img
            src="/images/opravy--hero--martin-portret.webp"
            srcset="/images/opravy--hero--martin-portret.webp 1x, /images/opravy--hero--martin-portret@2x.webp 2x"
            width="1000" height="1000"
            alt="Martin Ševr v zlatnické dílně s lupínkovou pilkou v rukou — Pod Kesnerkou 46, Praha 5"
            fetchpriority="high"
            decoding="async"
            class="w-full h-auto object-cover aspect-square max-w-[560px] mx-auto"
          />
        </div>

      </div>
    </div>
  </section>

  <!-- ====== REPAIR TYPES ====== -->
  <section class="relative bg-bg-primary border-b border-border section-lg overflow-hidden">
    <div class="radial-overlay"></div>
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">

      <div class="max-w-3xl mb-14" data-anim="up">
        <span class="label-dot">Co opravuji</span>
        <h2 class="mt-5">
          Co všechno ve své dílně zvládnu
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10" data-anim="stagger">
        {repairTypes.map((item) => (
          <div data-anim-child class="border-b border-border pb-8">
            <span class="font-sans text-[11px] font-medium uppercase tracking-[0.2em] text-gold-on-light">{item.number}</span>
            <h3 class="mt-3">{item.title}</h3>
            <p class="body-md text-text-secondary leading-relaxed mt-3 font-sans">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ====== HOW IT WORKS ====== -->
  <section class="relative bg-bg-primary border-b border-border section-md overflow-hidden">
    <div class="radial-overlay"></div>
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <div class="grid lg:grid-cols-[0.4fr_1fr] gap-10 lg:gap-20">
        <div data-anim="up">
          <span class="label-dot">Jak to funguje</span>
          <h2 class="mt-5">Jednoduše. <em>Bez prostředníků</em>.</h2>
        </div>
        <div class="space-y-6 body-md text-text-secondary leading-relaxed font-sans max-w-2xl" data-anim="up">
          <p>
            Přineste šperk do dílny v Praze 5 (Pod Kesnerkou 46) nebo ho pošlete pojištěnou zásilkou. Po prohlídce vám zavolám nebo napíšu s cenovým návrhem a předpokládaným termínem.
          </p>
          <p>
            Pokud cenu odsouhlasíte, pustím se do opravy. Žádné zálohy předem — platíte až při převzetí hotového šperku.
          </p>
          <p>
            Po dokončení vám šperk předám osobně v dílně nebo zašlu pojištěnou zásilkou zpět. K opravám pojištěným poštou napříč ČR posílám během 1–3 pracovních dnů.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== FAQ ====== -->
  <section class="relative bg-bg-primary section-md overflow-hidden">
    <div class="radial-overlay"></div>
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <span class="label-dot" data-anim="fade">Časté otázky</span>
      <h2 class="mt-5 mb-12" data-anim="up">Časté otázky</h2>
      <FAQ items={faqItems} />
    </div>
  </section>

</Layout>
