---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import PortfolioListCard from '../components/PortfolioListCard.astro';
import { portfolioCases } from '../data/portfolio';
import { products } from '../data/products';
import { homeGraph } from '../lib/seo';

const jsonLd = homeGraph();

const portfolioItems = portfolioCases.slice(0, 3).map((c, i) => ({
  title: c.title,
  tags: [c.material],
  description: c.cardLead,
  href: `/tvorba/${c.slug}`,
  label: `Příběh 0${i + 1}`,
  image: c.cardImage,
  image2x: c.cardImage2x,
  alt: c.cardAlt,
}));

const skladem = products.slice(0, 3).map((p, i) => ({
  title: p.title,
  tags: [p.material, `Stříbro · ${p.priceSilver}`],
  description: p.description,
  href: `/sperky/${p.slug}`,
  label: `Skladem 0${i + 1}`,
  image: p.imageCard || p.image,
  image2x: p.imageCard || p.image,
  alt: p.alt,
}));

const processSteps = [
  {
    number: '01',
    title: 'Konzultace',
    description: 'Sejdeme se v dílně nebo po telefonu. Probereme váš nápad, materiály a rozpočet. Bez závazků.',
    image: '/images/homepage--jak-pracuji-01--vykresy.webp',
    image2x: '/images/homepage--jak-pracuji-01--vykresy.webp',
    alt: 'Výkresy a návrh šperku — konzultace v dílně',
  },
  {
    number: '02',
    title: 'Ruční výroba',
    description: 'Každý šperk vyrábím ručně — od prvního náčrtu po finální lesk. Průběh fotím, abyste viděli, jak vzniká.',
    image: '/images/homepage--jak-pracuji-02--snubaky-cerveny-hadr.webp',
    image2x: '/images/homepage--jak-pracuji-02--snubaky-cerveny-hadr.webp',
    alt: 'Snubní prsteny v ruce na červeném hadříku — dílna Pod Kesnerkou',
  },
  {
    number: '03',
    title: 'Předání s certifikátem',
    description: 'Šperk předám osobně v dílně nebo zašlu pojištěnou zásilkou. Vždy s certifikátem pravosti.',
    image: '/images/homepage--jak-pracuji-03--predani-sperku.webp',
    image2x: '/images/homepage--jak-pracuji-03--predani-sperku.webp',
    alt: 'Předání hotového šperku s certifikátem',
  },
];
---

<Layout
  title="Zlatník Praha 5 | Martin Ševr — Ruční výroba a zakázková tvorba šperků"
  description="Zlatník v Praze 5. Ruční výroba šperků na zakázku, snubní prsteny, opravy. 20+ let praxe. Vlastní dílna Pod Kesnerkou."
  jsonLd={jsonLd}
  navOverlay
  lcpImageMobile="/images/homepage--hero--vltavin-privesek-mobile.webp"
  lcpImageMobile2x="/images/homepage--hero--vltavin-privesek-mobile@2x.webp"
  lcpImageDesktop="/images/homepage--hero--vltavin-privesek.webp"
  lcpImageDesktop2x="/images/homepage--hero--vltavin-privesek@2x.webp"
>

  <!-- ====== HERO ====== -->
  <section class="relative bg-bg-primary border-b border-border overflow-hidden">
    <div class="radial-overlay"></div>

    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14 relative">
      <div class="grid lg:grid-cols-2 gap-10 sm:gap-12 lg:gap-20 items-start lg:items-center min-h-[80vh] lg:min-h-dvh section-hero">

        <!-- Text -->
        <div class="hero-label">
          <span class="label-dot">Zlatnická dílna Praha — Pod Kesnerkou</span>

          <h1 class="mt-6 hero-headline">
            <span class="block">Šperky vyrobené <em>ručně</em>.</span>
            <span class="block">Ne anonymně v sérii.</span>
          </h1>

          <p class="subtitle mt-6 hero-copy">
            Zakázková tvorba ze zlata, stříbra a přírodních kamenů v pražské dílně. Každý kus s certifikátem pravosti a doživotní zárukou na zpracování.
          </p>

          <div class="mt-10 flex flex-col sm:flex-row gap-4 hero-btn-group">
            <Button href="/zakazkova-tvorba" variant="primary">Chci šperk na míru</Button>
            <Button href="/skladem" variant="secondary">Hotové šperky</Button>
          </div>

          <span class="hero-status mt-8 inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.2em] text-text-secondary font-sans font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-success pulse-dot"></span>
            Přijímám zakázky
          </span>

          <!-- Meta row — skryté na mobile (clean hero, info dostupné v JSON-LD + /o-dilne + footer) -->
          <div class="hidden sm:grid grid-cols-3 gap-4 sm:gap-6 mt-10 pt-6 border-t border-border hero-meta">
            <div>
              <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-text-muted font-sans">Lokace</span>
              <p class="text-[13px] sm:text-[14px] text-text-primary mt-1 font-sans leading-snug">Praha 5 — osobní setkání v dílně</p>
            </div>
            <div>
              <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-text-muted font-sans">Zaměření</span>
              <p class="text-[13px] sm:text-[14px] text-text-primary mt-1 font-sans leading-snug">Zakázky / ruční výroba</p>
            </div>
            <div>
              <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-text-muted font-sans">Zkušenosti</span>
              <p class="text-[13px] sm:text-[14px] text-text-primary mt-1 font-sans leading-snug">Více než 20 let</p>
            </div>
          </div>
        </div>

        <!-- Photo — mobile/tablet vždy 4:3 (žádný horizontální ořez), desktop natural 4:3 -->
        <div class="relative hero-img-wrap lg:order-none w-full max-w-[440px] sm:max-w-[520px] md:max-w-[600px] mx-auto lg:max-w-none lg:mx-0 overflow-hidden">
          <picture>
            <source
              media="(min-width: 1024px)"
              srcset="/images/homepage--hero--vltavin-privesek.webp 1x, /images/homepage--hero--vltavin-privesek@2x.webp 2x"
              width="1200" height="900"
            />
            <source
              media="(max-width: 1023px)"
              srcset="/images/homepage--hero--vltavin-privesek-mobile.webp 1x, /images/homepage--hero--vltavin-privesek-mobile@2x.webp 2x"
              width="800" height="600"
            />
            <img
              src="/images/homepage--hero--vltavin-privesek.webp"
              width="1200" height="900"
              alt="Přívěsek s vltavínem a růženínem — zakázková tvorba"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="block w-full h-auto"
            />
          </picture>
          <PhotoFrame />
        </div>

      </div>
    </div>
  </section>

  <!-- ====== SELECTED WORKS — Vertical list ====== -->
  <section class="bg-bg-primary border-b border-border section-lg">
    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">

      <!-- Header -->
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-14">
        <div>
          <span class="label-dot" data-anim="fade">Vybran&eacute; pr&aacute;ce</span>
          <h2 class="mt-5" data-anim="stagger">
            Co vzniklo v dílně <em>Pod Kesnerkou</em>
          </h2>
        </div>
        <div data-anim="up">
          <Button href="/portfolio" variant="text">Zobrazit portfolio</Button>
        </div>
      </div>

      <!-- Vertical list -->
      <div class="flex flex-col">
        {portfolioItems.map((item) => (
          <PortfolioListCard
            href={item.href}
            image={item.image}
            image2x={item.image2x}
            alt={item.alt}
            label={item.label}
            title={item.title}
            description={item.description}
            tags={item.tags}
            imageRatio="wide"
            showCta
            prominentTitle
          />
        ))}
        <div class="border-t border-border"></div>
      </div>

      <!-- CTA button -->
      <div class="mt-12 text-center" data-anim="up">
        <Button href="/portfolio" variant="secondary">Celé portfolio</Button>
      </div>

    </div>
  </section>


  <!-- ====== PHILOSOPHY — bg-secondary with left rail ====== -->
  <section class="relative bg-bg-primary border-b border-border section-lg overflow-hidden">
    <div class="radial-overlay"></div>

    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14 relative">
      <div class="grid lg:grid-cols-[0.34fr_1fr] gap-12 lg:gap-16">

        <!-- Left rail -->
        <div class="lg:border-r lg:border-border lg:pr-10">
          <div class="lg:sticky lg:top-32">
            <span class="label-dot" data-anim="fade">Filozofie d&iacute;lny</span>
            <p class="body-md text-text-secondary leading-relaxed mt-5 max-w-[260px] font-sans">
              Přístup ke šperku jako k architektuře v malém. Méně je vždy více.
            </p>
          </div>
        </div>

        <!-- Right content -->
        <div>
          <!-- Large italic heading -->
          <p class="font-serif italic display-quote-lg text-text-primary font-normal max-w-3xl" data-anim="up">
            Věřím ve šperky, které
            <em class="text-gold-deep">dýchají</em>
            — řemeslo, které odstraní zbytečné a odhalí
            <em class="text-gold-deep">krásu</em>
            materiálu.
          </p>

          <!-- Split: copy + image -->
          <div class="grid md:grid-cols-2 gap-10 mt-14">
            <div data-anim="up">
              <p class="text-text-secondary body-lg font-sans">
                Víc než dvacet let pracuji se zlatem a stříbrem. Každý šperk vyrábím ručně — od prvního náčrtu po finální lesk. Není to jen řemeslo, je to způsob, jakým vnímám svět.
              </p>
              <p class="text-text-secondary body-lg mt-4 font-sans">
                Každý kus, který opustí dílnu, nese kousek mého příběhu a hodně toho vašeho. Proto nespěchám a nedělám kompromisy.
              </p>
            </div>
            <div class="relative overflow-hidden" data-anim="up">
              <img
                src="/images/homepage--o-dilne-preview--ruce-bruseni.webp"
                srcset="/images/homepage--o-dilne-preview--ruce-bruseni.webp 1x, /images/homepage--o-dilne-preview--ruce-bruseni@2x.webp 2x"
                width="800" height="600"
                alt="Detail broušení šperku v dílně"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover grayscale-[15%] sepia-[10%]"
              />
              <PhotoFrame />
              <!-- Plaque -->
              <div class="absolute bottom-4 left-4 bg-bg-primary/90 backdrop-blur-md px-4 py-2.5 shadow-soft">
                <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-gold-on-light font-sans">Dílna Pod Kesnerkou</span>
              </div>
            </div>
          </div>

          <!-- 3 Principles -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-14" data-anim="stagger">
            <div class="border-t border-border pt-5">
              <span class="text-[12px] text-text-muted font-sans">01</span>
              <p class="mt-2 body-md font-medium text-text-primary font-sans">Ruční práce bez kompromisů</p>
            </div>
            <div class="border-t border-border pt-5">
              <span class="text-[12px] text-text-muted font-sans">02</span>
              <p class="mt-2 body-md font-medium text-text-primary font-sans">Vím, odkud každý kámen pochází</p>
            </div>
            <div class="border-t border-border pt-5">
              <span class="text-[12px] text-text-muted font-sans">03</span>
              <p class="mt-2 body-md font-medium text-text-primary font-sans">Méně detailů, víc materiálu</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- ====== METHODOLOGY — 3 cards ====== -->
  <section class="bg-bg-primary border-b border-border section-lg">
    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">

      <!-- Header -->
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-14">
        <div>
          <span class="label-dot" data-anim="fade">Jak pracuji</span>
          <h2 class="mt-5" data-anim="stagger">
            Od nápadu ke šperku v <em>třech</em> krocích.
          </h2>
        </div>
      </div>

      <!-- 3 Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10" data-anim="stagger">
        {processSteps.map((step) => (
          <div data-anim-child class="group h-full flex flex-col border-b border-border">
            <!-- Card photo with icon overlay -->
            <div class="relative aspect-[4/3] overflow-hidden">
              <img
                src={step.image}
                srcset={`${step.image} 1x, ${step.image2x} 2x`}
                width="800" height="600"
                alt={step.alt}
                loading="lazy"
                decoding="async"
                class="absolute inset-0 w-full h-full object-cover grayscale-[15%] sepia-[10%]"
              />
              <!-- Gradient -->
              <div class="absolute inset-0 bg-gradient-to-t from-[rgba(30,27,24,0.25)] via-transparent to-transparent pointer-events-none"></div>
              <!-- Number circle overlay -->
              <div class="absolute top-4 left-4 h-11 w-11 rounded-full border border-white/60 bg-button-text/85 backdrop-blur-sm flex items-center justify-center text-gold-deep text-[11px] font-medium uppercase tracking-[0.15em] font-sans shadow-plaque">
                {step.number}
              </div>
            </div>
            <!-- Info below -->
            <div class="pt-5 pb-5 flex-1">
              <h3>{step.title}</h3>
              <p class="body-md text-text-secondary leading-relaxed mt-2 font-sans">
                {step.description}
              </p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>


  <!-- ====== TESTIMONIAL — Quote + image (skryto, dokud nebude napojené na reálné reference) ======
  <section class="bg-bg-primary border-b border-border section-lg">
    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">

      <div class="grid lg:grid-cols-[1fr_0.6fr] gap-12 lg:gap-16 items-center">

        <div data-anim="up">
          <span class="label-dot mb-8 block">Reference</span>
          <blockquote>
            <p class="font-serif italic display-quote text-text-primary font-normal">
              &bdquo;Řekla jsem mu jen nápad a barvu kamene. Zbytek nechal na mě překvapit. Když jsem prsten poprvé viděla, věděla jsem, že přesně takhle jsem si ho představovala.&ldquo;
            </p>
            <footer class="mt-8 pt-6 border-t border-border">
              <cite class="not-italic">
                <span class="font-sans font-medium text-text-primary block">Helena Novotná</span>
                <span class="body-md text-text-muted mt-1 font-sans block">Sběratelka šperků, Praha</span>
              </cite>
            </footer>
          </blockquote>
        </div>

        <div class="relative overflow-hidden aspect-[3/4]" data-anim="up">
          <ResponsivePicture
            base="homepage--hero--ametystovy-cluster-na-ruce"
            width="800" height="1067"
            alt="Prsten s diamantem na ruce — zakázková tvorba"
            loading="lazy"
            class="absolute inset-0 w-full h-full object-cover"
          />
        </div>

      </div>

    </div>
  </section>
  -->

  <!-- ====== SKLADEM — Vertical list (stejný vzhled jako Selected Works) ====== -->
  <section class="bg-bg-primary border-b border-border section-lg">
    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">

      <!-- Header -->
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-14">
        <div>
          <span class="label-dot" data-anim="fade">Skladem</span>
          <h2 class="mt-5" data-anim="stagger">
            Hotové šperky — <em>ihned k odnesení</em>
          </h2>
        </div>
        <div data-anim="up">
          <Button href="/skladem" variant="text">Zobrazit sklad</Button>
        </div>
      </div>

      <!-- Vertical list -->
      <div class="flex flex-col">
        {skladem.map((item) => (
          <PortfolioListCard
            href={item.href}
            image={item.image}
            image2x={item.image2x}
            alt={item.alt}
            label={item.label}
            title={item.title}
            description={item.description}
            tags={item.tags}
            imageRatio="wide"
            showCta
            prominentTitle
          />
        ))}
        <div class="border-t border-border"></div>
      </div>

      <!-- CTA button -->
      <div class="mt-12 text-center" data-anim="up">
        <Button href="/skladem" variant="secondary">Celý sklad</Button>
      </div>

    </div>
  </section>

</Layout>
