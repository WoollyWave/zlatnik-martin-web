---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import FAQ from '../components/FAQ.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import ResponsivePicture from '../components/ResponsivePicture.astro';
import { SITE } from '../data/site';
import { graph, faqPageSchema, customJewelryServiceSchema, breadcrumbSchema } from '../lib/seo';

const processSteps = [
  {
    number: '01',
    title: 'Konzultace',
    description: 'Setkáme se v dílně nebo si zavoláme. Ukážete mi svou představu — skicu, fotografii, nebo jen slovy. Probereme materiál, časový rámec i rozpočet.',
    image: '/images/zakazkova--proces-01--vykresy.webp',
    image2x: '/images/zakazkova--proces-01--vykresy.webp',
    alt: 'Výkresy a první nákres šperku',
  },
  {
    number: '02',
    title: 'Návrh',
    description: 'Připravím návrh vašeho šperku. U složitějších kusů vytvořím 3D model nebo voskový prototyp. Nic nevznikne, dokud nebudete souhlasit.',
    image: '/images/zakazkova--proces-02--vykres2.webp',
    image2x: '/images/zakazkova--proces-02--vykres2.webp',
    alt: 'Detailní výkres šperku',
  },
  {
    number: '03',
    title: 'Výroba',
    description: 'Každý šperk vyrábím ručně ve své dílně. Fotím každý krok — budete vědět, jak váš šperk vzniká. Žádná sériová výroba, žádné kompromisy.',
    image: '/images/zakazkova--proces-03--vyroba.webp',
    image2x: '/images/zakazkova--proces-03--vyroba.webp',
    alt: 'Ruční výroba šperku v dílně Pod Kesnerkou',
  },
  {
    number: '04',
    title: 'Předání',
    description: 'Šperk si můžete vyzvednout osobně v dílně nebo ho pošlu pojištěný zásilkou. Ke každému kusu dostanete certifikát pravosti — a možnost přinést šperk jednou ročně na bezplatné profesionální čištění, po celou dobu životnosti.',
    image: '/images/zakazkova--proces-04--predani.webp',
    image2x: '/images/zakazkova--proces-04--predani.webp',
    alt: 'Hotový šperk — předání klientovi',
  },
];

const materials = [
  {
    title: 'Zlato a stříbro',
    description: 'Pracuji se zlatem 585/1000 (14 kt) i 750/1000 (18 kt) a stříbrem 925/1000. Všechny kovy certifikované, puncované.',
  },
  {
    title: 'Drahé kameny',
    description: 'Diamanty, safíry, rubíny, smaragdy. Každý kámen ručně vybraný od ověřených dodavatelů s certifikátem.',
  },
  {
    title: 'Přírodní kameny',
    description: 'Opály, granáty, ametysty, měsíční kameny, turmalíny. Vyberu kámen, který odpovídá vašemu přání a rozpočtu.',
  },
];

const pricingSilver = [
  { item: 'Jednoduchý prsten', price: 'od 2 500 Kč' },
  { item: 'Prsten s kamenem', price: 'od 3 500 Kč' },
  { item: 'Náušnice (pár)', price: 'od 2 800 Kč' },
  { item: 'Přívěsek', price: 'od 1 800 Kč' },
  { item: 'Náhrdelník', price: 'od 4 500 Kč' },
];

const pricingGold = [
  { item: 'Jednoduchý prsten (585/1000)', price: 'od 8 000 Kč' },
  { item: 'Prsten s kamenem (585/1000)', price: 'od 12 000 Kč' },
  { item: 'Snubní prsteny (pár, 585/1000)', price: 'od 18 000 Kč' },
  { item: 'Náušnice (pár, 585/1000)', price: 'od 9 000 Kč' },
  { item: 'Náhrdelník (585/1000)', price: 'od 15 000 Kč' },
];

// Scattered gallery — pozice, velikost, `data-float` offset a obrázek.
const scatteredGallery = [
  { pos: 'top-[5%] left-[-3%] w-[28%] max-w-[320px]',    float: 0.3, base: 'zakazkova--proces-03--snubaky-v-ruce-vyroba',     w: 800,  h: 600 },
  { pos: 'top-[3%] left-[35%] w-[18%] max-w-[220px]',    float: 0.4, base: 'zakazkova--proces-01--3d-cad-navrh',               w: 800,  h: 600 },
  { pos: 'top-[2%] right-[5%] w-[25%] max-w-[300px]',    float: 0.3, base: 'homepage--portfolio-3--snubni-prsteny-zlate',      w: 800,  h: 600 },
  { pos: 'top-[40%] left-[-5%] w-[14%] max-w-[160px]',   float: 0.6, base: 'zakazkova--materialy--opal-na-dreve',              w: 800,  h: 600 },
  { pos: 'top-[35%] right-[-2%] w-[22%] max-w-[260px]',  float: 0.5, base: 'homepage--portfolio-2--privesek-citrin',           w: 800,  h: 600 },
  { pos: 'bottom-[8%] left-[8%] w-[22%] max-w-[270px]',  float: 0.7, base: 'zakazkova--proces-04--privesek-J-na-krku-predani', w: 800,  h: 600 },
  { pos: 'bottom-[3%] right-[25%] w-[20%] max-w-[240px]', float: 0.6, base: 'zakazkova--proces-02--3d-cad-perspektiva',         w: 800,  h: 600 },
  { pos: 'bottom-[5%] right-[2%] w-[18%] max-w-[200px]', float: 0.8, base: 'zakazkova--parallax--tricolor-prsten-na-kovadline', w: 1920, h: 1080 },
];

const druhyZivot = [
  {
    number: '01',
    title: 'Šperky po babičce',
    description: 'Ošoupanou obroučku vyrobím nově, kámen ponechám. Charakter šperku zůstane — jen ho zase budete moct nosit.',
  },
  {
    number: '02',
    title: 'Ztracený pár',
    description: 'Dodělám druhou náušnici nebo prsten tak, aby byly nerozeznatelně podobné originálu. Pracuji z fotek a zachovaného kusu.',
  },
  {
    number: '03',
    title: 'Diskrétní zakázka',
    description: 'Zásnubní prsten, který má zůstat v tajnosti. Konzultace po telefonu, výroba bez stop, standardní termín 3–4 týdny.',
  },
];

const faqItems = [
  {
    question: 'Co dostávám navíc, když si u vás koupím šperk?',
    answer: 'Každý šperk, který u mě vznikne, mi můžete jednou ročně přinést na profesionální čištění — zdarma a po celou dobu životnosti šperku. Stačí se ozvat a domluvíme termín. Sami si tak udržujete šperk v původním lesku bez nutnosti chodit jinam.',
  },
  {
    question: 'Jak dlouho trvá výroba zakázkového šperku?',
    answer: 'Jednoduchý šperk (prsten, přívěsek) vyrobím během 2–3 týdnů. Složitější kusy s kameny nebo gravurami 4–6 týdnů. U expresních objednávek se domluvíme individuálně.',
  },
  {
    question: 'Kolik stojí zakázkový šperk?',
    answer: 'Cena záleží na materiálu, složitosti a použitých kamenech. Stříbrné šperky začínají od 2 500 Kč, zlaté od 8 000 Kč. Přesnou kalkulaci udělám až po konzultaci.',
  },
  {
    question: 'Můžete opravit nebo upravit existující šperk?',
    answer: 'Ano, opravuji a upravuji šperky — změna velikosti prstenu, výměna kamenu, oprava zapínání. Přineste šperk do dílny a řekneme si, co je možné.',
  },
  {
    question: 'Jak probíhá konzultace?',
    answer: 'Zavolejte nebo napište na WhatsApp. Můžeme se potkat v dílně v Praze 5, nebo vše probereme na dálku — telefonem, emailem či videohovorem.',
  },
  {
    question: 'Poskytuji záruku na své šperky?',
    answer: 'Každý šperk má doživotní záruku na vadu materiálu a zpracování. Běžné opotřebení (poškrábání, patina) není zárukou kryto, ale rád pomůžu s údržbou.',
  },
];

const jsonLd = graph(
  faqPageSchema(faqItems),
  customJewelryServiceSchema(),
  breadcrumbSchema([
    { name: 'Domů', url: '/' },
    { name: 'Zakázková tvorba', url: '/zakazkova-tvorba/' },
  ]),
);
---

<Layout
  title="Zakázková výroba šperků Praha | Šperk na míru ze zlata a stříbra"
  description="Zakázková výroba šperků v Praze. Snubní i zásnubní prsteny, autorské kusy na míru. Zlato 14/18 karátů, stříbro 925. Konzultace zdarma."
  navOverlay
  jsonLd={jsonLd}
  ctaHeading="Řekněte mi, co máte <em>na mysli</em>."
  ctaSubtitle="Stačí krátký telefonát nebo zpráva. Probereme materiály, rozpočet, časový rámec — bez závazků a bez tlaku."
>

  <!-- ====== HERO — Scattered Gallery ====== -->
  <section class="relative bg-bg-primary border-b border-border overflow-hidden min-h-0 md:min-h-dvh">

    <!-- Scattered images — desktop only -->
    <div class="hidden md:block absolute inset-0 pointer-events-none" aria-hidden="true">
      {scatteredGallery.map((img) => (
        <div class={`absolute ${img.pos}`} data-float={img.float}>
          <img
            src={`/images/${img.base}.webp`}
            srcset={`/images/${img.base}.webp 1x, /images/${img.base}@2x.webp 2x`}
            alt="" width={img.w} height={img.h} loading="lazy" decoding="async"
            class="w-full h-auto object-cover shadow-scatter"
          />
        </div>
      ))}
    </div>

    <!-- Mobile: left-aligned + 80vh min-h + content top (matchne homepage). md+: centered + 100vh + vertical center pro scattered gallery -->
    <div class="relative z-10 flex flex-col items-start text-left justify-start md:items-center md:text-center md:justify-center px-6 sm:px-8 lg:px-14 section-hero md:py-0 min-h-[80vh] md:min-h-dvh">
      <span class="label-dot" data-anim="fade">Zakázková tvorba</span>
      <h1 class="mt-6 max-w-3xl" data-anim="up">
        Šperk <em>na míru</em>. Návrh schválíte před tím, než cokoli vznikne.
      </h1>
      <p class="subtitle mt-6" data-anim="up">
        Řekněte mi svůj nápad. Společně vybereme materiál, kámen i termín. Konzultace je zdarma a bez závazků — platí se až po schválení návrhu.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-4 w-full sm:w-auto" data-anim="up">
        <Button href="#process" variant="primary">Poptat šperk</Button>
        <Button href="#cenik" variant="secondary">Orientační ceník</Button>
      </div>

      <!-- Mobile only -->
      <div class="md:hidden mt-12 w-full">
        <ResponsivePicture
          base="zakazkova--hero--privesek-quartz-na-krku"
          width="1920" height="1080"
          alt="Zakázková výroba šperků"
          loading="eager"
          fetchpriority="high"
          class="w-full h-auto object-cover" />
      </div>
    </div>
  </section>

  <!-- ====== PROCESS — 4 cards grid ====== -->
  <section id="process" class="relative bg-bg-primary border-b border-border section-md overflow-hidden">
    <div class="radial-overlay"></div>
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <span class="label-dot" data-anim="fade">Proces</span>
      <h2 class="mt-5 max-w-2xl" data-anim="up">Jak vzniká váš šperk — krok za krokem</h2>
      <p class="mt-4 text-text-secondary max-w-lg" data-anim="up">Od prvního slova k hotovému kusu. Vidíte každou fázi.</p>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10 mt-14" data-anim="stagger">
        {processSteps.map((step) => (
          <div data-anim-child class="group">
            <!-- Photo with number plaque -->
            <div class="relative aspect-square overflow-hidden">
              <img
                src={step.image}
                srcset={`${step.image} 1x, ${step.image2x} 2x`}
                width="1200" height="1200"
                alt={step.alt}
                loading="lazy"
                decoding="async"
                class="absolute inset-0 w-full h-full object-cover grayscale-[15%] sepia-[10%]"
              />
              <!-- Soft top→bottom gradient pro čitelnost plaque -->
              <div class="absolute inset-0 bg-gradient-to-t from-text-primary/25 via-transparent to-transparent pointer-events-none"></div>
              <!-- Number plaque (jako homepage process) -->
              <div class="absolute top-4 left-4 h-11 w-11 rounded-full border border-white/60 bg-button-text/85 backdrop-blur-sm flex items-center justify-center text-gold-deep text-[11px] font-medium uppercase tracking-[0.15em] font-sans shadow-plaque">
                {step.number}
              </div>
            </div>
            <!-- Info below -->
            <div class="pt-5 pb-5 border-b border-border">
              <h3>{step.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-text-secondary font-sans">{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ====== MATERIALS — 2 columns ====== -->
  <section class="relative bg-bg-primary border-b border-border section-md">
    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <span class="label-dot" data-anim="fade">Materiály</span>
      <h2 class="mt-5 max-w-2xl" data-anim="up">Certifikované kovy, ručně vybrané kameny</h2>
      <p class="mt-4 text-text-secondary max-w-lg" data-anim="up">Vím, odkud každý materiál pochází — a proč ho používám.</p>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center mt-14" data-anim="up">
        <div class="relative overflow-hidden" data-anim="scale">
          <img
            src="/images/zakazkova--materialy--opal-na-dreve.webp"
            srcset="/images/zakazkova--materialy--opal-na-dreve.webp 1x, /images/zakazkova--materialy--opal-na-dreve@2x.webp 2x"
            width="800" height="600"
            alt="Opál na dřevěné podložce — syrový materiál"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover grayscale-[15%] sepia-[10%]"
          />
          <PhotoFrame />
        </div>
        <div class="space-y-8">
          {materials.map((mat) => (
            <div>
              <h3>{mat.title}</h3>
              <p class="mt-2 text-text-secondary body-md leading-relaxed">{mat.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ====== DRUHÝ ŽIVOT ŠPERKŮ — Philosophy pattern (homepage) ====== -->
  <section id="druhy-zivot" class="relative bg-bg-primary border-b border-border section-lg overflow-hidden">
    <div class="radial-overlay"></div>

    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14 relative">
      <div class="grid lg:grid-cols-[0.34fr_1fr] gap-12 lg:gap-16">

        <!-- Left rail -->
        <div class="lg:border-r lg:border-border lg:pr-10">
          <div class="lg:sticky lg:top-32">
            <span class="label-dot" data-anim="fade">Opravy a předělání</span>
            <p class="body-md text-text-secondary leading-relaxed mt-5 max-w-[260px] font-sans">
              Šperky po babičce, ztracené páry, staré obroučky. Většinu zvládnu během pár týdnů.
            </p>
          </div>
        </div>

        <!-- Right content -->
        <div>
          <!-- Large italic heading -->
          <p class="font-serif italic display-quote-lg text-text-primary font-normal max-w-3xl" data-anim="up">
            Dávám šperkům
            <em class="text-gold-deep">druhý život</em>
            — abyste mohli dál nosit to, co máte
            <em class="text-gold-deep">rádi</em>.
          </p>

          <!-- Split: copy + image -->
          <div class="grid md:grid-cols-2 gap-10 mt-14">
            <div data-anim="up">
              <p class="text-text-secondary body-lg font-sans">
                Opravy, předělání, dodělání ztracených kusů. Pracuji s tím, co máte — kámen po babičce, zachovanou náušnici z páru, starou obroučku, která už doslouží.
              </p>
              <p class="text-text-secondary body-lg mt-4 font-sans">
                Pokud máte vlastní materiál, můžete ho přinést a použiju ho. U párů stačí jeden zachovaný kus, podle kterého se bude dotvářet.
              </p>
            </div>
            <div class="relative overflow-hidden" data-anim="up">
              <img
                src="/images/druhy-zivot--hero--martin-pri-praci.webp"
                srcset="/images/druhy-zivot--hero--martin-pri-praci.webp 1x, /images/druhy-zivot--hero--martin-pri-praci@2x.webp 2x"
                width="800" height="600"
                alt="Martin Ševr při ruční práci s hořákem v dílně"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover grayscale-[15%] sepia-[10%]"
              />
              <PhotoFrame />
              <div class="absolute bottom-4 left-4 bg-bg-primary/90 backdrop-blur-md px-4 py-2.5 shadow-soft">
                <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-gold-on-light font-sans">Ruční oprava</span>
              </div>
            </div>
          </div>

          <!-- 3 Examples -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-14" data-anim="stagger">
            {druhyZivot.map((s) => (
              <div data-anim-child class="border-t border-border pt-5">
                <span class="text-[12px] text-text-muted font-sans">{s.number}</span>
                <p class="mt-2 body-md font-medium text-text-primary font-sans">{s.title}</p>
                <p class="mt-2 text-text-secondary body-md leading-relaxed font-sans">{s.description}</p>
              </div>
            ))}
          </div>

          <div class="mt-12 flex flex-col sm:flex-row gap-4">
            <Button href="/kontakt" variant="primary">Domluvit konzultaci</Button>
            <Button href={SITE.whatsapp} variant="secondary">Napsat na WhatsApp</Button>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ====== PRICING — Stříbro + Zlato side by side ====== -->
  <section id="cenik" class="relative bg-bg-primary border-b border-border section-md">
    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <span class="label-dot" data-anim="fade">Ceník</span>
      <h2 class="mt-5" data-anim="up">Orientační ceník — od čeho se začíná</h2>
      <p class="mt-4 text-text-secondary max-w-xl" data-anim="up">Ceny závisí na složitosti, materiálu a kamenech. Přesnou kalkulaci udělám po konzultaci — zdarma a bez závazku.</p>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 mt-14" data-anim="up">
        <!-- Stříbro -->
        <div>
          <h3 class="mb-6">Stříbro 925/1000</h3>
          <div class="border-t border-border">
            {pricingSilver.map((row) => (
              <div class="flex items-center justify-between py-4 border-b border-border">
                <span class="text-text-primary">{row.item}</span>
                <span class="text-text-secondary font-medium whitespace-nowrap ml-4">{row.price}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Zlato -->
        <div>
          <h3 class="mb-6">Zlato 585/1000</h3>
          <div class="border-t border-border">
            {pricingGold.map((row) => (
              <div class="flex items-center justify-between py-4 border-b border-border">
                <span class="text-text-primary">{row.item}</span>
                <span class="text-text-secondary font-medium whitespace-nowrap ml-4">{row.price}</span>
              </div>
            ))}
          </div>
          <p class="mt-4 body-md text-text-muted">U zlata 750/1000 přičtěte cca 30 %.</p>
        </div>
      </div>

      <!-- Disclaimer ceny zlata -->
      <p class="mt-12 max-w-3xl font-serif italic text-[15px] text-text-muted leading-[1.7]" data-anim="up">
        Ceny jsou orientační a platné k {new Date().toLocaleDateString('cs-CZ', { day: 'numeric', month: 'long', year: 'numeric' })}. Cena zlata se denně mění — aktuální vám rád řeknu po telefonu: <a href={SITE.phoneHref} class="not-italic font-sans text-gold-on-light hover:text-gold-deep transition-colors font-medium whitespace-nowrap">{SITE.phone}</a>.
      </p>
    </div>
  </section>

  <!-- ====== EXPRESS ====== -->
  <section id="express" class="relative bg-bg-primary border-b border-border section-md">
    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <div class="grid lg:grid-cols-[1fr_0.5fr] gap-12 lg:gap-16 items-center" data-anim="up">
        <div>
          <span class="label-dot">Expresní výroba</span>
          <h2 class="mt-5">Pět dní stačí. Někdy i <em>méně</em>.</h2>
          <p class="mt-4 text-text-secondary body-lg max-w-xl">
            Zásnuby v sobotu. Výročí, na které jste si vzpomněli pozdě. Dárek, co má být k narozeninám. Jednodušší šperky — prsten bez kamene, hladký řetízek, ražený znak — vyrobím do pěti pracovních dnů ze zlata 585/1000. Zavolejte hned, řeknu vám, jestli se to stihne a kolik to bude.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-4">
            <Button href={SITE.phoneHref} variant="primary">Zavolat</Button>
            <Button href={SITE.whatsapp} variant="secondary">Napsat na WhatsApp</Button>
          </div>
        </div>
        <div class="hidden lg:block" data-anim="scale">
          <img
            src="/images/zakazkova--express--prsten-safir.webp"
            srcset="/images/zakazkova--express--prsten-safir.webp 1x, /images/zakazkova--express--prsten-safir@2x.webp 2x"
            width="600" height="600"
            alt="Prsten s růžovým safírem — expresní výroba"
            loading="lazy"
            decoding="async"
            class="w-full h-auto object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ====== FAQ — bg-secondary ====== -->
  <section class="relative bg-bg-primary section-md overflow-hidden">
