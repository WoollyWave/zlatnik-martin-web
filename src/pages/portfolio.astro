---
import Layout from '../layouts/Layout.astro';
import PortfolioListCard from '../components/PortfolioListCard.astro';
import { portfolioItems } from '../data/portfolio';
---

<Layout
  title="Portfolio | Martin Ševr — Zlatnická dílna Praha"
  description="Každý kus vypráví příběh. Zlaté prsteny, stříbrné přívěsky, sady s kameny. Ruční práce Martina Ševra."
  navOverlay
>

  <!-- ====== HERO — text left aligned, no parallax photo ====== -->
  <section class="relative bg-bg-primary border-b border-border section-hero overflow-hidden">
    <div class="radial-overlay"></div>
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <div class="max-w-3xl" data-anim="up">
        <span class="label-dot">Portfolio</span>
        <h1 class="mt-6">
          Šperky z <em>duše</em>
        </h1>
        <p class="mt-6 text-text-secondary body-lg max-w-xl">
          Ruční práce, která trvá. Zlaté prsteny, stříbrné přívěsky, sady s kameny. Každý kus vypráví příběh.
        </p>
      </div>
    </div>
  </section>

  <!-- ====== PORTFOLIO — Vertical list (jako Selected Works na homepage) ====== -->
  <section class="relative bg-bg-primary section-md overflow-hidden">
    <div class="radial-overlay"></div>
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">

      <!-- Vertical list -->
      <div class="flex flex-col">
        {portfolioItems.map((item, i) => (
          <PortfolioListCard
            href={`/tvorba/${item.slug}`}
            image={item.image}
            image2x={item.image2x}
            alt={item.alt}
            label={`Zakázka 0${i + 1}`}
            title={item.title}
            description={item.description}
            tags={item.tags}
            loading={i < 2 ? 'eager' : 'lazy'}
            headingLevel="h2"
            imageRatio="wide"
            showCta
          />
        ))}
        <div class="border-t border-border"></div>
      </div>

    </div>
  </section>

</Layout>
