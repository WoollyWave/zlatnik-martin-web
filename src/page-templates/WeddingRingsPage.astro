---
/**
 * Sdílená šablona Snubní prsteny na míru (CS /snubni-prsteny-na-miru/ + EN /en/wedding-rings/).
 * CS texty převzaty doslova z původní stránky; EN je překlad schválené CS copy
 * (první osoba, klidná jistota, žádné vykřičníky — viz voice & tone v CLAUDE.md).
 */
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import FAQ from '../components/FAQ.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import { SITE } from '../data/site';
import { graph, weddingRingsServiceSchema, faqPageSchema, breadcrumbSchema, siteEntities } from '../lib/seo';
import type { Locale } from '../i18n';
import Reviews from '../components/Reviews.astro';
import { reviewsFor } from '../data/reviews';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const isEn = locale === 'en';

const t = isEn
  ? {
      title: 'Custom wedding rings Prague | Handcrafted in gold, Martin Ševr',
      description: 'Custom wedding and engagement rings in Prague. Yellow, white and rose gold, 14k/18k. Handcrafted in my workshop. Ready in 4–8 weeks. 20+ years experience.',
      breadcrumb: [
        { name: 'Home', url: '/en/' },
        { name: 'Custom wedding rings', url: '/en/wedding-rings/' },
      ],
      ctaHeading: "Let's start your <em>wedding ring</em>",
      ctaSubtitle: 'A consultation in the workshop is free and without obligation. We will discuss style, profile, material and budget, and I will prepare a design for you.',
      ctaPrimaryLabel: 'Book a consultation',
      heroLabel: 'Wedding & engagement rings, Prague',
      heroHeadingPre: 'Wedding rings',
      heroHeadingEm: 'made by hand',
      heroHeadingPost: '.',
      heroCopy: 'I will make your wedding or engagement ring to order. Yellow, white and rose gold, 14k and 18k, with a pair in 14k gold from CZK 18,000. Handcrafted in my own workshop at Pod Kesnerkou in Prague 5, Smíchov, from the first sketch to the handover. 20+ years of experience.',
      heroPrimaryHref: '/en/contact/',
      heroPrimaryLabel: 'Book a consultation',
      heroSecondaryLabel: 'Call me directly',
      heroAlt: 'A pair of white gold wedding rings: matte satin finish, small diamonds',
      stylesLabel: 'What I make',
      stylesHeadingPre: 'From classic to',
      stylesHeadingEm: 'original shapes',
      processLabel: 'How it works',
      processHeadingPre: 'Step by step.',
