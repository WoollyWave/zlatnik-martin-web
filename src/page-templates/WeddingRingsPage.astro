      faqLabel: 'Frequently asked questions',
      faqHeading: 'Frequently asked questions',
      galleryLabel: 'From the workshop',
      galleryHeadingPre: 'Rings I have',
      galleryHeadingEm: 'made',
      galleryLead: 'These pieces are not for sale, but I will happily make you something similar to order.',
      galleryLinksPre: 'You can see how individual commissions came about in my',
      galleryLinksPortfolio: 'portfolio',
      galleryLinksMid: ', and what bespoke work involves on the',
      galleryLinksCustom: 'bespoke jewellery',
      galleryLinksPost: ' page.',   // vedoucí mezera — navazuje hned za </a>
    }
  : {
      title: 'Snubní prsteny na míru Praha | Ruční výroba, Martin Ševr',
      description: 'Snubní a zásnubní prsteny na míru v Praze. Žluté, bílé, růžové zlato 14k/18k. Ruční výroba ve vlastní dílně. Termín 4–8 týdnů. 20+ let praxe.',
      breadcrumb: [
        { name: 'Domů', url: '/' },
        { name: 'Snubní prsteny na míru', url: '/snubni-prsteny-na-miru/' },
      ],
      ctaHeading: 'Začněme váš <em>snubní prsten</em>',
      ctaSubtitle: 'Konzultace v dílně je zdarma a bez závazků. Probereme styl, profil, materiál i rozpočet. A já vám připravím návrh.',
      ctaPrimaryLabel: 'Domluvit konzultaci',
      heroLabel: 'Snubní a zásnubní prsteny, Praha',
      heroHeadingPre: 'Snubní prsteny',
      heroHeadingEm: 'vyrobené ručně',
      heroHeadingPost: '.',
      heroCopy: 'Vyrobím vám snubní nebo zásnubní prsten na míru. Žluté, bílé i růžové zlato 14k a 18k, pár ze 14k zlata od 18 000 Kč. Ruční výroba ve vlastní dílně Pod Kesnerkou v Praze 5 na Smíchově, od první skici po předání. 20+ let praxe.',
      heroPrimaryHref: '/kontakt/',
      heroPrimaryLabel: 'Domluvit konzultaci',
      heroSecondaryLabel: 'Zavolat rovnou',
      heroAlt: 'Pár snubních prstenů z bílého zlata: matný satén, drobné diamanty',
      stylesLabel: 'Co vyrábím',
      stylesHeadingPre: 'Od klasiky po',
      stylesHeadingEm: 'autorské tvary',
      processLabel: 'Jak to probíhá',
      processHeadingPre: 'Krok za krokem.',
      processHeadingEm: 'Bez stresu',
      processIntro: 'Celý proces od první konzultace po předání hotových prstenů trvá 4–8 týdnů podle složitosti. Plánujte s rezervou, ideálně 3 měsíce před svatbou.',
      faqLabel: 'Časté otázky',
      faqHeading: 'Časté otázky',
      galleryLabel: 'Z dílny',
      galleryHeadingPre: 'Prsteny, které jsem',
      galleryHeadingEm: 'vyrobil',
      galleryLead: 'Tyhle kusy nejsou na prodej, ale rád vám podle nich vyrobím na míru něco vašeho.',
      galleryLinksPre: 'Jak jednotlivé zakázky vznikaly, si můžete prohlédnout v',
      galleryLinksPortfolio: 'portfoliu',
      galleryLinksMid: ', a co zakázková výroba obnáší, popisuji na stránce',
      galleryLinksCustom: 'zakázková tvorba',
      galleryLinksPost: '.',
    };

const ringStyles = isEn
  ? [
      {
        number: '01',
        title: 'Classic wedding rings',
        description: 'A smooth or profiled band in yellow, white or rose gold, 14k (585/1000) or 18k (750/1000). A timeless shape that never goes out of style.',
        image: '/images/snubni--styly-01--klasicky.webp',
        image2x: '/images/snubni--styly-01--klasicky@2x.webp',
        alt: 'Classic wedding ring with a smooth half-round band, handmade',
      },
      {
        number: '02',
        title: 'Profiled and shaped',
        description: 'Braided, profiled or with a hammered texture. For couples who want a ring with character that still feels timeless. I make them in white, yellow or combined gold.',
        image: '/images/snubni--styly-02--spletany.webp',
        image2x: '/images/snubni--styly-02--spletany@2x.webp',
        alt: 'Braided wedding ring with a shaped profile, original work',
      },
      {
        number: '03',
        title: 'With diamonds and stones',
        description: 'Bespoke engagement rings and stone-set wedding bands: solitaire, halo, eternity, pavé. A certified diamond (GIA, IGI) or a natural sapphire, ruby or emerald. I will help you choose a stone that suits her hand and your budget.',
        image: '/images/snubni--styly-03--pave-diamanty.webp',
        image2x: '/images/snubni--styly-03--pave-diamanty@2x.webp',
        alt: 'Ring with diamond pavé, engagement or eternity style',
      },
      {
        number: '04',
        title: 'Original shapes',
        description: 'Something you will not find in a shop: facets folded like origami, stones set off the line, a hammered texture. We start from a sketch, or from whatever caught your eye. The result is a ring no one else has.',
        image: '/images/snubni--styly-04--origami.webp',
        image2x: '/images/snubni--styly-04--origami@2x.webp',
        alt: 'Original wedding ring with origami facets, structural design',
      },
    ]
  : [
      {
        number: '01',
        title: 'Klasické snubní prsteny',
        description: 'Hladká nebo profilovaná obroučka ze žlutého, bílého nebo růžového zlata 14k (585/1000) i 18k (750/1000). Nadčasový tvar, který nikdy nevyjde z módy.',
        image: '/images/snubni--styly-01--klasicky.webp',
        image2x: '/images/snubni--styly-01--klasicky@2x.webp',
        alt: 'Klasický snubní prsten s hladkou půlkruhovou obroučkou, ruční výroba',
      },
      {
        number: '02',
        title: 'Profilové a tvarované',
        description: 'Spletené, profilové nebo s kovanou texturou. Pro páry, které chtějí prsten s charakterem, ale zároveň nadčasový. Vyrobím z bílého, žlutého i kombinovaného zlata.',
        image: '/images/snubni--styly-02--spletany.webp',
        image2x: '/images/snubni--styly-02--spletany@2x.webp',
        alt: 'Spletený snubní prsten s tvarovaným profilem, autorská práce',
      },
      {
        number: '03',
        title: 'S diamanty a kameny',
        description: 'Zásnubní prsten na míru nebo snubní s kameny: solitér, halo, eternity, pavé. Diamant s certifikátem (GIA, IGI) nebo přírodní safír, rubín, smaragd. Pomůžu vybrat kámen, který sedí k její ruce i k vašemu rozpočtu.',
        image: '/images/snubni--styly-03--pave-diamanty.webp',
        image2x: '/images/snubni--styly-03--pave-diamanty@2x.webp',
        alt: 'Prsten s pavé z brilantů, zásnubní nebo eternity styl',
      },
      {
        number: '04',
        title: 'Autorské tvary',
        description: 'Něco, co se nikde nekoupí: fasety lámané jako origami, kameny rozesazené mimo řadu, kovaná textura. Vyjdeme ze skici nebo z toho, co se vám líbí. Výsledkem je prsten, jaký nikdo jiný nemá.',
        image: '/images/snubni--styly-04--origami.webp',
        image2x: '/images/snubni--styly-04--origami@2x.webp',
        alt: 'Autorský snubní prsten s origami fasetami, strukturální design',
      },
    ];

const processSteps = isEn
  ? [
      {
        number: '01',
        title: 'Consultation in the workshop',
        description: 'We meet in Prague 5. You will see materials, finished pieces from my portfolio and gold samples. We discuss style, ring profile, budget and timing. The consultation is free.',
      },
      {
        number: '02',
        title: 'Design and 3D model',
        description: 'I prepare a sketch, and for more complex shapes a 3D model or wax prototype. We fine-tune the details: width, profile, finish, stone. <strong class="font-medium text-text-primary">The design carries a 500 CZK deposit</strong>, which I deduct from the price of the rings. You approve everything; nothing is made before that.',
      },
      {
        number: '03',
        title: 'Handcrafting',
        description: 'I make every ring myself, by hand, in my workshop at Pod Kesnerkou. No mass casting. I photograph the process so you can see your rings come to life.',
      },
      {
        number: '04',
        title: 'Handover and engraving',
        description: 'I hand over the finished rings in person at the workshop. If you would like an engraving (wedding date, names, a motif), we do it as the final step, machine or hand engraved.',
      },
    ]
  : [
      {
        number: '01',
        title: 'Konzultace v dílně',
        description: 'Sejdeme se v Praze 5. Podíváte se na materiály, hotové kusy z portfolia, vzorníky zlata. Probereme styl, profil prstenu, rozpočet a termín. Konzultace je zdarma.',
      },
      {
        number: '02',
        title: 'Návrh a 3D model',
        description: 'Připravím skicu, u složitějších tvarů 3D model nebo voskový prototyp. Doladíme detaily: šířku, profil, povrch, kámen. <strong class="font-medium text-text-primary">Za návrh beru zálohu 500 Kč</strong>, kterou odečtu z ceny prstenů. Schvalujete vy, nic nevznikne dřív.',
      },
      {
        number: '03',
        title: 'Ruční výroba',
        description: 'Každý prsten vyrábím sám, ručně, v dílně Pod Kesnerkou. Žádné odlévání ve velkém. Průběh fotím, abyste viděli, jak prsteny vznikají.',
      },
      {
        number: '04',
        title: 'Předání a gravura',
        description: 'Hotové prsteny předám osobně v dílně. Pokud chcete gravuru (datum svatby, jména, motiv), uděláme ji jako poslední krok, strojně nebo ručně.',
      },
    ];

const faqItems = isEn
  ? [
      {
        question: 'How much do custom wedding rings cost?',
        answer: 'A pair of simple 14k gold wedding rings starts at CZK 18,000. The final price depends on the weight of the gold, the chosen purity (14k vs 18k) and any stones. I will prepare a specific quote after the first consultation, based on your preferences.',
      },
      {
        question: 'Is there a charge for the design?',
        answer: 'The consultation is free and without obligation. Once I am to draw a design for you, it carries a deposit of 500 CZK. If you order the rings, I deduct it from the price. A design is work done, and it has happened that rings were then made from it by someone else. This keeps it fair on both sides.',
      },
      {
        question: 'How much time do you need?',
        answer: 'Standard production takes 4–6 weeks from design approval. More complex pieces (engagement rings with a diamond, original shapes) take 6–8 weeks. Plan with a margin, ideally 3 months before the wedding.',
      },
      {
        question: 'Can I bring my own gold (inherited, from old jewellery)?',
        answer: 'Yes, I also work with your material. I melt the gold down and make new rings from it, symbolically meaningful and better value. You need at least 8–10 grams of gold of the same purity. We will discuss it in the workshop.',
      },
      {
        question: 'Can a wedding ring be adjusted after the wedding?',
        answer: 'If your size changes, I can make the ring larger or smaller by 1–3 sizes without losing quality. For rings I made, I do this free of charge within 1 year of handover. The same goes for a free professional cleaning once a year, for the lifetime of the ring.',
      },
      {
        question: 'Do you have experience with diamond engagement rings?',
        answer: 'Yes, diamond engagement rings are among my most frequent commissions. I work with certified diamonds (GIA, IGI). I will recommend a carat weight and quality to match your budget, from a simple solitaire to a halo setting.',
      },
    ]
  : [
      {
        question: 'Kolik stojí snubní prsteny na míru?',
        answer: 'Pár jednoduchých snubních prstenů ze 14k zlata začíná na 18 000 Kč. Cena finální závisí na váze (gramáži zlata), zvolené ryzosti (14k vs 18k) a případných kamenech. Konkrétní kalkulaci připravím po první konzultaci, podle vašich preferencí.',
      },
      {
        question: 'Platí se něco za návrh prstenů?',
        answer: 'Konzultace je zdarma a bez závazků. Jakmile pro vás mám návrh nakreslit, beru na něj zálohu 500 Kč. Když si prsteny objednáte, odečtu vám ji z ceny. Návrh je odvedená práce a stalo se mi, že podle něj prsteny vznikly u někoho jiného. Takhle to zůstává férové pro obě strany.',
      },
      {
        question: 'Kolik času potřebujete na výrobu?',
        answer: 'Standardní výroba snubních prstenů trvá 4–6 týdnů od schválení návrhu. U složitějších kusů (zásnubní s diamantem, autorské tvary) 6–8 týdnů. Plánujte s rezervou, ideálně 3 měsíce před svatbou.',
      },
      {
        question: 'Můžu si přinést vlastní zlato (po babičce, ze starých šperků)?',
        answer: 'Ano, pracuji i s vašim materiálem. Zlato přetavím a vyrobím z něj nové prsteny, symbolicky příjemné, hodnotově efektivnější. Potřebujete alespoň 8–10 gramů zlata stejné ryzosti. Probereme to v dílně.',
      },
      {
        question: 'Dá se snubní prsten upravit po svatbě?',
        answer: 'Pokud změníte velikost, prsten zvětším nebo zmenším o 1–3 čísla bez ztráty kvality. U svých prstenů to dělám zdarma do 1 roku od předání. Stejně tak roční bezplatné profesionální čištění, po celou dobu životnosti prstenu.',
      },
      {
        question: 'Máte zkušenost se zásnubními prsteny s diamantem?',
        answer: 'Ano, zásnubní prsteny s diamantem patří mezi mé nejčastější zakázky. Pracuji s certifikovanými diamanty (GIA, IGI). Doporučím vám karátáž a kvalitu odpovídající vašemu rozpočtu, od jednoduchého sólitéru po halo zasazení.',
      },
    ];

const galleryItems = isEn
  ? [
      { title: 'Engagement ring, yellow gold', base: 'snubni--ukazka-zasnubni-zlute', alt: 'Yellow gold engagement ring with a round diamond in an ornate crown setting' },
      { title: 'Matching engagement and wedding ring', base: 'snubni--ukazka-zasnubni-bile-pave', alt: 'A matching pair of white gold rings — a solitaire engagement ring and a pavé wedding band that nests against it' },
      { title: 'Ring with a heart sapphire', base: 'snubni--ukazka-srdcovy-safir', alt: 'White gold ring with a heart-cut pink sapphire and engraved shoulders' },
      { title: 'Wedding pair, white gold', base: 'snubni--ukazka-par-kovany', alt: 'A pair of white gold wedding rings, one hammered and one set with stones' },
      { title: 'Wedding pair, two-tone gold', base: 'snubni--ukazka-par-dvoubarevny', alt: 'A pair of two-tone white and yellow gold wedding rings' },
      { title: 'Wave ring', base: 'snubni--ukazka-vlnka', alt: 'Yellow gold ring with a wave bypass band and a small square diamond' },
      { title: 'Pavé leaf ring', base: 'snubni--ukazka-listek', alt: 'Yellow gold leaf-shaped ring set with a pavé of small diamonds' },
      { title: 'Solitaire, crown setting', base: 'snubni--ukazka-soliter-korunka', alt: 'Yellow gold engagement solitaire with a round diamond in a six-prong crown setting' },
      { title: 'Solitaire, slim band', base: 'snubni--ukazka-soliter-tenka', alt: 'Yellow gold engagement solitaire with a round diamond on a slim polished band' },
    ]
  : [
      { title: 'Zásnubní prsten, žluté zlato', base: 'snubni--ukazka-zasnubni-zlute', alt: 'Zásnubní prsten ze žlutého zlata s kulatým briliantem v ozdobném košíku' },
      { title: 'Padnoucí zásnubní a snubní prsten', base: 'snubni--ukazka-zasnubni-bile-pave', alt: 'Padnoucí dvojice prstenů z bílého zlata — zásnubní se solitérem a snubní s pavé, které do sebe zapadají' },
      { title: 'Prsten se srdcovým safírem', base: 'snubni--ukazka-srdcovy-safir', alt: 'Prsten z bílého zlata se srdcovým růžovým safírem a rytou obroučkou' },
      { title: 'Snubní pár, bílé zlato', base: 'snubni--ukazka-par-kovany', alt: 'Pár snubních prstenů z bílého zlata, jeden kovaný a jeden s kamínky' },
      { title: 'Snubní pár, dvoubarevné zlato', base: 'snubni--ukazka-par-dvoubarevny', alt: 'Pár snubních prstenů z dvoubarevného bílého a žlutého zlata' },
      { title: 'Prsten s vlnkou', base: 'snubni--ukazka-vlnka', alt: 'Prsten ze žlutého zlata s vlnkovou obroučkou a malým čtvercovým diamantem' },
      { title: 'Prsten s pavé', base: 'snubni--ukazka-listek', alt: 'Prsten ze žlutého zlata ve tvaru lístku s pavé z malých diamantů' },
      { title: 'Solitér v korunkovém kotlíku', base: 'snubni--ukazka-soliter-korunka', alt: 'Zásnubní solitér ze žlutého zlata s kulatým briliantem v korunkovém šestizubovém kotlíku' },
      { title: 'Solitér na tenké obroučce', base: 'snubni--ukazka-soliter-tenka', alt: 'Zásnubní solitér ze žlutého zlata s kulatým briliantem na tenké lesklé obroučce' },
    ];

const jsonLd = graph(
  weddingRingsServiceSchema(locale),
  ...siteEntities(locale),
  faqPageSchema(faqItems),
  breadcrumbSchema(t.breadcrumb),
);
---

<Layout
  locale={locale}
  title={t.title}
  ogImage="/images/og/og-snubni-prsteny.jpg"
  description={t.description}
  jsonLd={jsonLd}
  navOverlay
  lcpImageMobile="/images/portfolio--snubaky--hero.avif"
  lcpImageDesktop="/images/portfolio--snubaky--hero.avif"
  lcpImageDesktop2x="/images/portfolio--snubaky--hero@2x.avif"
  ctaHeading={t.ctaHeading}
  ctaSubtitle={t.ctaSubtitle}
  ctaPrimaryLabel={t.ctaPrimaryLabel}
>

  <!-- ====== HERO — split layout ====== -->
  <section class="relative bg-bg-primary border-b border-border overflow-hidden">
    <div class="radial-overlay"></div>
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <div class="grid lg:grid-cols-2 gap-10 sm:gap-12 lg:gap-20 items-center min-h-[80vh] lg:min-h-dvh section-hero">

        <!-- Text -->
        <div data-anim="up">
          <span class="label-dot">{t.heroLabel}</span>
          <h1 class="mt-6">
            {t.heroHeadingPre} <em>{t.heroHeadingEm}</em>{t.heroHeadingPost}
          </h1>
          <p class="mt-6 text-text-secondary body-lg max-w-xl">
            {t.heroCopy}
          </p>
          <div class="mt-10 flex flex-col sm:flex-row gap-4">
            <Button href={t.heroPrimaryHref} variant="primary">{t.heroPrimaryLabel}</Button>
            <Button href={SITE.phoneHref} variant="secondary">{t.heroSecondaryLabel}</Button>
          </div>
        </div>

        <!-- Photo — orámováno (border-border) shodně s hero fotkou na Řetězech; světlé studiové
             pozadí fotky by se jinak slilo s krémovým pozadím stránky a nemělo definovanou hranu. -->
        <div class="relative max-w-[560px] mx-auto">
          <div class="relative overflow-hidden border border-border bg-bg-secondary/40">
            <picture>
              {/* Mobil (<1024px): jen základní 1000px kandidát — density srcset tam
                  posílal @2x (2000px) do ~400px slotu, 4-5× předimenzovaný LCP. */}
              <source media="(max-width: 1023px)" type="image/avif" srcset="/images/portfolio--snubaky--hero.avif" />
              <source media="(max-width: 1023px)" srcset="/images/portfolio--snubaky--hero.webp" />
              <source
                type="image/avif"
                srcset="/images/portfolio--snubaky--hero.avif 1x, /images/portfolio--snubaky--hero@2x.avif 2x"
              />
              <img
                src="/images/portfolio--snubaky--hero.webp"
                srcset="/images/portfolio--snubaky--hero.webp 1x, /images/portfolio--snubaky--hero@2x.webp 2x"
                width="1000" height="1000"
                alt={t.heroAlt}
                fetchpriority="high"
                decoding="async"
                class="w-full h-auto object-contain"
              />
            </picture>
            {/* Vnitřní lemování — shodné s fotorámy na homepage / O dílně. */}
            <PhotoFrame />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ====== STYLES ====== -->
  <section class="relative bg-bg-primary border-b border-border section-lg overflow-hidden">
    <div class="radial-overlay"></div>
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">

      <div class="max-w-3xl mb-14" data-anim="up">
        <span class="label-dot">{t.stylesLabel}</span>
        <h2 class="mt-5">
          {t.stylesHeadingPre} <em>{t.stylesHeadingEm}</em>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 lg:gap-12" data-anim="stagger">
        {ringStyles.map((item) => (
          <div data-anim-child class="flex flex-col">
            <div class="aspect-square overflow-hidden">
              <picture>
                {item.image.endsWith('.webp') && item.image2x.endsWith('.webp') && (
                  <source
                    type="image/avif"
                    srcset={`${item.image.replace(/\.webp$/, '.avif')} 1x, ${item.image2x.replace(/\.webp$/, '.avif')} 2x`}
                  />
                )}
                <img
                  src={item.image}
                  srcset={`${item.image} 1x, ${item.image2x} 2x`}
                  width="800" height="800"
                  alt={item.alt}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-contain"
                />
              </picture>
            </div>
            <div class="pt-6 pb-2">
              <span class="font-sans text-[11px] font-medium uppercase tracking-[0.2em] text-gold-on-light">{item.number}</span>
              <h3 class="mt-3">{item.title}</h3>
              <p class="body-md text-text-secondary leading-relaxed mt-3 font-sans">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ====== GALERIE UKÁZEK / SHOWCASE ====== -->
  <section class="relative bg-bg-primary border-b border-border section-lg overflow-hidden">
    <div class="radial-overlay"></div>
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <div class="max-w-3xl mb-14" data-anim="up">
        <span class="label-dot">{t.galleryLabel}</span>
        <h2 class="mt-5">{t.galleryHeadingPre} <em>{t.galleryHeadingEm}</em></h2>
        <p class="mt-6 body-md text-text-secondary leading-relaxed font-sans max-w-2xl">{t.galleryLead}</p>
        {/* Kontextové prolinky z těla stránky. Před nimi vedly z <main> ven jen
            dva odkazy (kontakt + telefon) na 625 slov, takže sem z homepage
            netekla žádná interní autorita. Anchor texty jsou přirozené, ne
            klíčovkové. Odkazy schválně BEZ tříd — `p a` má globální styl
            v global.css:110, takže se drží konvence webu a nepřibývá CSS
            (inlineStylesheets: 'always' by ho nasypal do všech 70 stránek). */}
        <p class="mt-4 body-md text-text-secondary leading-relaxed font-sans max-w-2xl">{t.galleryLinksPre} <a href={isEn ? '/en/portfolio/' : '/portfolio/'}>{t.galleryLinksPortfolio}</a>{t.galleryLinksMid} <a href={isEn ? '/en/custom-jewelry/' : '/zakazkova-tvorba/'}>{t.galleryLinksCustom}</a>{t.galleryLinksPost}</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 lg:gap-8" data-anim="stagger">
        {galleryItems.map((item) => (
          <div data-anim-child>
            <div class="border border-border aspect-square overflow-hidden flex items-center justify-center p-5 bg-bg-primary">
              <picture>
                <source
                  type="image/avif"
                  srcset={`/images/${item.base}.avif 1x, /images/${item.base}@2x.avif 2x`}
                  sizes="(min-width: 1024px) 22vw, (min-width: 768px) 30vw, 45vw"
                />
                <img
                  src={`/images/${item.base}.webp`}
                  srcset={`/images/${item.base}.webp 1x, /images/${item.base}@2x.webp 2x`}
                  width="700" height="700"
                  sizes="(min-width: 1024px) 22vw, (min-width: 768px) 30vw, 45vw"
                  alt={item.alt}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-contain"
                />
              </picture>
            </div>
            <p class="mt-3 body-md text-text-secondary font-sans">{item.title}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ====== PROCESS ====== -->
  <section class="relative bg-bg-primary border-b border-border section-lg overflow-hidden">
    <div class="radial-overlay"></div>
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <div class="grid lg:grid-cols-[0.4fr_1fr] gap-10 lg:gap-20">
        <div class="lg:sticky lg:top-32 lg:self-start" data-anim="up">
          <span class="label-dot">{t.processLabel}</span>
          <h2 class="mt-5">{t.processHeadingPre} <em>{t.processHeadingEm}</em>.</h2>
          <p class="mt-6 body-md text-text-secondary leading-relaxed font-sans max-w-md">
            {t.processIntro}
          </p>
        </div>
        <div class="space-y-10" data-anim="stagger">
          {processSteps.map((step) => (
            <div data-anim-child class="border-b border-border pb-8">
              <span class="font-sans text-[11px] font-medium uppercase tracking-[0.2em] text-gold-on-light">{step.number}</span>
              <h3 class="mt-3">{step.title}</h3>
              <p class="body-md text-text-secondary leading-relaxed mt-3 font-sans max-w-2xl" set:html={step.description} />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ====== RECENZE ====== -->
  <Reviews items={reviewsFor('snubni-prsteny')} locale={locale} size="md" />

  <!-- ====== FAQ ====== -->
  <section class="relative bg-bg-primary section-md overflow-hidden">
    <div class="radial-overlay"></div>
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <span class="label-dot" data-anim="fade">{t.faqLabel}</span>
      <h2 class="mt-5 mb-12" data-anim="up">{t.faqHeading}</h2>
      <FAQ items={faqItems} />
    </div>
  </section>

</Layout>
