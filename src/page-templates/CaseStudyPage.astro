---
/**
 * Sdílená šablona detailu portfolia (CS /tvorba/[slug]/ + EN /en/work/[slug]/).
 * Route soubory v src/pages/ jsou tenké wrappery — getStaticPaths žije tam,
 * veškerá struktura tady, texty v lokálním slovníku `t`.
 */
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import IconArrowUpRight from '../components/IconArrowUpRight.astro';
import { portfolioCases, type PortfolioCase } from '../data/portfolio';
import { breadcrumbSchema, graph, siteEntities } from '../lib/seo';
import { materialTags, truncateAtWord } from '../lib/text';
import { SITE } from '../data/site';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
  caseStudy: PortfolioCase;
}

const { locale, caseStudy } = Astro.props;
const isEn = locale === 'en';

const categoryTypeLabels: Record<string, string> = isEn
  ? {
      'autorska-tvorba': 'Signature piece',
      'snubni-prsteny': 'Wedding bands',
      'zasnubni-prsteny': 'Engagement',
      'personalizovane': 'Commission',
    }
  : {
      'autorska-tvorba': 'Autorský kus',
      'snubni-prsteny': 'Snubní pár',
      'zasnubni-prsteny': 'Zásnubní',
      'personalizovane': 'Zakázka',
    };

const t = isEn
  ? {
      fallbackType: 'Commission',
      backToPortfolio: 'Back to portfolio',
      portfolioHref: '/en/portfolio/',
      materialLabel: 'Material',
      typeLabel: 'Type',
      ctaPrimaryHref: '/en/contact/',
      ctaPrimary: 'I want something similar',
      ctaSecondary: 'Message on WhatsApp',
      processLabel: 'Process',
      processHeading: 'How it came to be',
      galleryLabel: 'Details',
      galleryHeading: 'Gallery',
      galleryHint: 'Click to enlarge. Use the arrows or swipe to navigate.',
      enlargePrefix: 'Enlarge photo:',
      lightboxAria: 'Photo gallery',
      lightboxClose: 'Close gallery',
      lightboxPrev: 'Previous photo',
      lightboxNext: 'Next photo',
      relatedLabel: 'More from portfolio',
      relatedHeading: 'You might also',
      relatedHeadingEm: 'like',
      allCommissions: 'All commissions',
      commissionPrefix: 'Commission',
      detailsLink: 'Details',
    }
  : {
      fallbackType: 'Zakázka',
      backToPortfolio: 'Zpět na portfolio',
      portfolioHref: '/portfolio/',
      materialLabel: 'Materiál',
      typeLabel: 'Typ',
      ctaPrimaryHref: '/kontakt/',
      ctaPrimary: 'Chci podobný šperk',
      ctaSecondary: 'Napsat na WhatsApp',
      processLabel: 'Proces',
      processHeading: 'Jak vzniká',
      galleryLabel: 'Detaily',
      galleryHeading: 'Galerie',
      galleryHint: 'Klikněte pro zvětšení. Listujte šipkami nebo prstem.',
      enlargePrefix: 'Zvětšit fotku:',
      lightboxAria: 'Galerie fotek',
      lightboxClose: 'Zavřít galerii',
      lightboxPrev: 'Předchozí fotka',
      lightboxNext: 'Další fotka',
      relatedLabel: 'Další z portfolia',
      relatedHeading: 'Mohlo by se vám',
      relatedHeadingEm: 'líbit',
      allCommissions: 'Všechny zakázky',
      commissionPrefix: 'Zakázka',
      detailsLink: 'Podrobnosti',
    };


const title = isEn ? caseStudy.titleEn || caseStudy.title : caseStudy.title;
const material = isEn ? caseStudy.materialEn || caseStudy.material : caseStudy.material;
const intro = isEn ? caseStudy.introEn || caseStudy.intro : caseStudy.intro;
const heroAlt = isEn ? caseStudy.heroAltEn || caseStudy.heroAlt : caseStudy.heroAlt;
const processSteps = isEn ? caseStudy.processStepsEn || caseStudy.processSteps : caseStudy.processSteps;

const tags = [...materialTags(material), categoryTypeLabels[caseStudy.category] || t.fallbackType];

const currentIndex = portfolioCases.findIndex((c) => c.slug === caseStudy.slug);
const relatedPool = [
  ...portfolioCases.slice(currentIndex + 1),
  ...portfolioCases.slice(0, currentIndex),
];
const relatedCases = (isEn ? relatedPool.filter((c) => !!c.slugEn) : relatedPool).slice(0, 2);

const breadcrumb = isEn
  ? [
      { name: 'Home', url: '/en/' },
      { name: 'Portfolio', url: '/en/portfolio/' },
      { name: title, url: `/en/work/${caseStudy.slugEn!}/` },
    ]
  : [
      { name: 'Domů', url: '/' },
      { name: 'Portfolio', url: '/portfolio/' },
      { name: title, url: `/tvorba/${caseStudy.slug}/` },
    ];

const detailPath = isEn ? `/en/work/${caseStudy.slugEn!}/` : `/tvorba/${caseStudy.slug}/`;
// Kontextový odkaz na odpovídající „peněžní" službu podle kategorie — udržuje
// topical cluster (case study → služba, na kterou navazuje poptávka).
const serviceLink = caseStudy.category === 'snubni-prsteny' || caseStudy.category === 'zasnubni-prsteny'
  ? { href: isEn ? '/en/wedding-rings/' : '/snubni-prsteny-na-miru/', label: isEn ? 'Wedding & engagement rings on request' : 'Snubní a zásnubní prsteny na míru' }
  : { href: isEn ? '/en/custom-jewelry/' : '/zakazkova-tvorba/', label: isEn ? 'Custom jewellery to order' : 'Zakázková tvorba na míru' };

const jsonLd = graph(
  {
    '@type': 'CreativeWork',
    '@id': `${SITE.url}${detailPath}#work`,
    name: title,
    description: truncateAtWord(intro, 200),
    // Pole = hero + všechny galerijní fotky (ne jen karta) → bohatší podklad pro AI i Images.
    image: [...new Set([caseStudy.heroImage || caseStudy.cardImage, ...(caseStudy.gallery?.map((g) => g.src) ?? [])])].map((src) => `${SITE.url}${src}`),
    creator: { '@id': `${SITE.url}#person` },
    material,
    keywords: materialTags(material).join(', '),
    mainEntityOfPage: `${SITE.url}${detailPath}`,
    inLanguage: isEn ? 'en-GB' : 'cs-CZ',
  },
  ...siteEntities(locale),
  breadcrumbSchema(breadcrumb),
);
---

<Layout
  locale={locale}
  title={`${title} | Portfolio | Martin Ševr`}
  description={truncateAtWord(intro, 155)}
  ogImage={caseStudy.cardImage2x}
  ogImageWidth={1800}
  ogImageHeight={1200}
  jsonLd={jsonLd}
  navOverlay
>

  <!-- ====== HERO — Split: info left + photo right ====== -->
  <section class="relative bg-bg-primary border-b border-border section-hero overflow-clip">
    <div class="radial-overlay"></div>
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <div class="grid lg:grid-cols-[0.85fr_1.15fr] gap-10 lg:gap-16 items-start">

        <!-- Left — info -->
        <div data-anim="up">
          <a href={t.portfolioHref} class="inline-flex items-center gap-2 text-[clamp(0.6875rem,0.6rem+0.15vw,0.8125rem)] text-text-muted hover:text-gold-deep transition-colors duration-200 uppercase tracking-[0.2em] font-sans font-medium">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
            </svg>
            {t.backToPortfolio}
          </a>

          <h1 class="mt-6">{title}</h1>

          <p class="mt-6 text-text-secondary body-lg max-w-lg">
            {intro}
          </p>

          <!-- Meta -->
          <div class="mt-10 pt-8 border-t border-border grid grid-cols-2 gap-6">
            <div>
              <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-text-muted font-sans">{t.materialLabel}</span>
              <p class="text-[13px] sm:text-[14px] text-text-primary mt-1 font-sans leading-snug">{material}</p>
            </div>
            <div>
              <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-text-muted font-sans">{t.typeLabel}</span>
              <div class="flex flex-wrap gap-2 mt-1">
                {tags.map((tag) => (
                  <span class="text-[11px] uppercase tracking-[0.15em] text-text-muted font-sans border border-border px-2.5 py-1">{tag}</span>
                ))}
              </div>
            </div>
          </div>

          <!-- CTA -->
          <div class="mt-8 flex flex-col sm:flex-row gap-4">
            <Button href={t.ctaPrimaryHref} variant="primary">{t.ctaPrimary}</Button>
            <Button href={SITE.whatsapp} variant="secondary">{t.ctaSecondary}</Button>
          </div>
          <!-- Kontextový odkaz na navazující službu (topical cluster). -->
          <a href={serviceLink.href} class="group inline-flex items-center gap-2 mt-6 text-[clamp(0.6875rem,0.6rem+0.15vw,0.8125rem)] uppercase tracking-[0.2em] font-sans font-medium text-gold-on-light hover:text-gold-deep transition-colors duration-300">
            {serviceLink.label}
            <IconArrowUpRight class="w-3.5 h-3.5" />
          </a>
        </div>

        <!-- Right — hero photo -->
        <div class="relative order-first lg:order-none lg:sticky lg:top-28 lg:self-start">
          <div class="relative overflow-hidden aspect-square max-w-[640px] mx-auto" data-anim="scale">
            <picture>
              {caseStudy.heroImage.endsWith('.webp') && caseStudy.heroImage2x.endsWith('.webp') && (
                <source
                  type="image/avif"
                  srcset={`${caseStudy.heroImage.replace(/\.webp$/, '.avif')} 1x, ${caseStudy.heroImage2x.replace(/\.webp$/, '.avif')} 2x`}
                />
              )}
              <img
                src={caseStudy.heroImage}
                srcset={`${caseStudy.heroImage} 1x, ${caseStudy.heroImage2x} 2x`}
                width="1280" height="1280"
                sizes="(min-width: 1024px) 640px, 100vw"
                alt={heroAlt}
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="absolute inset-0 w-full h-full object-cover"
              />
            </picture>
            <PhotoFrame />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ====== PROCESS ====== -->
  <section class="relative bg-bg-primary border-b border-border section-md overflow-hidden">
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <div data-anim="up">
        <span class="label-dot">{t.processLabel}</span>
        <h2 class="mt-5 max-w-2xl">{t.processHeading}</h2>
      </div>
      <div class="mt-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10" data-anim="stagger">
        {processSteps.map((step) => (
          <div class="border-t border-border pt-5" data-anim-child>
            <span class="text-[12px] text-text-muted font-sans">{step.number}</span>
            <h3 class="mt-3">{step.title}</h3>
            <p class="mt-4 text-text-secondary body-md leading-relaxed font-sans">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ====== GALERIE — bento + lightbox ====== -->
  <section class="relative bg-bg-primary border-b border-border section-md overflow-hidden">
    <div class="radial-overlay"></div>
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <div data-anim="up">
        <span class="label-dot">{t.galleryLabel}</span>
        <h2 class="mt-5">{t.galleryHeading}</h2>
        <p class="mt-4 text-text-secondary body-md max-w-md">
          {t.galleryHint}
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 sm:gap-4 lg:gap-6" data-anim="stagger">
        {caseStudy.gallery.map((photo, i) => {
          const photoAlt = isEn ? photo.altEn || photo.alt : photo.alt;
          const photoCaption = isEn ? photo.captionEn || photo.caption : photo.caption;
          return (
            <figure data-anim-child class="relative">
              <button
                type="button"
                data-gallery-item
                data-index={i}
                data-src={photo.src}
                data-src2x={photo.src2x || ''}
                data-alt={photoAlt}
                data-caption={photoCaption || ''}
                class="group relative block w-full aspect-square overflow-hidden cursor-zoom-in focus:outline-none focus-visible:ring-2 focus-visible:ring-gold-deep"
                aria-label={`${t.enlargePrefix} ${photoAlt}`}
              >
                <picture>
                  {photo.src.endsWith('.webp') && (
                    <source
                      type="image/avif"
                      srcset={photo.src2x
                        ? `${photo.src.replace(/\.webp$/, '.avif')} 1x, ${photo.src2x.replace(/\.webp$/, '.avif')} 2x`
                        : photo.src.replace(/\.webp$/, '.avif')}
                      sizes="(min-width: 1024px) 430px, (min-width: 640px) 50vw, 100vw"
                    />
                  )}
                  <img
                    src={photo.src}
                    srcset={photo.src2x ? `${photo.src} 1x, ${photo.src2x} 2x` : undefined}
                    sizes="(min-width: 1024px) 430px, (min-width: 640px) 50vw, 100vw"
                    alt={photoAlt}
                    width="1200" height="1200"
                    class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.02]"
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
                <PhotoFrame />
                <span class="absolute top-3 right-3 w-9 h-9 rounded-full bg-bg-primary/85 backdrop-blur-md border border-border/60 flex items-center justify-center opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-opacity duration-300 pointer-events-none">
                  <svg class="w-4 h-4 text-text-primary" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6" />
                  </svg>
                </span>
              </button>
              {photoCaption && (
                <figcaption class="mt-3 text-text-muted body-md italic font-sans">
                  {photoCaption}
                </figcaption>
              )}
            </figure>
          );
        })}
      </div>
    </div>

    <!-- ====== Lightbox dialog ====== -->
    <dialog id="gallery-lightbox" aria-label={t.lightboxAria} class="lightbox">
      <div class="lightbox__counter" id="lightbox-counter" aria-live="polite"></div>
      <button type="button" id="lightbox-close" aria-label={t.lightboxClose} class="lightbox__close">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <button type="button" id="lightbox-prev" aria-label={t.lightboxPrev} class="lightbox__nav lightbox__nav--prev">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <figure class="lightbox__figure">
        <img id="lightbox-img" alt="" />
        <figcaption id="lightbox-caption" class="lightbox__caption"></figcaption>
      </figure>
      <button type="button" id="lightbox-next" aria-label={t.lightboxNext} class="lightbox__nav lightbox__nav--next">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </dialog>
  </section>

  <!-- ====== DALŠÍ Z PORTFOLIA ====== -->
  <section class="relative bg-bg-primary border-b border-border section-md overflow-hidden">
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">

      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-12">
        <div data-anim="up">
          <span class="label-dot">{t.relatedLabel}</span>
          <h2 class="mt-5">{t.relatedHeading} <em>{t.relatedHeadingEm}</em></h2>
        </div>
        <div data-anim="up">
          <a href={t.portfolioHref} class="inline-flex items-center gap-2 text-[clamp(0.6875rem,0.6rem+0.15vw,0.8125rem)] text-text-secondary hover:text-gold-deep transition-colors duration-200 uppercase tracking-[0.2em] font-sans font-medium">
            {t.allCommissions}
            <IconArrowUpRight class="w-3.5 h-3.5" />
          </a>
        </div>
      </div>

      <div class="flex flex-col" data-anim="stagger">
        {relatedCases.map((c) => {
          const num = String(portfolioCases.findIndex((p) => p.slug === c.slug) + 1).padStart(2, '0');
          const cTitle = isEn ? c.titleEn || c.title : c.title;
          const cLead = isEn ? c.cardLeadEn || c.cardLead : c.cardLead;
          const cMat = isEn ? c.materialEn || c.material : c.material;
          const cAlt = isEn ? c.cardAltEn || c.cardAlt : c.cardAlt;
          const cHref = isEn ? `/en/work/${c.slugEn || c.slug}/` : `/tvorba/${c.slug}/`;
          const relTags = [...materialTags(cMat), categoryTypeLabels[c.category] || t.fallbackType];
          return (
            <a href={cHref}
               class="group relative block border-t border-border py-10 md:py-14"
               data-anim-child>
              <div class="grid grid-cols-1 md:grid-cols-[0.35fr_1fr] gap-8 md:gap-12 lg:gap-16 items-center">

                <div class="relative aspect-[3/2] overflow-hidden">
                  <picture>
                    {c.cardImage.endsWith('.webp') && c.cardImage2x.endsWith('.webp') && (
                      <source
                        type="image/avif"
                        srcset={`${c.cardImage.replace(/\.webp$/, '.avif')} 1x, ${c.cardImage2x.replace(/\.webp$/, '.avif')} 2x`}
                        sizes="(min-width: 768px) 30vw, 100vw"
                      />
                    )}
                    <img
                      src={c.cardImage}
                      srcset={`${c.cardImage} 1x, ${c.cardImage2x} 2x`}
                      width="800" height="600"
                      sizes="(min-width: 768px) 30vw, 100vw"
                      alt={cAlt}
                      loading="lazy"
                      decoding="async"
                      class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700"
                    />
                  </picture>
                  <PhotoFrame />
                  <div class="absolute bottom-4 left-4 bg-bg-primary/90 backdrop-blur-md px-4 py-2.5 shadow-soft">
                    <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-gold-on-light font-sans">{`${t.commissionPrefix} ${num}`}</span>
                  </div>
                </div>

                <div class="pr-14 md:pr-16">
                  <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-gold-on-light font-sans">{`${t.commissionPrefix} ${num}`}</span>
                  <h3 class="mt-2 card-title group-hover:text-gold-deep transition-colors duration-300">{cTitle}</h3>
                  <p class="body-md text-text-secondary leading-relaxed mt-3 max-w-xl font-sans">{cLead}</p>
                  <div class="flex flex-wrap gap-3 mt-5">
                    {relTags.map((tag) => (
                      <span class="text-[11px] uppercase tracking-[0.15em] text-text-muted font-sans border border-border px-3 py-1.5">{tag}</span>
                    ))}
                  </div>
                  <div class="mt-6">
                    <span class="text-[clamp(0.6875rem,0.6rem+0.15vw,0.8125rem)] text-text-secondary uppercase tracking-[0.2em] font-sans font-medium group-hover:text-gold-deep transition-colors duration-300 inline-flex items-center gap-2">
                      {t.detailsLink}
                      <IconArrowUpRight class="w-3.5 h-3.5" />
                    </span>
                  </div>
                </div>

              </div>

              <div class="hidden md:flex absolute top-10 md:top-14 right-0 h-10 w-10 rounded-full border border-border items-center justify-center group-hover:bg-text-primary group-hover:border-text-primary transition-colors duration-300">
                <IconArrowUpRight class="w-4 h-4 text-text-primary group-hover:text-white transition-colors duration-300" />
              </div>
            </a>
          );
        })}
        <div class="border-t border-border"></div>
      </div>

    </div>
  </section>

  <!--
    Lightbox styly ZÁMĚRNĚ zůstávají zde (ne v global.css): global.css se inlinuje
    do <head> všech 64 stránek, ale lightbox běží jen na případovkách. Držením stylů
    v této šabloně nezatěžujeme ostatní stránky. NEPŘESOUVAT do global.css.
  -->
  <style is:global>
    .lightbox {
      width: 100vw; height: 100vh; max-width: 100vw; max-height: 100vh;
      padding: 0; border: 0; background: transparent; color: var(--color-button-text);
      inset: 0;
    }
    .lightbox::backdrop {
      background: rgba(30, 27, 24, 0.94);
      backdrop-filter: blur(10px);
    }
    .lightbox[open] { display: flex; align-items: center; justify-content: center; }
    .lightbox__figure {
      margin: 0; display: flex; flex-direction: column; align-items: center; justify-content: center;
      max-width: min(92vw, 1400px); max-height: 88vh;
    }
    .lightbox__figure img {
      max-width: 100%; max-height: 78vh; width: auto; height: auto;
      object-fit: contain;
      box-shadow: 0 20px 60px rgba(0,0,0,0.4);
    }
    .lightbox__caption {
      margin-top: 1.5rem; padding: 0 1rem;
      font-family: var(--font-sans); font-style: italic;
      font-size: clamp(0.875rem, 0.8rem + 0.2vw, 1rem);
      color: rgba(250, 251, 248, 0.85);
      text-align: center; max-width: 60ch;
    }
    .lightbox__caption:empty { display: none; }
    .lightbox__counter {
      position: absolute; top: 1.5rem; left: 1.5rem;
      font-family: var(--font-sans); font-size: 0.75rem;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: rgba(250, 251, 248, 0.7);
    }
    .lightbox__close, .lightbox__nav {
      position: absolute; display: inline-flex; align-items: center; justify-content: center;
      width: 48px; height: 48px; border-radius: 9999px;
      background: rgba(250, 251, 248, 0.08); color: var(--color-button-text);
      border: 1px solid rgba(250, 251, 248, 0.18); cursor: pointer;
      transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
    }
    .lightbox__close:hover, .lightbox__nav:hover {
      background: rgba(250, 251, 248, 0.18); border-color: rgba(250, 251, 248, 0.32);
    }
    .lightbox__close:focus-visible, .lightbox__nav:focus-visible {
      outline: 2px solid var(--color-gold-primary); outline-offset: 2px;
    }
    .lightbox__close { top: 1.5rem; right: 1.5rem; }
    .lightbox__nav--prev { left: max(1.5rem, calc((100vw - 1400px) / 2 - 64px)); }
    .lightbox__nav--next { right: max(1.5rem, calc((100vw - 1400px) / 2 - 64px)); }
    @media (max-width: 640px) {
      .lightbox__nav--prev { left: 0.75rem; }
      .lightbox__nav--next { right: 0.75rem; }
      .lightbox__close { top: 0.75rem; right: 0.75rem; width: 40px; height: 40px; }
