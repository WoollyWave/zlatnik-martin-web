      goldHeading: 'Zlato 585/1000',
      goldNote: 'U zlata 750/1000 přičtěte cca 30 %.',
      dateLocale: 'cs-CZ',
      disclaimerBefore: 'Ceny jsou orientační a platné k ',
      disclaimerAfter: '. Cena zlata se denně mění. Aktuální vám rád řeknu po telefonu: ',
      expressLabel: 'Expresní výroba',
      expressHeading: 'Pět dní stačí. Někdy i <em>méně</em>.',
      expressBody: 'Zásnuby v sobotu. Výročí, na které jste si vzpomněli pozdě. Dárek, co má být k narozeninám. Jednodušší šperky (prsten bez kamene, hladký řetízek, ražený znak) vyrobím do pěti pracovních dnů ze zlata 585/1000. Zavolejte hned, řeknu vám, jestli se to stihne a kolik to bude.',
      expressCta1: 'Zavolat',
      expressImgAlt: 'Prsten s růžovým safírem, expresní výroba',
      faqLabel: 'Časté otázky',
      faqHeading: 'Časté otázky',
    };

// Sdílená data procesních kroků (obrázky, čísla) — texty per-locale v t.processSteps.
const processStepsShared = [
  { number: '01', image: '/images/zakazkova--proces-01--vykresy.webp', image2x: '/images/zakazkova--proces-01--vykresy.webp' },
  { number: '02', image: '/images/zakazkova--proces-02--vykres2.webp', image2x: '/images/zakazkova--proces-02--vykres2.webp' },
  { number: '03', image: '/images/zakazkova--proces-03--vyroba.webp', image2x: '/images/zakazkova--proces-03--vyroba.webp' },
  { number: '04', image: '/images/zakazkova--proces-04--predani.webp', image2x: '/images/zakazkova--proces-04--predani.webp' },
];
const processSteps = processStepsShared.map((step, i) => ({ ...step, ...t.processSteps[i] }));

const materials = t.materials;
const pricingSilver = t.pricingSilver;
const pricingGold = t.pricingGold;
const secondLife = t.secondLife;
const faqItems = t.faqItems;

// Scattered gallery — pozice, velikost, `data-float` offset a obrázek.
/**
 * Scattered hero galerie — kompozice žije na CENTROVANÉM PLÁTNĚ max 1600 px
 * (wrapper níže), takže na velkých monitorech drží pohromadě jako původní
 * návrh — fotky se neroztahují do nekonečna k okrajům. Pod 1600 px je plátno
 * rovno viewportu. Procenta pozic/šířek jsou relativní k plátnu.
 * Kolizím s textem (max-w-3xl = 768 px centrovaný) brání třetí člen `min()`:
 * vnitřní hrana fotky nesmí překročit 50vw − 400px → pod 1600 px se fotky
 * zmenšují místo přibližování k textu. Střední/dolní pásmo až od xl,
 * středové akcenty jen při ≥1280 px šířky A ≥780 px výšky okna.
 */
/**
 * Kompozice podle zlatého řezu (φ = 1.618):
 * — velikostní žebřík φ: 360 → 222 → 137 px (dominanta / sekundární / akcenty),
 * — klíčové fotky na zlatých liniích: opál top-38.2 %, citrín ~61.8 %,
 *   středové akcenty na vertikále 38.2 %,
 * — dvě protilehlé diagonály: vpravo velká↘střední↘malá dovnitř, vlevo
 *   střední→malá (zanořená)→velká kotva dole = dynamická rovnováha,
 *   ne zrcadlová symetrie.
 * Zanořené pozice (opál, citrín, tricolor) až od 1600 px plátna — pod ním
 * se vrací k okraji / schovávají, ať drží kolizní matematika.
 */
const scatteredGallery = [
  // Levá diagonála: střední nahoře → malý zanořený střed → velká kotva dole
  { pos: 'top-[8%] left-[0%] min-[1600px]:left-[6%] w-[min(14%,222px,calc(50vw-400px))]',        float: 0.3, base: 'zakazkova--proces-03--snubaky-v-ruce-vyroba',      w: 800,  h: 600 },
  { pos: 'hidden xl:block top-[44%] left-[5%] min-[1600px]:left-[15%] w-[min(10%,160px,calc(45vw-400px))]', float: 0.6, base: 'mineral-zlatnictvi-martin-praha5',  w: 600,  h: 400 },
  { pos: 'hidden xl:block bottom-[6%] left-[3%] w-[min(17.5%,280px,calc(47vw-400px))]',          float: 0.7, base: 'zakazkova--proces-04--privesek-J-na-krku-predani', w: 800,  h: 600 },
  // Pravá diagonála: dominanta nahoře → střední na zlaté linii → malý akcent dovnitř
  { pos: 'top-[12%] right-[0%] min-[1600px]:right-[3%] w-[min(22.5%,360px,calc(50vw-400px))]',   float: 0.3, base: 'homepage--portfolio-3--snubni-prsteny-zlate',      w: 800,  h: 600 },
  { pos: 'hidden xl:block top-[56%] right-[1%] min-[1600px]:right-[5%] w-[min(14%,222px,calc(49vw-400px))]', float: 0.5, base: 'homepage--portfolio-2--privesek-citrin', w: 800, h: 600 },
  { pos: 'hidden [@media(min-width:1600px)_and_(min-height:780px)]:block bottom-[8%] right-[12%] w-[min(8.5%,137px)]', float: 0.8, base: 'zakazkova--snubni--fasetovane-zlato-pair', w: 800, h: 710 },
  // Středové akcenty na vertikále zlatého řezu — jen na velkých oknech (šířka × výška)
  { pos: 'hidden [@media(min-width:1280px)_and_(min-height:780px)]:block top-[9.5%] left-[34%] w-[min(9%,145px)]',   float: 0.4, base: 'zakazkova--parallax--tricolor-prsten-na-kovadline', w: 1920, h: 1080 },
];
// CAD render pod tlačítky je v toku obsahu (ne absolutní) — viz šablona níže.
// Absolutní kotvení ke spodku sekce kolidovalo s tlačítky, jakmile byl obsah
// vyšší než viewport (sekce pak končí těsně pod tlačítky).

const jsonLd = graph(
  customJewelryServiceSchema(locale),
  ...siteEntities(locale),
  faqPageSchema(faqItems),
  breadcrumbSchema(t.breadcrumb),
);
---

<Layout
  locale={locale}
  title={t.title}
  ogImage="/images/og/og-zakazkova-tvorba.jpg"
  description={t.description}
  navOverlay
  jsonLd={jsonLd}
  ctaHeading={t.ctaHeading}
  ctaSubtitle={t.ctaSubtitle}
>

  <!-- ====== HERO — Scattered Gallery ====== -->
  <section class="relative bg-bg-primary border-b border-border overflow-hidden min-h-0 lg:min-h-dvh">

    <!-- Scattered images — od lg; centrované plátno max 1600 px drží kompozici
         pohromadě i na velkých monitorech -->
    <div class="hidden lg:block absolute inset-y-0 left-1/2 -translate-x-1/2 w-full max-w-[1600px] pointer-events-none" aria-hidden="true">
      {scatteredGallery.map((img) => (
        <div class={`absolute ${img.pos}`} data-float={img.float}>
          <picture>
            <source
              type="image/avif"
              srcset={`/images/${img.base}.avif 1x, /images/${img.base}@2x.avif 2x`}
            />
            <img
              src={`/images/${img.base}.webp`}
              srcset={`/images/${img.base}.webp 1x, /images/${img.base}@2x.webp 2x`}
              alt="" width={img.w} height={img.h} loading="lazy" decoding="async"
              class="w-full h-auto object-cover shadow-scatter"
            />
          </picture>
        </div>
      ))}
    </div>

    <!-- Mobile + tablet: left-aligned, content top, hero fotka (matchne homepage).
         lg+: centered + dvh + vertical center pro scattered gallery -->
    <div class="relative z-10 flex flex-col items-start text-left justify-start lg:items-center lg:text-center lg:justify-center px-6 sm:px-8 lg:px-14 section-hero lg:py-0 min-h-[80vh] lg:min-h-dvh">
      <span class="label-dot" data-anim="fade">{t.heroLabel}</span>
      <h1 class="mt-6 max-w-3xl" data-anim="up" set:html={t.heroH1} />
      <p class="subtitle mt-6" data-anim="up">
        {t.heroSubtitle}
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-4 w-full sm:w-auto" data-anim="up">
        <Button href="#process" variant="primary">{t.heroCta1}</Button>
        <Button href={t.pricingAnchor} variant="secondary">{t.heroCta2}</Button>
      </div>

      <!-- CAD render pod tlačítky — v toku obsahu, takže nikdy nekoliduje
           (absolutní kotvení selhávalo na oknech nižších než obsah) -->
      <div class="hidden xl:block mt-14" data-anim="fade" aria-hidden="true">
        <picture>
          <source
            type="image/avif"
            srcset="/images/zakazkova--cad-navrh--prsten-kruh.avif 1x, /images/zakazkova--cad-navrh--prsten-kruh@2x.avif 2x"
          />
          <img
            src="/images/zakazkova--cad-navrh--prsten-kruh.webp"
            srcset="/images/zakazkova--cad-navrh--prsten-kruh.webp 1x, /images/zakazkova--cad-navrh--prsten-kruh@2x.webp 2x"
            alt="" width="800" height="800" loading="lazy" decoding="async"
            class="w-[min(11vw,175px)] h-auto shadow-scatter"
          />
        </picture>
      </div>

      <!-- Mobile + tablet (pod lg) -->
      <div class="lg:hidden mt-12 w-full max-w-2xl">
        <ResponsivePicture
          base="zakazkova--hero--privesek-quartz-na-krku"
          width="1920" height="1080"
          alt={t.heroMobileAlt}
          loading="eager"
          fetchpriority="high"
          class="w-full h-auto object-cover" />
      </div>
    </div>
  </section>

  <!-- ====== PROCESS — 4 cards grid ====== -->
  <section id="process" class="relative bg-bg-primary border-b border-border section-md overflow-hidden">
    <div class="radial-overlay"></div>
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <span class="label-dot" data-anim="fade">{t.processLabel}</span>
      <h2 class="mt-5 max-w-2xl" data-anim="up">{t.processHeading}</h2>
      <p class="mt-4 text-text-secondary max-w-lg" data-anim="up">{t.processSub}</p>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10 mt-14" data-anim="stagger">
        {processSteps.map((step) => (
          <div data-anim-child class="group">
            <!-- Photo with number plaque -->
            <div class="relative aspect-square overflow-hidden">
              <picture>
                {step.image.endsWith('.webp') && step.image2x.endsWith('.webp') && (
                  <source
                    type="image/avif"
                    srcset={`${step.image.replace(/\.webp$/, '.avif')} 1x, ${step.image2x.replace(/\.webp$/, '.avif')} 2x`}
                  />
                )}
                <img
                  src={step.image}
                  srcset={`${step.image} 1x, ${step.image2x} 2x`}
                  width="1200" height="1200"
                  alt={step.alt}
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 w-full h-full object-cover grayscale-[15%] sepia-[10%]"
                />
              </picture>
              <!-- Soft top→bottom gradient pro čitelnost plaque -->
              <div class={`absolute inset-0 bg-gradient-to-t ${t.processGradientFrom} via-transparent to-transparent pointer-events-none`}></div>
              <!-- Number plaque (jako homepage process) -->
              <div class="absolute top-4 left-4 h-11 w-11 rounded-full border border-white/60 bg-button-text/85 backdrop-blur-sm flex items-center justify-center text-gold-deep text-[11px] font-medium uppercase tracking-[0.15em] font-sans shadow-plaque">
                {step.number}
              </div>
            </div>
            <!-- Info below -->
            <div class="pt-5 pb-5 border-b border-border">
              <h3>{step.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-text-secondary font-sans" set:html={step.description} />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ====== RUČNÍ VÝROBA — 3 cards grid (vzor: opravy/čištění) ====== -->
  <section id="rucni-vyroba" class="relative bg-bg-secondary border-b border-border section-md overflow-hidden">
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <div class="max-w-3xl mb-14">
        <span class="label-dot" data-anim="fade">{t.handmadeLabel}</span>
        <h2 class="mt-5" data-anim="up" set:html={t.handmadeHeading} />
        <p class="mt-6 text-text-secondary body-lg" data-anim="up">{t.handmadeIntro}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10" data-anim="stagger">
        {t.handmadeItems.map((item) => (
          <div data-anim-child class="border-b border-border pb-8">
            <span class="font-sans text-[11px] font-medium uppercase tracking-[0.2em] text-gold-on-light">{item.number}</span>
            <h3 class="mt-3">{item.title}</h3>
            <p class="body-md text-text-secondary leading-relaxed mt-3 font-sans">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ====== MATERIALS — 2 columns ====== -->
  <section class="relative bg-bg-primary border-b border-border section-md">
    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <span class="label-dot" data-anim="fade">{t.materialsLabel}</span>
      <h2 class="mt-5 max-w-2xl" data-anim="up">{t.materialsHeading}</h2>
      <p class="mt-4 text-text-secondary max-w-lg" data-anim="up">{t.materialsSub}</p>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center mt-14" data-anim="up">
        <div class="relative overflow-hidden" data-anim="scale">
          <picture>
            <source
              type="image/avif"
              srcset="/images/zakazkova--materialy--opal-centr.avif 1x, /images/zakazkova--materialy--opal-centr@2x.avif 2x"
            />
            <img
              src="/images/zakazkova--materialy--opal-centr.webp"
              srcset="/images/zakazkova--materialy--opal-centr.webp 1x, /images/zakazkova--materialy--opal-centr@2x.webp 2x"
              width="800" height="600"
              alt={t.materialsImgAlt}
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover grayscale-[15%] sepia-[10%]"
            />
          </picture>
          <PhotoFrame />
        </div>
        <div class="space-y-8">
          {materials.map((mat) => (
            <div>
              <h3>{mat.title}</h3>
              <p class="mt-2 text-text-secondary body-md leading-relaxed">{mat.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ====== DRUHÝ ŽIVOT ŠPERKŮ / SECOND LIFE — Philosophy pattern (homepage) ====== -->
  <section id={t.secondLifeId} class="relative bg-bg-primary border-b border-border section-lg overflow-hidden">
    <div class="radial-overlay"></div>

    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14 relative">
      <div class="grid lg:grid-cols-[0.34fr_1fr] gap-12 lg:gap-16">

        <!-- Left rail -->
        <div class="lg:border-r lg:border-border lg:pr-10">
          <div class="lg:sticky lg:top-32">
            <h2 class="sr-only">{t.secondLifeLabel}</h2>
            <span class="label-dot" data-anim="fade">{t.secondLifeLabel}</span>
            <p class="body-md text-text-secondary leading-relaxed mt-5 max-w-[260px] font-sans">
              {t.secondLifeIntro}
            </p>
          </div>
        </div>

        <!-- Right content -->
        <div>
          <!-- Large italic heading -->
          <p class="font-serif italic display-quote-lg text-text-primary font-normal max-w-3xl" data-anim="up" set:html={t.secondLifeQuote} />

          <!-- Split: copy + image -->
          <div class="grid md:grid-cols-2 gap-10 mt-14 items-start">
            <div data-anim="up">
              <p class="text-text-secondary body-lg font-sans">
                {t.secondLifeP1}
              </p>
              <p class="text-text-secondary body-lg mt-4 font-sans">
                {t.secondLifeP2}
              </p>
            </div>
            <div class="relative overflow-hidden" data-anim="up">
              <picture>
                <source
                  type="image/avif"
                  srcset="/images/druhy-zivot--hero--martin-pri-praci.avif 1x, /images/druhy-zivot--hero--martin-pri-praci@2x.avif 2x"
                />
                <img
                  src="/images/druhy-zivot--hero--martin-pri-praci.webp"
                  srcset="/images/druhy-zivot--hero--martin-pri-praci.webp 1x, /images/druhy-zivot--hero--martin-pri-praci@2x.webp 2x"
                  width="800" height="600"
                  alt={t.secondLifeImgAlt}
                  loading="lazy"
                  decoding="async"
                  class="block w-full h-auto object-cover grayscale-[15%] sepia-[10%]"
                />
              </picture>
              <PhotoFrame />
              <div class="absolute bottom-4 left-4 bg-bg-primary/90 backdrop-blur-md px-4 py-2.5 shadow-soft">
                <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-gold-on-light font-sans">{t.secondLifeBadge}</span>
              </div>
            </div>
          </div>

          <!-- 3 Examples -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-14" data-anim="stagger">
            {secondLife.map((s) => (
              <div data-anim-child class="border-t border-border pt-5">
                <span class="text-[12px] text-text-muted font-sans">{s.number}</span>
                <p class="mt-2 body-md font-medium text-text-primary font-sans">{s.title}</p>
                <p class="mt-2 text-text-secondary body-md leading-relaxed font-sans">{s.description}</p>
              </div>
            ))}
          </div>

          <div class="mt-12 flex flex-col sm:flex-row gap-4">
            <Button href={t.contactHref} variant="primary">{t.secondLifeCta}</Button>
            <Button href={SITE.whatsapp} variant="secondary">{t.whatsappCta}</Button>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ====== PRICING — Stříbro + Zlato side by side ====== -->
  <section id={t.pricingId} class="relative bg-bg-primary border-b border-border section-md">
    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <span class="label-dot" data-anim="fade">{t.pricingLabel}</span>
      <h2 class="mt-5" data-anim="up">{t.pricingHeading}</h2>
      <p class="mt-4 text-text-secondary max-w-xl" data-anim="up" set:html={t.pricingSub} />
      <p class="mt-4 text-text-secondary max-w-xl body-md leading-relaxed" data-anim="up">{t.pricingWorkNote}</p>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 mt-14" data-anim="up">
        <!-- Stříbro -->
        <div>
          <h3 class="mb-6">{t.silverHeading}</h3>
          <div class="border-t border-border">
            {pricingSilver.map((row) => (
              <div class="flex items-center justify-between py-4 border-b border-border">
                <span class="text-text-primary">{row.item}</span>
                <span class="text-text-secondary font-medium whitespace-nowrap ml-4">{row.price}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Zlato -->
        <div>
          <h3 class="mb-6">{t.goldHeading}</h3>
          <div class="border-t border-border">
            {pricingGold.map((row) => (
              <div class="flex items-center justify-between py-4 border-b border-border">
                <span class="text-text-primary">{row.item}</span>
                <span class="text-text-secondary font-medium whitespace-nowrap ml-4">{row.price}</span>
              </div>
            ))}
          </div>
          <p class="mt-4 body-md text-text-secondary">{t.goldNote}</p>
        </div>
      </div>

      <!-- Disclaimer ceny zlata -->
      <p class="mt-12 max-w-3xl font-serif italic text-[15px] text-text-secondary leading-[1.7]" data-anim="up">
        {t.disclaimerBefore}{new Date(`${SITE.pricesAsOf}T12:00:00`).toLocaleDateString(t.dateLocale, { day: 'numeric', month: 'long', year: 'numeric' })}{t.disclaimerAfter}<a href={SITE.phoneHref} class="not-italic font-sans text-gold-on-light hover:text-gold-deep transition-colors font-medium whitespace-nowrap">{SITE.phone}</a>.
      </p>
    </div>
  </section>

  <!-- ====== EXPRESS ====== -->
  <section id="express" class="relative bg-bg-primary border-b border-border section-md">
    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      {/* Framed CTA panel — sladěno s Footer CTA panelem (border + bg-button-text/60 + backdrop-blur),
          ať jsou CTA bloky napříč webem vizuálně stejné. */}
      <div data-anim="up" class="relative border border-border bg-button-text/60 backdrop-blur-sm px-6 sm:px-8 lg:px-12 py-12 sm:py-14 lg:py-20 overflow-hidden">

        <!-- Subtle gold radial glow behind photo -->
        <div class="hidden lg:block absolute right-[8%] top-1/2 -translate-y-1/2 w-[420px] h-[420px] bg-[radial-gradient(circle,rgba(198,168,90,0.06)_0%,transparent_65%)] pointer-events-none"></div>

        <div class="grid grid-cols-1 lg:grid-cols-[1fr_0.55fr] gap-8 lg:gap-12 items-center relative">
          <div>
            <span class="label-dot">{t.expressLabel}</span>
            <h2 class="mt-5" set:html={t.expressHeading} />
            <p class="mt-5 body-md text-text-secondary max-w-xl leading-relaxed font-sans">
              {t.expressBody}
            </p>
            <div class="mt-8 flex flex-col sm:flex-row gap-4">
              <Button href={SITE.phoneHref} variant="primary">{t.expressCta1}</Button>
              <Button href={SITE.whatsapp} variant="secondary">{t.whatsappCta}</Button>
            </div>
          </div>
          <div class="hidden lg:flex items-center justify-center relative" data-anim="scale">
            <!-- Jediný kandidát: soubor má 1388px na slot max. 300px, takže pokrývá
                 i retinu. Density srcset tu byl jen zdánlivý, @2x byl bit po bitu
                 stejný soubor jako 1x. -->
            <picture>
              <source
                type="image/avif"
                srcset="/images/zakazkova--express--prsten-safir.avif"
              />
              <img
                src="/images/zakazkova--express--prsten-safir.webp"
                width="600" height="600"
                alt={t.expressImgAlt}
                loading="lazy"
                decoding="async"
                class="w-full max-w-[300px] h-auto object-cover relative z-10"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== FAQ — bg-secondary ====== -->
  <section class="relative bg-bg-primary section-md overflow-hidden">
