  { number: '02', image: '/images/zakazkova--proces-02--vykres2.webp', image2x: '/images/zakazkova--proces-02--vykres2.webp' },
  { number: '03', image: '/images/zakazkova--proces-03--vyroba.webp', image2x: '/images/zakazkova--proces-03--vyroba.webp' },
  { number: '04', image: '/images/zakazkova--proces-04--predani.webp', image2x: '/images/zakazkova--proces-04--predani.webp' },
];
const processSteps = processStepsShared.map((step, i) => ({ ...step, ...t.processSteps[i] }));

const materials = t.materials;
const pricingSilver = t.pricingSilver;
const pricingGold = t.pricingGold;
const secondLife = t.secondLife;
const faqItems = t.faqItems;

// Scattered gallery — pozice, velikost, `data-float` offset a obrázek.
/**
 * Scattered hero galerie — responzivní bezpečné zóny:
 * Text má max-w-3xl (768 px) centrovaný → poloviční šířka 384 px. Boční fotky
 * se pozicují od STŘEDU (`calc(50% + ≥390px)`), takže s textem nemohou kolidovat
 * na žádné šířce viewportu; na užších oknech přirozeně „vyjíždí" za okraj
 * (overflow-hidden sekce je ořízne — záměrný editorial efekt).
 * Středové akcenty (nad/pod textem) se ukazují jen při dostatku místa
 * v OBOU osách (≥1280 px šířka a ≥780 px výška) — na nižších oknech by
 * narazily do label/tlačítek.
 */
const scatteredGallery = [
  // Levý koridor (pravá hrana ≥ 390 px od středu). Střední/dolní pásmo až od xl —
  // na lg by z fotek zbyly jen úzké proužky světlého pozadí.
  { pos: 'top-[6%] right-[calc(50%+420px)] w-[clamp(180px,24vw,320px)]',   float: 0.3, base: 'zakazkova--proces-03--snubaky-v-ruce-vyroba',      w: 800,  h: 600 },
  { pos: 'hidden xl:block top-[42%] right-[calc(50%+470px)] w-[clamp(110px,13vw,160px)]',  float: 0.6, base: 'zakazkova--materialy--opal-na-dreve',              w: 800,  h: 600 },
  { pos: 'hidden xl:block bottom-[7%] right-[calc(50%+390px)] w-[clamp(160px,20vw,270px)]', float: 0.7, base: 'zakazkova--proces-04--privesek-J-na-krku-predani', w: 800,  h: 600 },
  // Pravý koridor (levá hrana ≥ 390 px od středu)
  { pos: 'top-[4%] left-[calc(50%+410px)] w-[clamp(170px,22vw,300px)]',    float: 0.3, base: 'homepage--portfolio-3--snubni-prsteny-zlate',      w: 800,  h: 600 },
  { pos: 'hidden xl:block top-[40%] left-[calc(50%+450px)] w-[clamp(150px,18vw,260px)]',   float: 0.5, base: 'homepage--portfolio-2--privesek-citrin',           w: 800,  h: 600 },
  { pos: 'hidden xl:block bottom-[5%] left-[calc(50%+390px)] w-[clamp(140px,16vw,210px)]', float: 0.8, base: 'zakazkova--parallax--tricolor-prsten-na-kovadline', w: 1920, h: 1080 },
  // Středové akcenty — jen na velkých oknech (šířka × výška)
  { pos: 'hidden [@media(min-width:1280px)_and_(min-height:780px)]:block top-[3%] left-[37%] w-[clamp(140px,12vw,200px)]',     float: 0.4, base: 'zakazkova--proces-01--3d-cad-navrh',       w: 800, h: 600 },
  { pos: 'hidden [@media(min-width:1280px)_and_(min-height:780px)]:block bottom-[3%] right-[28%] w-[clamp(150px,14vw,230px)]', float: 0.6, base: 'zakazkova--proces-02--3d-cad-perspektiva', w: 800, h: 600 },
];

const jsonLd = graph(
  faqPageSchema(faqItems),
  customJewelryServiceSchema(),
  breadcrumbSchema(t.breadcrumb),
);
---

<Layout
  locale={locale}
  title={t.title}
  ogImage="/images/og/og-zakazkova-tvorba.jpg"
  description={t.description}
  navOverlay
  jsonLd={jsonLd}
  ctaHeading={t.ctaHeading}
  ctaSubtitle={t.ctaSubtitle}
>

  <!-- ====== HERO — Scattered Gallery ====== -->
  <section class="relative bg-bg-primary border-b border-border overflow-hidden min-h-0 lg:min-h-dvh">

    <!-- Scattered images — od lg (pod 1024 px nemají boční koridory prostor) -->
    <div class="hidden lg:block absolute inset-0 pointer-events-none" aria-hidden="true">
      {scatteredGallery.map((img) => (
        <div class={`absolute ${img.pos}`} data-float={img.float}>
          <img
            src={`/images/${img.base}.webp`}
            srcset={`/images/${img.base}.webp 1x, /images/${img.base}@2x.webp 2x`}
            alt="" width={img.w} height={img.h} loading="lazy" decoding="async"
            class="w-full h-auto object-cover shadow-scatter"
          />
        </div>
      ))}
    </div>

    <!-- Mobile + tablet: left-aligned, content top, hero fotka (matchne homepage).
         lg+: centered + dvh + vertical center pro scattered gallery -->
    <div class="relative z-10 flex flex-col items-start text-left justify-start lg:items-center lg:text-center lg:justify-center px-6 sm:px-8 lg:px-14 section-hero lg:py-0 min-h-[80vh] lg:min-h-dvh">
      <span class="label-dot" data-anim="fade">{t.heroLabel}</span>
      <h1 class="mt-6 max-w-3xl" data-anim="up" set:html={t.heroH1} />
      <p class="subtitle mt-6" data-anim="up">
        {t.heroSubtitle}
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-4 w-full sm:w-auto" data-anim="up">
        <Button href="#process" variant="primary">{t.heroCta1}</Button>
        <Button href={t.pricingAnchor} variant="secondary">{t.heroCta2}</Button>
      </div>

      <!-- Mobile + tablet (pod lg) -->
      <div class="lg:hidden mt-12 w-full max-w-2xl">
        <ResponsivePicture
          base="zakazkova--hero--privesek-quartz-na-krku"
          width="1920" height="1080"
          alt={t.heroMobileAlt}
          loading="eager"
          fetchpriority="high"
          class="w-full h-auto object-cover" />
      </div>
    </div>
  </section>

  <!-- ====== PROCESS — 4 cards grid ====== -->
  <section id="process" class="relative bg-bg-primary border-b border-border section-md overflow-hidden">
    <div class="radial-overlay"></div>
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <span class="label-dot" data-anim="fade">{t.processLabel}</span>
      <h2 class="mt-5 max-w-2xl" data-anim="up">{t.processHeading}</h2>
      <p class="mt-4 text-text-secondary max-w-lg" data-anim="up">{t.processSub}</p>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10 mt-14" data-anim="stagger">
        {processSteps.map((step) => (
          <div data-anim-child class="group">
            <!-- Photo with number plaque -->
            <div class="relative aspect-square overflow-hidden">
              <img
                src={step.image}
                srcset={`${step.image} 1x, ${step.image2x} 2x`}
                width="1200" height="1200"
                alt={step.alt}
                loading="lazy"
                decoding="async"
                class="absolute inset-0 w-full h-full object-cover grayscale-[15%] sepia-[10%]"
              />
              <!-- Soft top→bottom gradient pro čitelnost plaque -->
              <div class={`absolute inset-0 bg-gradient-to-t ${t.processGradientFrom} via-transparent to-transparent pointer-events-none`}></div>
              <!-- Number plaque (jako homepage process) -->
              <div class="absolute top-4 left-4 h-11 w-11 rounded-full border border-white/60 bg-button-text/85 backdrop-blur-sm flex items-center justify-center text-gold-deep text-[11px] font-medium uppercase tracking-[0.15em] font-sans shadow-plaque">
                {step.number}
              </div>
            </div>
            <!-- Info below -->
            <div class="pt-5 pb-5 border-b border-border">
              <h3>{step.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-text-secondary font-sans">{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ====== MATERIALS — 2 columns ====== -->
  <section class="relative bg-bg-primary border-b border-border section-md">
    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <span class="label-dot" data-anim="fade">{t.materialsLabel}</span>
      <h2 class="mt-5 max-w-2xl" data-anim="up">{t.materialsHeading}</h2>
      <p class="mt-4 text-text-secondary max-w-lg" data-anim="up">{t.materialsSub}</p>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center mt-14" data-anim="up">
        <div class="relative overflow-hidden" data-anim="scale">
          <img
            src="/images/zakazkova--materialy--opal-na-dreve.webp"
            srcset="/images/zakazkova--materialy--opal-na-dreve.webp 1x, /images/zakazkova--materialy--opal-na-dreve@2x.webp 2x"
            width="800" height="600"
            alt={t.materialsImgAlt}
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover grayscale-[15%] sepia-[10%]"
          />
          <PhotoFrame />
        </div>
        <div class="space-y-8">
          {materials.map((mat) => (
            <div>
              <h3>{mat.title}</h3>
              <p class="mt-2 text-text-secondary body-md leading-relaxed">{mat.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ====== DRUHÝ ŽIVOT ŠPERKŮ / SECOND LIFE — Philosophy pattern (homepage) ====== -->
  <section id={t.secondLifeId} class="relative bg-bg-primary border-b border-border section-lg overflow-hidden">
    <div class="radial-overlay"></div>

    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14 relative">
      <div class="grid lg:grid-cols-[0.34fr_1fr] gap-12 lg:gap-16">

        <!-- Left rail -->
        <div class="lg:border-r lg:border-border lg:pr-10">
          <div class="lg:sticky lg:top-32">
            <span class="label-dot" data-anim="fade">{t.secondLifeLabel}</span>
            <p class="body-md text-text-secondary leading-relaxed mt-5 max-w-[260px] font-sans">
              {t.secondLifeIntro}
            </p>
          </div>
        </div>

        <!-- Right content -->
        <div>
          <!-- Large italic heading -->
          <p class="font-serif italic display-quote-lg text-text-primary font-normal max-w-3xl" data-anim="up" set:html={t.secondLifeQuote} />

          <!-- Split: copy + image -->
          <div class="grid md:grid-cols-2 gap-10 mt-14">
            <div data-anim="up">
              <p class="text-text-secondary body-lg font-sans">
                {t.secondLifeP1}
              </p>
              <p class="text-text-secondary body-lg mt-4 font-sans">
                {t.secondLifeP2}
              </p>
            </div>
            <div class="relative overflow-hidden" data-anim="up">
              <img
                src="/images/druhy-zivot--hero--martin-pri-praci.webp"
                srcset="/images/druhy-zivot--hero--martin-pri-praci.webp 1x, /images/druhy-zivot--hero--martin-pri-praci@2x.webp 2x"
                width="800" height="600"
                alt={t.secondLifeImgAlt}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover grayscale-[15%] sepia-[10%]"
              />
              <PhotoFrame />
              <div class="absolute bottom-4 left-4 bg-bg-primary/90 backdrop-blur-md px-4 py-2.5 shadow-soft">
                <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-gold-on-light font-sans">{t.secondLifeBadge}</span>
              </div>
            </div>
          </div>

          <!-- 3 Examples -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-14" data-anim="stagger">
            {secondLife.map((s) => (
              <div data-anim-child class="border-t border-border pt-5">
                <span class="text-[12px] text-text-muted font-sans">{s.number}</span>
                <p class="mt-2 body-md font-medium text-text-primary font-sans">{s.title}</p>
                <p class="mt-2 text-text-secondary body-md leading-relaxed font-sans">{s.description}</p>
              </div>
            ))}
          </div>

          <div class="mt-12 flex flex-col sm:flex-row gap-4">
            <Button href={t.contactHref} variant="primary">{t.secondLifeCta}</Button>
            <Button href={SITE.whatsapp} variant="secondary">{t.whatsappCta}</Button>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ====== PRICING — Stříbro + Zlato side by side ====== -->
  <section id={t.pricingId} class="relative bg-bg-primary border-b border-border section-md">
    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <span class="label-dot" data-anim="fade">{t.pricingLabel}</span>
      <h2 class="mt-5" data-anim="up">{t.pricingHeading}</h2>
      <p class="mt-4 text-text-secondary max-w-xl" data-anim="up">{t.pricingSub}</p>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 mt-14" data-anim="up">
        <!-- Stříbro -->
        <div>
          <h3 class="mb-6">{t.silverHeading}</h3>
          <div class="border-t border-border">
            {pricingSilver.map((row) => (
              <div class="flex items-center justify-between py-4 border-b border-border">
                <span class="text-text-primary">{row.item}</span>
                <span class="text-text-secondary font-medium whitespace-nowrap ml-4">{row.price}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Zlato -->
        <div>
          <h3 class="mb-6">{t.goldHeading}</h3>
          <div class="border-t border-border">
            {pricingGold.map((row) => (
              <div class="flex items-center justify-between py-4 border-b border-border">
                <span class="text-text-primary">{row.item}</span>
                <span class="text-text-secondary font-medium whitespace-nowrap ml-4">{row.price}</span>
              </div>
            ))}
          </div>
          <p class="mt-4 body-md text-text-muted">{t.goldNote}</p>
        </div>
      </div>

      <!-- Disclaimer ceny zlata -->
      <p class="mt-12 max-w-3xl font-serif italic text-[15px] text-text-muted leading-[1.7]" data-anim="up">
        {t.disclaimerBefore}{new Date().toLocaleDateString(t.dateLocale, { day: 'numeric', month: 'long', year: 'numeric' })}{t.disclaimerAfter}<a href={SITE.phoneHref} class="not-italic font-sans text-gold-on-light hover:text-gold-deep transition-colors font-medium whitespace-nowrap">{SITE.phone}</a>.
      </p>
    </div>
  </section>

  <!-- ====== EXPRESS ====== -->
  <section id="express" class="relative bg-bg-primary border-b border-border section-md">
    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <div class="grid lg:grid-cols-[1fr_0.5fr] gap-12 lg:gap-16 items-center" data-anim="up">
        <div>
          <span class="label-dot">{t.expressLabel}</span>
          <h2 class="mt-5" set:html={t.expressHeading} />
          <p class="mt-4 text-text-secondary body-lg max-w-xl">
            {t.expressBody}
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-4">
            <Button href={SITE.phoneHref} variant="primary">{t.expressCta1}</Button>
            <Button href={SITE.whatsapp} variant="secondary">{t.whatsappCta}</Button>
          </div>
        </div>
        <div class="hidden lg:block" data-anim="scale">
          <img
            src="/images/zakazkova--express--prsten-safir.webp"
            srcset="/images/zakazkova--express--prsten-safir.webp 1x, /images/zakazkova--express--prsten-safir@2x.webp 2x"
            width="600" height="600"
            alt={t.expressImgAlt}
            loading="lazy"
            decoding="async"
            class="w-full h-auto object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ====== FAQ — bg-secondary ====== -->
  <section class="relative bg-bg-primary section-md overflow-hidden">
    <div class="radial-overlay"></div>
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <span class="label-dot" data-anim="fade">{t.faqLabel}</span>
      <h2 class="mt-5 mb-12" data-anim="up">{t.faqHeading}</h2>
      <FAQ items={faqItems} />
    </div>
  </section>


</Layout>
