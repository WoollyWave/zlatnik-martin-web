---
/**
 * Sdílená šablona detailu produktu (CS /sperky/[slug]/ + EN /en/jewelry/[slug]/).
 * `getStaticPaths()` žije v route wrapperech v src/pages/ — šablona dostává
 * `product` přes props. Texty v lokálním slovníku `t`, EN pole produktu
 * s fallbackem na CS (`||` přesně jako v původních souborech).
 */
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import ProductCard from '../components/ProductCard.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import { products, type Product } from '../data/products';
import { productSchema, breadcrumbSchema, productPageGraph } from '../lib/seo';
import { SITE } from '../data/site';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
  product: Product;
}

const { locale, product } = Astro.props;
const isEn = locale === 'en';

// Lokalizovaná pole produktu — EN s fallbackem na CS hodnotu
const title = isEn ? product.titleEn || product.title : product.title;
const description = isEn ? product.descriptionEn || product.description : product.description;
const material = isEn ? product.materialEn || product.material : product.material;
const alt = isEn ? product.altEn || product.alt : product.alt;
const priceSilver = isEn ? product.priceSilverEn || product.priceSilver : product.priceSilver;
const priceGold = isEn ? product.priceGoldEn || product.priceGold : product.priceGold;
const goldNote = isEn ? product.goldNoteEn || product.goldNote : product.goldNote;
const size = isEn ? product.sizeEn || product.size : product.size;
const notes = isEn ? product.notesEn || product.notes : product.notes;

/**
 * Kusy vyrobené jen ve zlatě nemají stříbrnou variantu — zlato pak nehraje roli
 * „na zakázku do 3 týdnů", ale je to ten konkrétní kus skladem. Hlavní cenový
 * blok proto přebírá zlato a druhotný blok i poznámka o orientační ceně odpadají.
 */
const goldOnly = !priceSilver && !!priceGold;
const primaryPrice = goldOnly ? priceGold : priceSilver;
/* Hmotnosti jsou v datech psané česky („2,50 g"). Anglický čtenář čte čárku
   jako oddělovač tisíců, a to hned pod cenou formátovanou jako „CZK 19,200".
   Desetinný oddělovač proto pro EN překlápíme na tečku. */
const localizeWeight = (w?: string) => (isEn && w ? w.replace(/(\d),(\d)/g, '$1.$2') : w);
const primaryWeight = localizeWeight(goldOnly ? product.weightGold : product.weightSilver);
const secondaryWeight = localizeWeight(product.weightGold);

const currentIndex = products.findIndex((p) => p.slug === product.slug);
const rotatedProducts = [
  ...products.slice(currentIndex + 1),
  ...products.slice(0, currentIndex),
];
const otherProducts = (isEn ? rotatedProducts.filter((p) => !!p.slugEn) : rotatedProducts).slice(0, 2);

const jsonLd = isEn
  ? productPageGraph(
      productSchema(product, 'en'),
      breadcrumbSchema([
        { name: 'Home', url: '/en/' },
        { name: 'In stock', url: '/en/in-stock/' },
        { name: title, url: `/en/jewelry/${product.slugEn!}/` },
      ]),
      'en',
    )
  : productPageGraph(
      productSchema(product),
      breadcrumbSchema([
        { name: 'Domů', url: '/' },
        { name: 'Skladem', url: '/skladem/' },
        { name: product.title, url: `/sperky/${product.slug}/` },
      ]),
    );

const isOriginal = product.stockBadge === 'jediny-originalni-kus';
const isSold = product.sold === true;

const t = isEn
  ? {
      // Krátký brand suffix — s plným „Goldsmith workshop" přesahovaly titulky 60 znaků a SERP je řezal.
      titleTail: 'Martin Ševr',
      backHref: '/en/in-stock/',
      backLabel: 'Back to In stock',
      originalBadge: '✦ One of a kind',
      sizeLabel: 'Size',
      materialLabel: 'Material',
      availabilityLabel: 'Availability',
      availabilityOriginal: 'One of a kind, collect at the workshop',
      availabilityStock: 'In stock, collect at the workshop or shipped',
      availabilitySold: 'Sold. I can make a new one to order.',
      silverSold: 'Sold',
      ctaSoldPrimary: 'I want a new one made',
      silverHeading: 'Silver 925/1000',
      silverOriginal: 'One of a kind',
      silverStock: 'In stock',
      goldHeading: 'Gold 585/1000',
      goldLead: 'Made to order, within 3 weeks',
      weightLabel: 'Weight:',
      goldPriceNote: 'The gold price is indicative, valid as of 12 May 2026. I confirm the final price on the day of the order.',
      reviewsLabel: 'Customer reviews',
      reviewsOutOf: 'out of 5',
      ctaHref: '/en/contact/',
      ctaPrimary: 'I want this piece',
      ctaWhatsapp: 'Message on WhatsApp',
      pickupNote: 'Pick up in person at the workshop or insured shipping anywhere in Czechia.',
      detailsLabel: 'Details',
      detailsLead: 'Every angle tells a story.',
      otherLabel: 'Other pieces',
      otherHeading: 'You might also',
      otherHeadingEm: 'like',
      allHref: '/en/in-stock/',
      allLabel: 'All pieces',
    }
  : {
      titleTail: 'Martin Ševr',
      backHref: '/skladem/',
      backLabel: 'Zpět na Skladem',
      originalBadge: '✦ Jediný originální kus',
      sizeLabel: 'Velikost',
      materialLabel: 'Materiál',
      availabilityLabel: 'Dostupnost',
      availabilityOriginal: 'Jediný originální kus, k vyzvednutí v dílně',
      availabilityStock: 'Skladem, k vyzvednutí v dílně nebo poštou',
      availabilitySold: 'Prodáno. Na objednávku vyrobím nový.',
      silverSold: 'Prodáno',
      ctaSoldPrimary: 'Chci nový na zakázku',
      silverHeading: 'Stříbro 925/1000',
      silverOriginal: 'Originální kus',
      silverStock: 'Skladem',
      goldHeading: 'Zlato 585/1000',
      goldLead: 'Na zakázku, do 3 týdnů',
      weightLabel: 'Váha:',
      goldPriceNote: 'Cena zlaté varianty je orientační, platná k 12. 5. 2026. Finální cenu stanovuji v den objednávky.',
      reviewsLabel: 'Hodnocení zákazníků',
      reviewsOutOf: 'z 5',
      ctaHref: '/kontakt/',
      ctaPrimary: 'Chci tento šperk',
      ctaWhatsapp: 'Napsat na WhatsApp',
      pickupNote: 'Osobní vyzvednutí v dílně nebo pojištěná zásilka po celé ČR.',
      detailsLabel: 'Detaily',
      detailsLead: 'Každý úhel vypráví příběh.',
      otherLabel: 'Další šperky',
      otherHeading: 'Mohlo by se vám',
      otherHeadingEm: 'líbit',
      allHref: '/skladem/',
      allLabel: 'Všechny šperky',
    };

const availabilityLabel = isOriginal ? t.availabilityOriginal : t.availabilityStock;

// Krátké produktové popisky (<70 znaků) by dávaly prázdný SERP snippet — meta
// description doplní materiál a logistiku. Viditelný text stránky se nemění.
const metaDescription = description.length >= 70
  ? description
  : `${description} ${material}. ${t.pickupNote}`;

// Recenze — zobrazují se viditelně A jdou do JSON-LD (parity vyžadovaná Googlem).
const reviews = product.reviews ?? [];
const avgRating = reviews.length
  ? Number((reviews.reduce((a, r) => a + r.rating, 0) / reviews.length).toFixed(1))
  : null;
const reviewDateFmt = new Intl.DateTimeFormat(isEn ? 'en-GB' : 'cs-CZ', { year: 'numeric', month: 'long' });

const primaryHeading = goldOnly ? t.goldHeading : t.silverHeading;
---

<Layout
  locale={locale}
  title={`${title} | ${t.titleTail}`}
  description={metaDescription}
  ogImage={product.imageCard || product.image}
  ogImageWidth={product.imageCard ? 1200 : 1000}
  ogImageHeight={product.imageCard ? 800 : 1000}
  jsonLd={jsonLd}
  navOverlay
>

  <!-- ====== HERO — Split: info left + photo right ====== -->
  <section class="relative bg-bg-primary border-b border-border section-hero overflow-clip">
    <div class="radial-overlay"></div>
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <div class="grid lg:grid-cols-[0.85fr_1.15fr] gap-10 lg:gap-16 items-start">

        <!-- Left — info -->
        <div data-anim="up">
          <a href={t.backHref} class="inline-flex items-center gap-2 text-[clamp(0.6875rem,0.6rem+0.15vw,0.8125rem)] text-text-muted hover:text-gold-deep transition-colors duration-200 uppercase tracking-[0.2em] font-sans font-medium">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" /></svg>
            {t.backLabel}
          </a>

          {isOriginal && (
            <div class="mt-6 inline-block bg-gold-deep text-button-text px-3 py-1.5 text-[10px] uppercase tracking-[0.15em] font-medium font-sans">
              {t.originalBadge}
            </div>
          )}

          <h1 class="mt-6">{title}</h1>

          <p class="mt-6 text-text-secondary body-lg max-w-lg">
            {description}
          </p>

          <!-- Meta -->
          <div class="mt-10 pt-8 border-t border-border grid grid-cols-2 gap-6">
            {size && (
              <div>
                <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-text-muted font-sans">{t.sizeLabel}</span>
                <p class="text-[13px] sm:text-[14px] text-text-primary mt-1 font-sans leading-snug">{size}</p>
              </div>
            )}
            <div>
              <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-text-muted font-sans">{t.materialLabel}</span>
              <p class="text-[13px] sm:text-[14px] text-text-primary mt-1 font-sans leading-snug">{material}</p>
            </div>
            <div class={size ? 'col-span-2' : ''}>
              <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-text-muted font-sans">{t.availabilityLabel}</span>
              <p class="text-[13px] sm:text-[14px] text-text-primary mt-1 font-sans leading-snug flex items-center gap-2">
                <span class={`w-1.5 h-1.5 rounded-full ${isSold ? 'bg-text-muted' : 'bg-success'}`}></span>
                {isSold ? t.availabilitySold : availabilityLabel}
              </p>
            </div>
          </div>

          <!-- Cenové varianty -->
          <div class="mt-10 grid sm:grid-cols-2 gap-4">
            <!-- Hlavní varianta — stříbro, nebo zlato u kusů jen ve zlatě -->
            <div class="border border-border bg-bg-primary/60 p-5">
              <span class="text-[10px] uppercase tracking-[0.2em] font-medium text-gold-on-light font-sans">{primaryHeading}</span>
              <p class="mt-2 text-[11px] text-text-muted font-sans">{isSold ? t.silverSold : isOriginal ? t.silverOriginal : t.silverStock}</p>
              <p class="mt-4 font-serif text-[1.5rem] text-gold-deep tracking-tight">{primaryPrice}</p>
              {primaryWeight && (
                <p class="mt-2 text-[12px] text-text-secondary font-sans">{t.weightLabel} {primaryWeight}</p>
              )}
            </div>

            <!-- Zlato jako druhá varianta (jen když existuje i stříbrná) -->
            {!goldOnly && priceGold && (
              <div class="border border-border bg-bg-secondary/40 p-5">
                <span class="text-[10px] uppercase tracking-[0.2em] font-medium text-gold-on-light font-sans">{t.goldHeading}</span>
                <p class="mt-2 text-[11px] text-text-muted font-sans">{t.goldLead}</p>
                <p class="mt-4 font-serif text-[1.5rem] text-text-primary tracking-tight">{priceGold}</p>
                {secondaryWeight && (
                  <p class="mt-2 text-[12px] text-text-secondary font-sans">{t.weightLabel} {secondaryWeight}</p>
                )}
                {goldNote && (
                  <p class="mt-1 text-[11px] text-text-muted font-sans">({goldNote})</p>
                )}
              </div>
            )}
          </div>

          {goldOnly && goldNote && (
            <p class="mt-4 body-md text-text-secondary">{goldNote}</p>
          )}

          {!goldOnly && priceGold && (
            <p class="mt-4 body-md text-text-secondary">
              {t.goldPriceNote}
            </p>
          )}

          <!-- Notes -->
          {notes && notes.length > 0 && (
            <ul class="mt-6 space-y-2 border-t border-border pt-6">
              {notes.map((note) => (
                <li class="body-md text-text-secondary flex gap-2"><span class="text-gold-deep">•</span><span>{note}</span></li>
              ))}
            </ul>
          )}

          <!-- Recenze — render jen s reálnými daty; stejná data jdou do JSON-LD -->
          {reviews.length > 0 && (
            <div class="mt-6 border-t border-border pt-6">
              <div class="flex items-center justify-between gap-4">
                <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-text-muted font-sans">{t.reviewsLabel}</span>
                <span class="inline-flex items-center gap-2 font-sans text-[13px] text-text-primary">
                  <span class="text-gold-deep" aria-hidden="true">★</span>
                  <strong class="font-medium">{avgRating}</strong>
                  <span class="text-text-muted">{t.reviewsOutOf} · {reviews.length}×</span>
                </span>
              </div>
              <ul class="mt-4 space-y-4">
                {reviews.map((r) => (
                  <li class="border border-border bg-bg-primary/60 p-4">
                    <div class="flex items-center justify-between gap-3">
                      <span class="font-sans text-[13px] font-medium text-text-primary">{r.author}</span>
                      <span class="font-sans text-[12px] text-gold-deep" aria-hidden="true">{'★'.repeat(r.rating)}<span class="text-border">{'★'.repeat(5 - r.rating)}</span></span>
                      <span class="sr-only">{r.rating} {t.reviewsOutOf}</span>
                    </div>
                    <p class="mt-2 body-md text-text-secondary leading-relaxed">{isEn ? r.textEn || r.text : r.text}</p>
                    <p class="mt-2 text-[11px] text-text-muted font-sans">{reviewDateFmt.format(new Date(r.date))}</p>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- CTA -->
          <div class="mt-8 flex flex-col sm:flex-row gap-4">
            <Button href={t.ctaHref} variant="primary">{isSold ? t.ctaSoldPrimary : t.ctaPrimary}</Button>
            <Button href={SITE.whatsapp} variant="secondary">{t.ctaWhatsapp}</Button>
          </div>

          <p class="mt-4 body-md text-text-secondary">
            {t.pickupNote}
          </p>
        </div>

        <!-- Right — main photo -->
        <div class="relative order-first lg:order-none lg:sticky lg:top-28 lg:self-start">
          {product.image && (
            <div class="relative overflow-hidden aspect-square max-w-[560px] mx-auto" data-anim="scale">
              <picture>
                {product.image.endsWith('.webp') && (
                  <source type="image/avif" srcset={product.image.replace(/\.webp$/, '.avif')} />
                )}
                <img
                  src={product.image}
                  width="1000" height="1000"
                  sizes="(min-width: 1024px) 560px, 100vw"
                  alt={alt}
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  class="absolute inset-0 w-full h-full object-contain"
                />
              </picture>
              <div class="absolute inset-3 border border-white/12 pointer-events-none"></div>
            </div>
          )}
        </div>

      </div>
    </div>
  </section>

  <!-- ====== DETAIL GALLERY ====== -->
  {product.detailImages && product.detailImages.length > 0 && (
    <section class="relative bg-bg-primary border-b border-border section-md">
      <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
        <h2 class="sr-only">{t.detailsLabel}</h2>
        <span class="label-dot" data-anim="fade">{t.detailsLabel}</span>
        <p class="body-md text-text-secondary leading-relaxed mt-4 max-w-xs">
          {t.detailsLead}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 mt-12" data-anim="stagger">
          {product.detailImages.map((img, i) => (
            <div data-anim-child class="relative overflow-hidden">
              <div class="aspect-square relative overflow-hidden">
                <picture>
                  {img.src.endsWith('.webp') && (
                    <source
                      type="image/avif"
                      srcset={img.src.replace(/\.webp$/, '.avif')}
                      sizes="(min-width: 1024px) 30vw, (min-width: 768px) 33vw, 100vw"
                    />
                  )}
                  <img
                    src={img.src}
                    width="1000" height="1000"
                    sizes="(min-width: 1024px) 30vw, (min-width: 768px) 33vw, 100vw"
                    alt={isEn ? img.altEn || img.alt : img.alt}
                    loading="lazy" decoding="async"
                    class="absolute inset-0 w-full h-full object-contain"
                  />
                </picture>
                <PhotoFrame />
                <div class="absolute top-4 left-4 bg-bg-primary/90 backdrop-blur-md px-3 py-1.5">
                  <span class="text-[11px] font-medium text-gold-on-light font-sans">{`0${i + 1}`}</span>
                </div>
              </div>
              <p class="mt-3 body-md text-text-secondary font-sans">{isEn ? img.altEn || img.alt : img.alt}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ====== DALŠÍ ŠPERKY ====== -->
  <section class="relative bg-bg-primary border-b border-border section-md overflow-hidden">
    <div class="radial-overlay"></div>
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">

      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-14">
        <div data-anim="up">
          <span class="label-dot">{t.otherLabel}</span>
          <h2 class="mt-5">{t.otherHeading} <em>{t.otherHeadingEm}</em></h2>
        </div>
        <div data-anim="up">
          <Button href={t.allHref} variant="text">{t.allLabel}</Button>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10" data-anim="stagger">
        {otherProducts.map((p) => (
          <div data-anim-child>
            <ProductCard
              locale={locale}
              title={isEn ? p.titleEn || p.title : p.title}
              material={isEn ? p.materialEn || p.material : p.material}
              priceSilver={isEn ? p.priceSilverEn || p.priceSilver : p.priceSilver}
              priceGold={isEn ? p.priceGoldEn || p.priceGold : p.priceGold}
              goldNote={isEn ? p.goldNoteEn || p.goldNote : p.goldNote}
              href={isEn ? `/en/jewelry/${p.slugEn || p.slug}/` : `/sperky/${p.slug}/`}
              category={p.category}
              image={p.imageCard || p.image}
              alt={isEn ? p.altEn || p.alt : p.alt}
              description={isEn ? p.descriptionEn || p.description : p.description}
              stockBadge={p.stockBadge}
            />
          </div>
        ))}
      </div>

    </div>
  </section>

</Layout>
