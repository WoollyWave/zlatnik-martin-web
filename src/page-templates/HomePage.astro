---
/**
 * Sdílená šablona homepage (CS / + EN /en/).
 * Route soubory v src/pages/ jsou tenké wrappery — veškerá struktura žije tady,
 * texty v lokálním slovníku `t`. Vzor: ContactPage.astro.
 */
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import PortfolioListCard from '../components/PortfolioListCard.astro';
import { portfolioCases } from '../data/portfolio';
import { products } from '../data/products';
import { homeGraph } from '../lib/seo';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const isEn = locale === 'en';

const t = isEn
  ? {
      title: 'Goldsmith in Prague | Handmade & Custom Jewellery, Martin Ševr',
      description: 'Handmade jewellery in gold, silver and natural stones. Every piece an original. Custom commissions in Prague.',
      heroLabel: 'Goldsmith workshop in Prague, Pod Kesnerkou',
      h1Line1: 'Jewellery made <em>by hand</em>.',
      h1Line2: 'Not stamped out in batches.',
      heroSubtitle: 'Custom commissions in gold, silver, and natural stones in a Prague workshop. Every piece comes with a certificate of authenticity and a lifetime guarantee on the workmanship.',
      heroCtaPrimaryHref: '/en/custom-jewelry/',
      heroCtaPrimaryLabel: 'I want a piece made for me',
      heroCtaSecondaryHref: '/en/in-stock/',
      heroCtaSecondaryLabel: 'Finished pieces',
      heroStatus: 'Taking commissions',
      metaLocationLabel: 'Location',
      metaLocationValue: 'Prague 5, in-person meetings at the workshop',
      metaFocusLabel: 'Focus',
      metaFocusValue: 'Commissions / made by hand',
      metaExperienceLabel: 'Experience',
      metaExperienceValue: 'More than 20 years',
      heroImgAlt: 'Moldavite and rose-quartz pendant, custom commission',
      worksLabel: 'Selected works',
      worksHeading: "What's been made at the <em>Pod Kesnerkou</em> workshop",
      portfolioHref: '/en/portfolio/',
      worksViewLabel: 'View portfolio',
      worksCtaLabel: 'Full portfolio',
      philosophyLabel: 'Workshop philosophy',
      philosophyIntro: 'Approaching a piece of jewellery like architecture in miniature. Less is always more.',
      philosophyQuote: 'I believe in pieces that <em class="text-gold-deep">breathe</em>, a craft that strips away what\'s unnecessary and reveals the <em class="text-gold-deep">beauty</em> of the material.',
      philosophyPara1: "I've been working with gold and silver for more than twenty years. Every piece I make by hand, from the first sketch to the final polish. It isn't only a craft, it's the way I see the world.",
      philosophyPara2: "Every piece that leaves the workshop carries a bit of my story, and a lot of yours. That's why I don't rush and I don't compromise.",
      philosophyImgAlt: 'Close-up of polishing a piece at the workshop',
      plaque: 'Workshop on Pod Kesnerkou',
      principle1: 'Handmade, no compromise',
      principle2: 'I know where every stone comes from',
      principle3: 'Fewer details, more material',
      methodLabel: 'How I work',
      methodHeading: 'From idea to finished piece in <em>three</em> steps.',
      stockLabel: 'In stock',
      stockHeading: 'Finished pieces, <em>ready to take home</em>',
      stockHref: '/en/in-stock/',
      stockViewLabel: 'View stock',
      stockCtaLabel: 'Full stock',
    }
  : {
      title: 'Zlatnictví Praha 5, Smíchov | Zlatník Martin Ševr',
      description: 'Zlatnictví a zlatnická dílna v Praze 5 na Smíchově. Šperky na zakázku, snubní prsteny, opravy, ruční výroba ze zlata a stříbra. 20+ let praxe. Pod Kesnerkou 46.',
      heroLabel: 'Zlatnická dílna Praha, Pod Kesnerkou',
      h1Line1: 'Šperky vyrobené <em>ručně</em>.',
      h1Line2: 'Ne anonymně v sérii.',
      heroSubtitle: 'Zakázková tvorba ze zlata, stříbra a přírodních kamenů v pražské dílně. Každý kus s certifikátem pravosti a doživotní zárukou na zpracování.',
      heroCtaPrimaryHref: '/zakazkova-tvorba/',
      heroCtaPrimaryLabel: 'Chci šperk na míru',
      heroCtaSecondaryHref: '/skladem/',
      heroCtaSecondaryLabel: 'Hotové šperky',
      heroStatus: 'Přijímám zakázky',
      metaLocationLabel: 'Lokace',
      metaLocationValue: 'Praha 5, osobní setkání v dílně',
      metaFocusLabel: 'Zaměření',
      metaFocusValue: 'Zakázky / ruční výroba',
      metaExperienceLabel: 'Zkušenosti',
      metaExperienceValue: 'Více než 20 let',
      heroImgAlt: 'Přívěsek s vltavínem a růženínem, zakázková tvorba',
      worksLabel: 'Vybran&eacute; pr&aacute;ce',
      worksHeading: 'Co vzniklo v dílně <em>Pod Kesnerkou</em>',
      portfolioHref: '/portfolio/',
      worksViewLabel: 'Zobrazit portfolio',
      worksCtaLabel: 'Celé portfolio',
      philosophyLabel: 'Filozofie d&iacute;lny',
      philosophyIntro: 'Přístup ke šperku jako k architektuře v malém. Méně je vždy více.',
      philosophyQuote: 'Věřím ve šperky, které <em class="text-gold-deep">dýchají</em>: řemeslo, které odstraní zbytečné a odhalí <em class="text-gold-deep">krásu</em> materiálu.',
      philosophyPara1: 'Víc než dvacet let pracuji se zlatem a stříbrem. Každý šperk vyrábím ručně, od prvního náčrtu po finální lesk. Není to jen řemeslo, je to způsob, jakým vnímám svět.',
      philosophyPara2: 'Každý kus, který opustí dílnu, nese kousek mého příběhu a hodně toho vašeho. Proto nespěchám a nedělám kompromisy.',
      philosophyImgAlt: 'Detail broušení šperku v dílně',
      plaque: 'Dílna Pod Kesnerkou',
      principle1: 'Ruční práce bez kompromisů',
      principle2: 'Vím, odkud každý kámen pochází',
      principle3: 'Méně detailů, víc materiálu',
      methodLabel: 'Jak pracuji',
      methodHeading: 'Od nápadu ke šperku v <em>třech</em> krocích.',
      stockLabel: 'Skladem',
      stockHeading: 'Hotové šperky, <em>ihned k odnesení</em>',
      stockHref: '/skladem/',
      stockViewLabel: 'Zobrazit sklad',
      stockCtaLabel: 'Celý sklad',
    };

const jsonLd = homeGraph(locale);

const portfolioItems = portfolioCases.slice(0, 3).map((c, i) =>
  isEn
    ? {
        title: c.titleEn || c.title,
        tags: [c.materialEn || c.material],
        description: c.cardLeadEn || c.cardLead,
        href: `/en/work/${c.slugEn || c.slug}/`,
        label: `Story 0${i + 1}`,
        image: c.cardImage,
        image2x: c.cardImage2x,
        alt: c.cardAltEn || c.cardAlt,
      }
    : {
        title: c.title,
        tags: [c.material],
        description: c.cardLead,
        href: `/tvorba/${c.slug}/`,
        label: `Příběh 0${i + 1}`,
        image: c.cardImage,
        image2x: c.cardImage2x,
        alt: c.cardAlt,
      }
);

const skladem = products.slice(0, 3).map((p, i) => {
  // Hlavní cena = stříbro; u kusů jen ve zlatě zaujme hlavní slot zlato.
  // Stejné pravidlo jako v ProductCard.astro — bez něj se u goldOnly kusu
  // vypsalo `Stříbro · undefined`.
  const silver = isEn ? p.priceSilverEn || p.priceSilver : p.priceSilver;
  const gold = isEn ? p.priceGoldEn || p.priceGold : p.priceGold;
  const priceTag = silver
    ? `${isEn ? 'Silver' : 'Stříbro'} · ${silver}`
    : gold
      ? `${isEn ? 'Gold' : 'Zlato'} · ${gold}`
      : null;
  const material = isEn ? p.materialEn || p.material : p.material;
  const tags = priceTag ? [material, priceTag] : [material];

  return isEn
    ? {
        title: p.titleEn || p.title,
        tags,
        description: p.descriptionEn || p.description,
        href: `/en/jewelry/${p.slugEn || p.slug}/`,
        label: `In stock 0${i + 1}`,
        image: p.imageCard || p.image,
        image2x: p.imageCard || p.image,
        alt: p.altEn || p.alt,
      }
    : {
        title: p.title,
        tags,
        description: p.description,
        href: `/sperky/${p.slug}/`,
        label: `Skladem 0${i + 1}`,
        image: p.imageCard || p.image,
        image2x: p.imageCard || p.image,
        alt: p.alt,
      };
});

const processSteps = isEn
  ? [
      {
        number: '01',
        title: 'Consultation',
        description: 'We meet at the workshop or over the phone. We discuss your idea, materials, and budget. No obligation.',
        image: '/images/homepage--jak-pracuji-01--vykresy.webp',
        image2x: '/images/homepage--jak-pracuji-01--vykresy.webp',
        alt: 'Sketches and design for a piece, consultation at the workshop',
      },
      {
        number: '02',
        title: 'Made by hand',
        description: "I make every piece by hand, from the first sketch to the final polish. I photograph the process so you can see how it comes together.",
        image: '/images/homepage--jak-pracuji-02--snubaky-cerveny-hadr.webp',
        image2x: '/images/homepage--jak-pracuji-02--snubaky-cerveny-hadr.webp',
        alt: 'Wedding bands held on a red cloth, Pod Kesnerkou workshop',
      },
      {
        number: '03',
        title: 'Handover with certificate',
        description: "I hand the piece over in person at the workshop or send it as an insured parcel. Always with a certificate of authenticity.",
        image: '/images/homepage--jak-pracuji-03--predani-sperku.webp',
        image2x: '/images/homepage--jak-pracuji-03--predani-sperku.webp',
        alt: 'Handing over a finished piece with a certificate',
      },
    ]
  : [
      {
        number: '01',
        title: 'Konzultace',
        description: 'Sejdeme se v dílně nebo po telefonu. Probereme váš nápad, materiály a rozpočet. Bez závazků.',
        image: '/images/homepage--jak-pracuji-01--vykresy.webp',
        image2x: '/images/homepage--jak-pracuji-01--vykresy.webp',
        alt: 'Výkresy a návrh šperku, konzultace v dílně',
      },
      {
        number: '02',
        title: 'Ruční výroba',
        description: 'Každý šperk vyrábím ručně, od prvního náčrtu po finální lesk. Průběh fotím, abyste viděli, jak vzniká.',
        image: '/images/homepage--jak-pracuji-02--snubaky-cerveny-hadr.webp',
        image2x: '/images/homepage--jak-pracuji-02--snubaky-cerveny-hadr.webp',
        alt: 'Snubní prsteny v ruce na červeném hadříku, dílna Pod Kesnerkou',
      },
      {
        number: '03',
        title: 'Předání s certifikátem',
        description: 'Šperk předám osobně v dílně nebo zašlu pojištěnou zásilkou. Vždy s certifikátem pravosti.',
        image: '/images/homepage--jak-pracuji-03--predani-sperku.webp',
        image2x: '/images/homepage--jak-pracuji-03--predani-sperku.webp',
        alt: 'Předání hotového šperku s certifikátem',
      },
    ];
---

<Layout
  locale={locale}
  title={t.title}
  description={t.description}
  jsonLd={jsonLd}
  navOverlay
  lcpImageMobile="/images/homepage--hero--vltavin-privesek-mobile.avif"
  lcpImageMobile2x="/images/homepage--hero--vltavin-privesek-mobile@2x.avif"
  lcpImageDesktop="/images/homepage--hero--vltavin-privesek.avif"
  lcpImageDesktop2x="/images/homepage--hero--vltavin-privesek@2x.avif"
>

  <!-- ====== HERO ====== -->
  <section class="relative bg-bg-primary border-b border-border overflow-hidden">
    <div class="radial-overlay"></div>

    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14 relative">
      <div class="grid lg:grid-cols-2 gap-10 sm:gap-12 lg:gap-20 items-start lg:items-center min-h-[80vh] lg:min-h-dvh section-hero">

        <!-- Text -->
        <div class="hero-label">
          <span class="label-dot">{t.heroLabel}</span>

          <h1 class="mt-6 hero-headline">
            <span class="block" set:html={t.h1Line1} />
            <span class="block">{t.h1Line2}</span>
          </h1>

          <p class="subtitle mt-6 hero-copy">
            {t.heroSubtitle}
          </p>

          <div class="mt-10 flex flex-col sm:flex-row gap-4 hero-btn-group">
            <Button href={t.heroCtaPrimaryHref} variant="primary">{t.heroCtaPrimaryLabel}</Button>
            <Button href={t.heroCtaSecondaryHref} variant="secondary">{t.heroCtaSecondaryLabel}</Button>
          </div>

          <span class="hero-status mt-8 inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.2em] text-text-secondary font-sans font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-success pulse-dot"></span>
            {t.heroStatus}
          </span>

          <!-- Meta row — skryté na mobile (clean hero, info dostupné v JSON-LD + /o-dilne + footer) -->
          <div class="hidden sm:grid grid-cols-3 gap-4 sm:gap-6 mt-10 pt-6 border-t border-border hero-meta">
            <div>
              <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-text-muted font-sans">{t.metaLocationLabel}</span>
              <p class="text-[13px] sm:text-[14px] text-text-primary mt-1 font-sans leading-snug">{t.metaLocationValue}</p>
            </div>
            <div>
              <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-text-muted font-sans">{t.metaFocusLabel}</span>
              <p class="text-[13px] sm:text-[14px] text-text-primary mt-1 font-sans leading-snug">{t.metaFocusValue}</p>
            </div>
            <div>
              <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-text-muted font-sans">{t.metaExperienceLabel}</span>
              <p class="text-[13px] sm:text-[14px] text-text-primary mt-1 font-sans leading-snug">{t.metaExperienceValue}</p>
            </div>
          </div>
        </div>

        <!-- Photo — mobile/tablet vždy 4:3 (žádný horizontální ořez), desktop natural 4:3 -->
        <div class="relative hero-img-wrap lg:order-none w-full max-w-[440px] sm:max-w-[520px] md:max-w-[600px] mx-auto lg:max-w-none lg:mx-0 overflow-hidden">
          <picture>
            <source
              media="(min-width: 1024px)"
              type="image/avif"
              srcset="/images/homepage--hero--vltavin-privesek.avif 1x, /images/homepage--hero--vltavin-privesek@2x.avif 2x"
              width="1200" height="900"
            />
            <source
              media="(min-width: 1024px)"
              type="image/webp"
              srcset="/images/homepage--hero--vltavin-privesek.webp 1x, /images/homepage--hero--vltavin-privesek@2x.webp 2x"
              width="1200" height="900"
            />
            <source
              media="(max-width: 1023px)"
              type="image/avif"
              srcset="/images/homepage--hero--vltavin-privesek-mobile.avif 1x, /images/homepage--hero--vltavin-privesek-mobile@2x.avif 2x"
              width="800" height="600"
            />
            <source
              media="(max-width: 1023px)"
              type="image/webp"
              srcset="/images/homepage--hero--vltavin-privesek-mobile.webp 1x, /images/homepage--hero--vltavin-privesek-mobile@2x.webp 2x"
              width="800" height="600"
            />
            <img
              src="/images/homepage--hero--vltavin-privesek.webp"
              width="1200" height="900"
              alt={t.heroImgAlt}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="block w-full h-auto"
            />
          </picture>
          <PhotoFrame />
        </div>

      </div>
    </div>
  </section>

  <!-- ====== SELECTED WORKS — Vertical list ====== -->
  <section class="bg-bg-primary border-b border-border section-lg">
    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">

      <!-- Header -->
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-14">
        <div>
          <span class="label-dot" data-anim="fade" set:html={t.worksLabel} />
          <h2 class="mt-5" data-anim="stagger" set:html={t.worksHeading} />
        </div>
        <div data-anim="up">
          <Button href={t.portfolioHref} variant="text">{t.worksViewLabel}</Button>
        </div>
      </div>

      <!-- Vertical list -->
      <div class="flex flex-col">
        {portfolioItems.map((item) => (
          <PortfolioListCard
            locale={locale}
            href={item.href}
            image={item.image}
            image2x={item.image2x}
            alt={item.alt}
            label={item.label}
            title={item.title}
            description={item.description}
            tags={item.tags}
            imageRatio="wide"
            showCta
            prominentTitle
          />
        ))}
        <div class="border-t border-border"></div>
      </div>

      <!-- CTA button -->
      <div class="mt-12 text-center" data-anim="up">
        <Button href={t.portfolioHref} variant="secondary">{t.worksCtaLabel}</Button>
      </div>

    </div>
  </section>


  <!-- ====== PHILOSOPHY — bg-secondary with left rail ====== -->
  <section class="relative bg-bg-primary border-b border-border section-lg overflow-hidden">
    <div class="radial-overlay"></div>

    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14 relative">
      <div class="grid lg:grid-cols-[0.34fr_1fr] gap-12 lg:gap-16">

        <!-- Left rail -->
        <div class="lg:border-r lg:border-border lg:pr-10">
          <div class="lg:sticky lg:top-32">
            <h2 class="sr-only" set:html={t.philosophyLabel} />
            <span class="label-dot" data-anim="fade" set:html={t.philosophyLabel} />
            <p class="body-md text-text-secondary leading-relaxed mt-5 max-w-[260px] font-sans">
              {t.philosophyIntro}
            </p>
          </div>
        </div>

        <!-- Right content -->
        <div>
          <!-- Large italic heading -->
          <p class="font-serif italic display-quote-lg text-text-primary font-normal max-w-3xl" data-anim="up" set:html={t.philosophyQuote} />

          <!-- Split: copy + image -->
          <div class="grid md:grid-cols-2 gap-10 mt-14">
            <div data-anim="up">
              <p class="text-text-secondary body-lg font-sans">
                {t.philosophyPara1}
              </p>
              <p class="text-text-secondary body-lg mt-4 font-sans">
                {t.philosophyPara2}
              </p>
            </div>
            <div class="relative overflow-hidden" data-anim="up">
              <picture>
                <source
                  type="image/avif"
                  srcset="/images/homepage--o-dilne-preview--ruce-bruseni.avif 1x, /images/homepage--o-dilne-preview--ruce-bruseni@2x.avif 2x"
                />
                <img
                  src="/images/homepage--o-dilne-preview--ruce-bruseni.webp"
                  srcset="/images/homepage--o-dilne-preview--ruce-bruseni.webp 1x, /images/homepage--o-dilne-preview--ruce-bruseni@2x.webp 2x"
                  width="800" height="600"
                  alt={t.philosophyImgAlt}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover grayscale-[15%] sepia-[10%]"
                />
              </picture>
              <PhotoFrame />
              <!-- Plaque -->
              <div class="absolute bottom-4 left-4 bg-bg-primary/90 backdrop-blur-md px-4 py-2.5 shadow-soft">
                <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-gold-on-light font-sans">{t.plaque}</span>
              </div>
            </div>
          </div>

          <!-- 3 Principles -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-14" data-anim="stagger">
            <div class="border-t border-border pt-5">
              <span class="text-[12px] text-text-muted font-sans">01</span>
              <p class="mt-2 body-md font-medium text-text-primary font-sans">{t.principle1}</p>
            </div>
            <div class="border-t border-border pt-5">
              <span class="text-[12px] text-text-muted font-sans">02</span>
              <p class="mt-2 body-md font-medium text-text-primary font-sans">{t.principle2}</p>
            </div>
            <div class="border-t border-border pt-5">
              <span class="text-[12px] text-text-muted font-sans">03</span>
              <p class="mt-2 body-md font-medium text-text-primary font-sans">{t.principle3}</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- ====== METHODOLOGY — 3 cards ====== -->
  <section class="bg-bg-primary border-b border-border section-lg">
    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">

      <!-- Header -->
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-14">
        <div>
          <span class="label-dot" data-anim="fade">{t.methodLabel}</span>
          <h2 class="mt-5" data-anim="stagger" set:html={t.methodHeading} />
        </div>
      </div>

      <!-- 3 Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10" data-anim="stagger">
        {processSteps.map((step) => (
          <div data-anim-child class="group h-full flex flex-col border-b border-border">
            <!-- Card photo with icon overlay -->
            <div class="relative aspect-[4/3] overflow-hidden">
              <picture>
                {step.image.endsWith('.webp') && step.image2x.endsWith('.webp') && (
                  <source
                    type="image/avif"
                    srcset={`${step.image.replace(/\.webp$/, '.avif')} 1x, ${step.image2x.replace(/\.webp$/, '.avif')} 2x`}
                  />
                )}
                <img
                  src={step.image}
                  srcset={`${step.image} 1x, ${step.image2x} 2x`}
                  width="800" height="600"
                  alt={step.alt}
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 w-full h-full object-cover grayscale-[15%] sepia-[10%]"
                />
              </picture>
              <!-- Gradient -->
              <div class="absolute inset-0 bg-gradient-to-t from-text-primary/25 via-transparent to-transparent pointer-events-none"></div>
              <!-- Number circle overlay -->
              <div class="absolute top-4 left-4 h-11 w-11 rounded-full border border-white/60 bg-button-text/85 backdrop-blur-sm flex items-center justify-center text-gold-deep text-[11px] font-medium uppercase tracking-[0.15em] font-sans shadow-plaque">
                {step.number}
              </div>
            </div>
            <!-- Info below -->
            <div class="pt-5 pb-5 flex-1">
              <h3>{step.title}</h3>
              <p class="body-md text-text-secondary leading-relaxed mt-2 font-sans">
                {step.description}
              </p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ====== SKLADEM — Vertical list (stejný vzhled jako Selected Works) ====== -->
  <section class="bg-bg-primary border-b border-border section-lg">
    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">

      <!-- Header -->
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-14">
        <div>
          <span class="label-dot" data-anim="fade">{t.stockLabel}</span>
          <h2 class="mt-5" data-anim="stagger" set:html={t.stockHeading} />
        </div>
        <div data-anim="up">
          <Button href={t.stockHref} variant="text">{t.stockViewLabel}</Button>
        </div>
      </div>

      <!-- Vertical list -->
      <div class="flex flex-col">
        {skladem.map((item) => (
          <PortfolioListCard
            locale={locale}
            href={item.href}
            image={item.image}
            image2x={item.image2x}
            alt={item.alt}
            label={item.label}
            title={item.title}
            description={item.description}
            tags={item.tags}
            imageRatio="wide"
            showCta
            prominentTitle
          />
        ))}
        <div class="border-t border-border"></div>
      </div>

      <!-- CTA button -->
      <div class="mt-12 text-center" data-anim="up">
        <Button href={t.stockHref} variant="secondary">{t.stockCtaLabel}</Button>
      </div>

    </div>
  </section>

</Layout>
