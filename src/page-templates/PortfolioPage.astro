---
/**
 * Sdílená šablona stránky Portfolio (CS /portfolio/ + EN /en/portfolio/).
 * Route soubory v src/pages/ jsou tenké wrappery — veškerá struktura žije tady,
 * texty v lokálním slovníku `t`. Vzor: ContactPage.astro.
 */
import Layout from '../layouts/Layout.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import { portfolioCases } from '../data/portfolio';
import { graph, portfolioItemList, breadcrumbSchema } from '../lib/seo';
import { materialTags } from '../lib/text';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const isEn = locale === 'en';

const t = isEn
  ? {
      title: 'Portfolio | Martin Ševr, Goldsmith workshop in Prague',
      description: "Four stories from Martin Ševr's workshop, from signature pieces through wedding and engagement rings to personalised commissions. Each piece has its own path.",
      ctaHeading: "Like what you see? <em>I'll make you something similar.</em>",
      ctaSubtitle: "Tell me what caught your eye. I'll take it as inspiration and craft a piece that's just for you. Consultation is free.",
      ctaPrimaryLabel: 'Book a consultation',
      ctaPrimaryHref: '/en/contact/',
      breadcrumb: [
        { name: 'Home', url: '/en/' },
        { name: 'Portfolio', url: '/en/portfolio/' },
      ],
      categoryTypeLabels: {
        'autorska-tvorba': 'Signature piece',
        'snubni-prsteny': 'Wedding bands',
        'zasnubni-prsteny': 'Engagement',
        'personalizovane': 'Commission',
      } as Record<string, string>,
      categoryFallback: 'Commission',
      heroHeading: "What's been made in the workshop: selected",
      heroHeadingEm: 'commissions',
      heroLead: "Wedding bands, engagement rings, signature pieces. For each one you'll find the materials, the process, and the client's story. If something catches your eye, we can use it as inspiration for your own commission.",
      caseLabel: 'Commission',
      details: 'Details',
      galleryLabel: 'From the workshop',
      galleryHeadingPre: 'A few more pieces from the',
      galleryHeadingEm: 'bench',
      galleryLead: 'Not for sale, but I will gladly make you something similar to order.',
    }
  : {
      title: 'Portfolio realizací | Snubní prsteny a autorské šperky na zakázku Praha',
      description: 'Příběhy z dílny Martina Ševra: snubní a zásnubní prsteny na míru, autorská tvorba, personalizované kusy. Realizace zakázek v Praze.',
      ctaHeading: 'Líbí se vám něco? <em>Vyrobím vám podobné.</em>',
      ctaSubtitle: 'Vezmu si vaši inspiraci a vyrobím šperk, který bude jen váš. Konzultace v dílně je zdarma.',
      ctaPrimaryLabel: 'Domluvit konzultaci',
      ctaPrimaryHref: '/kontakt/',
      breadcrumb: [
        { name: 'Domů', url: '/' },
        { name: 'Portfolio', url: '/portfolio/' },
      ],
      categoryTypeLabels: {
        'autorska-tvorba': 'Autorský kus',
        'snubni-prsteny': 'Snubní pár',
        'zasnubni-prsteny': 'Zásnubní',
        'personalizovane': 'Zakázka',
      } as Record<string, string>,
      categoryFallback: 'Zakázka',
      heroHeading: 'Co vzniklo v dílně: výběr',
      heroHeadingEm: 'zakázek',
      heroLead: 'Snubáky, zásnubní prsteny, autorské kusy. U každého najdete materiál, postup výroby a příběh klienta. Pokud vás něco zaujme, můžeme se inspirovat při vaší zakázce.',
      caseLabel: 'Zakázka',
      details: 'Podrobnosti',
      galleryLabel: 'Z dílny',
      galleryHeadingPre: 'Ještě pár kusů z',
      galleryHeadingEm: 'dílny',
      galleryLead: 'Nejsou na prodej, ale rád vám podle nich vyrobím na míru něco vašeho.',
    };

const galleryItems = isEn
  ? [
      { title: 'Acorn pendant', base: 'portfolio--ukazka-zalud', alt: 'Gold acorn pendant on a chain' },
      { title: 'Pisces pendant', base: 'portfolio--ukazka-ryby', alt: 'Two-tone gold Pisces zodiac pendant with two fish' },
      { title: 'Bar pendant', base: 'portfolio--ukazka-tycka', alt: 'White gold vertical bar pendant on a chain' },
    ]
  : [
      { title: 'Přívěsek žalud', base: 'portfolio--ukazka-zalud', alt: 'Zlatý přívěsek ve tvaru žaludu na řetízku' },
      { title: 'Přívěsek Ryby', base: 'portfolio--ukazka-ryby', alt: 'Dvoubarevný zlatý přívěsek znamení Ryby se dvěma rybami' },
      { title: 'Přívěsek tyčka', base: 'portfolio--ukazka-tycka', alt: 'Přívěsek z bílého zlata ve tvaru svislé tyčky na řetízku' },
    ];

const jsonLd = graph(
  portfolioItemList(portfolioCases),
  breadcrumbSchema(t.breadcrumb),
);
---

<Layout
  locale={locale}
  title={t.title}
  ogImage="/images/og/og-portfolio.jpg"
  description={t.description}
  jsonLd={jsonLd}
  navOverlay
  ctaHeading={t.ctaHeading}
  ctaSubtitle={t.ctaSubtitle}
  ctaPrimaryLabel={t.ctaPrimaryLabel}
  ctaPrimaryHref={t.ctaPrimaryHref}
>

  <!-- ====== HERO ====== -->
  <section class="relative bg-bg-primary border-b border-border section-hero overflow-hidden">
    <div class="radial-overlay"></div>
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <div class="max-w-3xl" data-anim="up">
        <span class="label-dot">Portfolio</span>
        <h1 class="mt-6">{t.heroHeading} <em>{t.heroHeadingEm}</em></h1>
        <p class="mt-6 text-text-secondary body-lg max-w-xl">
          {t.heroLead}
        </p>
      </div>
    </div>
  </section>

  <!-- ====== CASES — Vertical list (foto vlevo, info vpravo) ====== -->
  <section class="relative bg-bg-primary section-md overflow-hidden">
    <div class="radial-overlay"></div>
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">

      <div class="flex flex-col">
        {portfolioCases.map((c, i) => {
          const num = String(i + 1).padStart(2, '0');
          const materialForTags = isEn ? (c.materialEn || c.material) : c.material;
          const tags = [...materialTags(materialForTags), t.categoryTypeLabels[c.category] || t.categoryFallback];
          const href = isEn ? `/en/work/${c.slugEn || c.slug}/` : `/tvorba/${c.slug}/`;
          const cardTitle = isEn ? (c.titleEn || c.title) : c.title;
          const cardLead = isEn ? (c.cardLeadEn || c.cardLead) : c.cardLead;
          const cardAlt = isEn ? (c.cardAltEn || c.cardAlt) : c.cardAlt;
          return (
            <a href={href}
               class="group relative block border-t border-border py-10 md:py-14"
               data-anim="up">
              <div class="grid grid-cols-1 md:grid-cols-[0.35fr_1fr] gap-8 md:gap-12 lg:gap-16 items-center">

                <!-- Photo -->
                <div class="relative aspect-[3/2] overflow-hidden">
                  <picture>
                    {c.cardImage.endsWith('.webp') && c.cardImage2x.endsWith('.webp') && (
                      <source
                        type="image/avif"
                        srcset={`${c.cardImage.replace(/\.webp$/, '.avif')} 1x, ${c.cardImage2x.replace(/\.webp$/, '.avif')} 2x`}
                        sizes="(min-width: 768px) 30vw, 100vw"
                      />
                    )}
                    <img
                      src={c.cardImage}
                      srcset={`${c.cardImage} 1x, ${c.cardImage2x} 2x`}
                      width="800" height="600"
                      sizes="(min-width: 768px) 30vw, 100vw"
                      alt={cardAlt}
                      loading={i < 2 ? 'eager' : 'lazy'}
                      decoding="async"
                      class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700"
                    />
                  </picture>
                  <PhotoFrame />
                  <div class="absolute bottom-4 left-4 bg-bg-primary/90 backdrop-blur-md px-4 py-2.5 shadow-soft">
                    <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-gold-on-light font-sans">{`${t.caseLabel} ${num}`}</span>
                  </div>
                </div>

                <!-- Info -->
                <div class="pr-14 md:pr-16">
                  <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-gold-on-light font-sans">{`${t.caseLabel} ${num}`}</span>
                  <h2 class="mt-2 card-title group-hover:text-gold-deep transition-colors duration-300">{cardTitle}</h2>
                  <p class="body-md text-text-secondary leading-relaxed mt-3 max-w-xl font-sans">{cardLead}</p>
                  <div class="flex flex-wrap gap-3 mt-5">
                    {tags.map((tag) => (
                      <span class="text-[11px] uppercase tracking-[0.15em] text-text-muted font-sans border border-border px-3 py-1.5">{tag}</span>
                    ))}
                  </div>
                  <div class="mt-6">
                    <span class="text-[clamp(0.6875rem,0.6rem+0.15vw,0.8125rem)] text-text-secondary uppercase tracking-[0.2em] font-sans font-medium group-hover:text-gold-deep transition-colors duration-300 inline-flex items-center gap-2">
                      {t.details}
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" /></svg>
                    </span>
                  </div>
                </div>

              </div>

              <!-- Arrow in top-right corner -->
              <div class="hidden md:flex absolute top-10 md:top-14 right-0 h-10 w-10 rounded-full border border-border items-center justify-center group-hover:bg-text-primary group-hover:border-text-primary transition-colors duration-300">
                <svg class="w-4 h-4 text-text-primary group-hover:text-white transition-colors duration-300" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" /></svg>
              </div>
            </a>
          );
        })}
        <div class="border-t border-border"></div>
      </div>

    </div>
  </section>

  <!-- ====== GALERIE UKÁZEK / SHOWCASE ====== -->
  <section class="relative bg-bg-primary border-t border-border section-md overflow-hidden">
    <div class="radial-overlay"></div>
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <div class="max-w-3xl mb-14" data-anim="up">
        <span class="label-dot">{t.galleryLabel}</span>
        <h2 class="mt-5">{t.galleryHeadingPre} <em>{t.galleryHeadingEm}</em></h2>
        <p class="mt-6 body-md text-text-secondary leading-relaxed font-sans max-w-2xl">{t.galleryLead}</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-6 lg:gap-8" data-anim="stagger">
        {galleryItems.map((item) => (
          <div data-anim-child>
            <div class="border border-border aspect-square overflow-hidden flex items-center justify-center p-5 bg-bg-primary">
              <picture>
                <source
                  type="image/avif"
                  srcset={`/images/${item.base}.avif 1x, /images/${item.base}@2x.avif 2x`}
                  sizes="(min-width: 768px) 30vw, 45vw"
                />
                <img
                  src={`/images/${item.base}.webp`}
                  srcset={`/images/${item.base}.webp 1x, /images/${item.base}@2x.webp 2x`}
                  width="700" height="700"
                  sizes="(min-width: 768px) 30vw, 45vw"
                  alt={item.alt}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-contain"
                />
              </picture>
            </div>
            <p class="mt-3 body-md text-text-secondary font-sans">{item.title}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>
