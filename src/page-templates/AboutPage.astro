---
/**
 * Sdílená šablona stránky O dílně (CS /o-dilne/ + EN /en/about/).
 * Route soubory v src/pages/ jsou tenké wrappery — veškerá struktura žije tady,
 * texty v lokálním slovníku `t`.
 */
import Layout from '../layouts/Layout.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import { graph, aboutPageSchema, personSchema, jewelryStoreSchema, breadcrumbSchema } from '../lib/seo';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const isEn = locale === 'en';

const t = isEn
  ? {
      title: 'About | Martin Ševr — Goldsmith workshop in Prague',
      description: 'Over twenty years of handcrafted work in gold and silver. The story of a goldsmith workshop in Prague.',
      ctaHeading: 'Drop by the <em>workshop</em>.',
      ctaSubtitle: "Pod Kesnerkou 46, Prague 5. Just call ahead — I'll happily open up and show you how the jewellery is made.",
      breadcrumb: [
        { name: 'Home', url: '/en/' },
        { name: 'About', url: '/en/about/' },
      ],
      heroLabel: 'Workshop on Pod Kesnerkou',
      heroEm: '20+ years',
      heroRest: 'in the workshop on Pod Kesnerkou. Your piece will be made here too.',
      heroText: "More than twenty years of handcrafted work in gold and silver. Every piece is an original, made with respect for the material and for the person who'll wear it.",
      portraitAlt: 'Martin Ševr in the goldsmith workshop',
      portraitBadge: 'Workshop on Pod Kesnerkou',
      storyLabel: 'Story',
      storyH2a: "Goldsmithing isn't",
      storyH2b: 'just',
      storyH2em: 'work',
      storyQuote: '"Every piece that leaves the workshop carries a bit of my story — and a lot of yours."',
      storyP1: "I've been working with gold and silver for more than twenty years. Every piece I make by hand — from the first sketch to the final polish. It isn't only a craft, it's the way I see the world.",
      storyP2: "That's why I don't rush and I don't compromise. I'd rather turn a commission down than hand over something I don't fully stand behind.",
      stat1Label: 'Years of experience',
      stat2Label: 'Pieces made',
      stat3Label: 'By hand',
      philLabel: 'Workshop philosophy',
      philHeading: 'Four principles I',
      philHeadingEm: 'work by',
      philQ1: '"I believe in pieces that ',
      philQGold1: 'breathe',
      philQ2: " — a craft that strips away what's unnecessary and reveals the ",
      philQGold2: 'beauty',
      philQ3: ' of the material."',
      principles: [
        { num: '01', title: 'Handmade, no compromise', text: 'Every piece I make from start to finish with my own hands. No production line.' },
        { num: '02', title: 'I know where every stone comes from', text: "Certified metals, hand-picked stones. I know where every material comes from and why I'm using it." },
        { num: '03', title: 'Fewer details, more material', text: 'I believe the most beautiful pieces are the ones where every detail has a reason. Restraint over excess.' },
        { num: '04', title: 'Old crafts, new forms', text: 'Wax models, forging, hand finishing. Techniques that have worked for centuries, used for pieces that fit today.' },
      ],
      galleryLabel: 'Workshop on Pod Kesnerkou',
      g1Alt: 'Handcrafting a chain at the bench',
      g2Alt: 'Gold signet seal — close-up',
      g3Alt: 'Wedding bands on a wooden bench',
      certLabel: 'Certificates',
      certHeading: 'Hallmarked and certified',
      certAlt: 'Czech hallmarks — metal quality certification',
      certP1: 'All my pieces are made from certified materials and stamped with the Czech state hallmark. I work in line with Czech precious-metal regulations.',
      certP2: 'Every piece comes with a certificate of authenticity. Stones are supplied with a gemmological report.',
    }
  : {
      title: 'O zlatnické dílně Praha 5 | Martin Ševr, zlatník s 20+ lety praxe',
      description: 'Zlatnická dílna v Praze 5, Pod Kesnerkou 46. Martin Ševr — zlatník s 20+ lety praxe v ruční výrobě šperků ze zlata a stříbra. Příběh dílny a certifikáty.',
      ctaHeading: 'Pojďte se zastavit do <em>dílny</em>.',
      ctaSubtitle: 'Pod Kesnerkou 46, Praha 5. Stačí předem zavolat — rád vám otevřu a ukážu, jak šperky vznikají.',
      breadcrumb: [
        { name: 'Domů', url: '/' },
        { name: 'O dílně', url: '/o-dilne/' },
      ],
      heroLabel: 'Dílna Pod Kesnerkou',
      heroEm: '20+ let',
      heroRest: 'v dílně Pod Kesnerkou. Tady vznikne i váš šperk.',
      heroText: 'Víc než dvacet let ruční práce se zlatem a stříbrem. Každý šperk je originál, vyrobený s úctou k materiálu a k člověku, který ho bude nosit.',
      portraitAlt: 'Martin Ševr v zlatnické dílně',
      portraitBadge: 'Dílna Pod Kesnerkou',
      storyLabel: 'Příběh',
      storyH2a: 'Zlatnictví není',
      storyH2b: 'jen',
      storyH2em: 'práce',
      storyQuote: '„Každý kus, který opustí dílnu, nese kousek mého příběhu a hodně toho vašeho."',
      storyP1: 'Víc než dvacet let pracuji se zlatem a stříbrem. Každý šperk vyrábím ručně — od prvního náčrtu po finální lesk. Není to jen řemeslo, je to způsob, jakým vnímám svět.',
      storyP2: 'Proto nespěchám a nedělám kompromisy. Raději odmítnu zakázku, než abych odevzdal něco, za čím si nestojím.',
      stat1Label: 'Let zkušeností',
      stat2Label: 'Výrobků',
      stat3Label: 'Ruční práce',
      philLabel: 'Filozofie dílny',
      philHeading: 'Tři pravidla, kterými se v dílně',
      philHeadingEm: 'řídím',
      philQ1: '„Věřím ve šperky, které ',
      philQGold1: 'dýchají',
      philQ2: ' — řemeslo, které odstraní zbytečné a odhalí ',
      philQGold2: 'krásu',
      philQ3: ' materiálu."',
      principles: [
        { num: '01', title: 'Ruční práce bez kompromisů', text: 'Každý šperk vyrábím od začátku do konce vlastníma rukama. Žádná sériová výroba.' },
        { num: '02', title: 'Vím, odkud každý kámen pochází', text: 'Certifikované kovy, ručně vybrané kameny. Vím, odkud každý materiál přichází a proč ho používám.' },
        { num: '03', title: 'Méně detailů, víc materiálu', text: 'Věřím, že nejkrásnější šperky jsou ty, kde každý detail má svůj důvod. Zdrženlivost místo přebytku.' },
        { num: '04', title: 'Stará řemesla, nové tvary', text: 'Voskové modely, kování, ruční zpracování. Postupy, které fungují stovky let, použité na šperky, které sedí dnešní době.' },
      ],
      galleryLabel: 'Dílna Pod Kesnerkou',
      g1Alt: 'Ruční výroba řetízku v dílně',
      g2Alt: 'Zlatá erbovní pečeť — detail',
      g3Alt: 'Snubní prsteny na dřevěném stole',
      certLabel: 'Certifikáty',
      certHeading: 'Puncované a certifikované',
      certAlt: 'České puncovní značky — certifikát kvality kovů',
      certP1: 'Všechny moje šperky jsou vyrobeny z certifikovaných materiálů a opatřeny státním puncem. Pracuji v souladu s českou legislativou.',
      certP2: 'Každý kus doprovázím certifikátem pravosti. Kameny dodávám s gemologickým posudkem.',
    };

const jsonLd = graph(
  aboutPageSchema(),
  personSchema(),
  jewelryStoreSchema(),
  breadcrumbSchema(t.breadcrumb),
);
---

<Layout
  locale={locale}
  title={t.title}
  ogImage="/images/og/og-o-dilne.jpg"
  description={t.description}
  jsonLd={jsonLd}
  navOverlay
  ctaHeading={t.ctaHeading}
  ctaSubtitle={t.ctaSubtitle}
>

  <!-- ====== HERO ====== -->
  <section class="relative bg-bg-primary border-b border-border section-hero overflow-hidden">
    <div class="radial-overlay"></div>
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <div class="max-w-3xl" data-anim="up">
        <span class="label-dot">{t.heroLabel}</span>
        <h1 class="mt-6">
          <em>{t.heroEm}</em> {t.heroRest}
        </h1>
        <p class="mt-6 text-text-secondary body-lg max-w-xl">
          {t.heroText}
        </p>
      </div>
    </div>
  </section>

  <!-- ====== PORTRAIT + STORY — dramatic asymmetric ====== -->
  <section class="relative bg-bg-primary border-b border-border section-md">
    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <div class="grid lg:grid-cols-[1.15fr_0.85fr] gap-10 lg:gap-16 items-start">

        <!-- Photo — tall, dramatic (původní layout) -->
        <div data-anim="scale" class="relative overflow-hidden">
          <div class="aspect-[3/4] relative overflow-hidden">
            <img
              src="/images/o-dilne--portret--martin-sevr-zlatnik.webp"
              srcset="/images/o-dilne--portret--martin-sevr-zlatnik.webp 1x, /images/o-dilne--portret--martin-sevr-zlatnik@2x.webp 2x"
              width="900" height="1200"
              alt={t.portraitAlt}
              loading="lazy" decoding="async"
              class="absolute inset-0 w-full h-full object-cover"
            />
            <div class="absolute inset-3 border border-white/15 pointer-events-none"></div>
            <div class="absolute bottom-6 left-6 bg-bg-primary/90 backdrop-blur-md px-5 py-3 shadow-soft">
              <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-gold-on-light font-sans">{t.portraitBadge}</span>
            </div>
          </div>
        </div>

        <!-- Text — sticky on scroll -->
        <div class="lg:sticky lg:top-28 lg:self-start" data-anim="up">
          <span class="label-dot">{t.storyLabel}</span>
          <h2 class="mt-5">{t.storyH2a}<br />{t.storyH2b} <em>{t.storyH2em}</em></h2>

          <blockquote class="mt-8 pt-8 border-t border-border">
            <p class="font-serif italic display-quote text-text-primary">
              {t.storyQuote}
            </p>
          </blockquote>

          <div class="mt-8 space-y-4">
            <p class="text-text-secondary body-md leading-[1.8]">
              {t.storyP1}
            </p>
            <p class="text-text-secondary body-md leading-[1.8]">
              {t.storyP2}
            </p>
          </div>

          <div class="grid grid-cols-3 gap-6 mt-10 pt-8 border-t border-border">
            <div>
              <span class="block font-serif stat-number text-text-primary">20+</span>
              <span class="text-[12px] text-text-muted uppercase tracking-[0.15em] font-sans mt-1 block">{t.stat1Label}</span>
            </div>
            <div>
              <span class="block font-serif stat-number text-text-primary">1000+</span>
              <span class="text-[12px] text-text-muted uppercase tracking-[0.15em] font-sans mt-1 block">{t.stat2Label}</span>
            </div>
            <div>
              <span class="block font-serif stat-number text-text-primary">100%</span>
              <span class="text-[12px] text-text-muted uppercase tracking-[0.15em] font-sans mt-1 block">{t.stat3Label}</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ====== FILOZOFIE — velký italic heading + 3 principy ====== -->
  <section class="relative bg-bg-primary border-b border-border section-md overflow-hidden">
    <div class="radial-overlay"></div>
    <div class="relative max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">

      <span class="label-dot" data-anim="fade">{t.philLabel}</span>
      <h2 class="mt-5 max-w-3xl" data-anim="up">{t.philHeading} <em>{t.philHeadingEm}</em></h2>

      <blockquote class="mt-10 max-w-4xl" data-anim="up">
        <p class="font-serif italic display-quote text-text-primary font-normal">
          {t.philQ1}<span class="not-italic text-gold-deep">{t.philQGold1}</span>{t.philQ2}<span class="not-italic text-gold-deep">{t.philQGold2}</span>{t.philQ3}
        </p>
      </blockquote>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 mt-16" data-anim="stagger">
        {t.principles.map((principle) => (
          <div data-anim-child class="pt-6 border-t border-border">
            <span class="text-[12px] text-text-muted font-sans">{principle.num}</span>
            <h3 class="mt-2">{principle.title}</h3>
            <p class="mt-2 text-text-secondary body-md leading-relaxed">{principle.text}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ====== GALERIE — 3 fotky, vyšší ====== -->
  <section class="relative bg-bg-primary border-b border-border section-md overflow-hidden">
    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <span class="label-dot mb-10 block" data-anim="fade">{t.galleryLabel}</span>
      <div class="grid md:grid-cols-3 gap-4 lg:gap-6" data-anim="stagger">
        <div data-anim-child class="relative overflow-hidden">
          <img
            src="/images/o-dilne--galerie-1--ruka-retizek-stroj.webp"
            srcset="/images/o-dilne--galerie-1--ruka-retizek-stroj.webp 1x, /images/o-dilne--galerie-1--ruka-retizek-stroj@2x.webp 2x"
            width="800" height="1000" alt={t.g1Alt} loading="lazy" decoding="async"
            class="w-full aspect-[4/5] object-cover grayscale-[15%] sepia-[10%]"
          />
          <PhotoFrame />
        </div>
        <div data-anim-child class="relative overflow-hidden">
          <img
            src="/images/o-dilne--galerie-2--erbovni-pecet-zlato.webp"
            srcset="/images/o-dilne--galerie-2--erbovni-pecet-zlato.webp 1x, /images/o-dilne--galerie-2--erbovni-pecet-zlato@2x.webp 2x"
            width="800" height="1000" alt={t.g2Alt} loading="lazy" decoding="async"
            class="w-full aspect-[4/5] object-cover grayscale-[15%] sepia-[10%]"
          />
          <PhotoFrame />
        </div>
        <div data-anim-child class="relative overflow-hidden">
          <img
            src="/images/o-dilne--galerie-3--snubaky-na-dreve-stul.webp"
            srcset="/images/o-dilne--galerie-3--snubaky-na-dreve-stul.webp 1x, /images/o-dilne--galerie-3--snubaky-na-dreve-stul@2x.webp 2x"
            width="800" height="1000" alt={t.g3Alt} loading="lazy" decoding="async"
            class="w-full aspect-[4/5] object-cover grayscale-[15%] sepia-[10%]"
          />
          <PhotoFrame />
        </div>
      </div>
    </div>
  </section>

  <!-- ====== CERTIFIKÁTY — puncovní certifikát vlevo, text vpravo (stejný layout jako Martin portrait) ====== -->
  <section class="relative bg-bg-primary section-md">
    <div class="max-w-[1400px] mx-auto px-6 sm:px-8 lg:px-14">
      <div class="grid lg:grid-cols-[1.15fr_0.85fr] gap-10 lg:gap-16 items-start">
        <div data-anim="scale" class="relative overflow-hidden">
          <div class="aspect-[3/4] relative overflow-hidden">
            <img
              src="/images/o-dilne--certifikaty--puncak-martin-sevr.webp"
              srcset="/images/o-dilne--certifikaty--puncak-martin-sevr.webp 1x, /images/o-dilne--certifikaty--puncak-martin-sevr@2x.webp 2x"
              width="900" height="1200"
              alt={t.certAlt}
              loading="lazy" decoding="async"
              class="absolute inset-0 w-full h-full object-cover"
            />
            <div class="absolute inset-3 border border-white/15 pointer-events-none"></div>
          </div>
        </div>
        <div class="lg:sticky lg:top-28 lg:self-start" data-anim="up">
          <span class="label-dot">{t.certLabel}</span>
          <h2 class="mt-5">{t.certHeading}</h2>
          <p class="mt-4 text-text-secondary body-lg">
            {t.certP1}
          </p>
          <p class="mt-4 text-text-secondary body-lg">
            {t.certP2}
          </p>
        </div>
      </div>
    </div>
  </section>

</Layout>
