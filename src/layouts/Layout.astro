---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { getLocaleFromUrl, getAlternatePathStrict, useTranslations, type Locale } from '../i18n';
import { products } from '../data/products';
import { portfolioCases } from '../data/portfolio';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  canonical?: string;
  jsonLd?: object;
  /** `true` = nav pluje nad první sekcí (bez 96px spaceru). První sekce si musí zajistit vlastní padding-top. */
  navOverlay?: boolean;
  /** LCP image preload hints — výrazně zlepší PageSpeed LCP. */
  lcpImageMobile?: string;
  lcpImageMobile2x?: string;
  lcpImageDesktop?: string;
  lcpImageDesktop2x?: string;
  /** Per-page footer CTA heading (HTML přes set:html). Default = homepage CTA. */
  ctaHeading?: string;
  /** Per-page subtitle pod nadpisem (plain text, 1–2 věty). */
  ctaSubtitle?: string;
  ctaPrimaryLabel?: string;
  ctaPrimaryHref?: string;
  /** Explicit locale override — jinak se detekuje z URL. */
  locale?: Locale;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogImage = '/images/og-default.jpg',
  canonical,
  jsonLd,
  navOverlay = false,
  lcpImageMobile,
  lcpImageMobile2x,
  lcpImageDesktop,
  lcpImageDesktop2x,
  ctaHeading,
  ctaSubtitle,
  ctaPrimaryLabel,
  ctaPrimaryHref,
  locale,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://www.zlatnik-martin.cz';
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).toString();

const currentLocale: Locale = locale ?? getLocaleFromUrl(Astro.url);
const t = useTranslations(currentLocale);

// Slug mapy pro hreflang alternates u detailových stránek.
const productSlugMap = new Map<string, string>();
for (const p of products) {
  if (p.slugEn) {
    productSlugMap.set(p.slug, p.slugEn);
    productSlugMap.set(p.slugEn, p.slug);
  }
}
const portfolioSlugMap = new Map<string, string>();
for (const c of portfolioCases) {
  if (c.slugEn) {
    portfolioSlugMap.set(c.slug, c.slugEn);
    portfolioSlugMap.set(c.slugEn, c.slug);
  }
}

// hreflang URLs — pár + x-default (CS) JEN pokud druhá jazyková verze reálně
// existuje. CS-only stránky (opravy) hreflang nedeklarují vůbec.
const alternatePath = getAlternatePathStrict(
  Astro.url.pathname,
  currentLocale,
  productSlugMap,
  portfolioSlugMap,
);
const csPath = currentLocale === 'cs' ? Astro.url.pathname : alternatePath;
const enPath = currentLocale === 'en' ? Astro.url.pathname : alternatePath;
const hasAlternate = alternatePath !== null;
const csUrl = csPath ? `${siteUrl}${csPath}` : null;
const enUrl = enPath ? `${siteUrl}${enPath}` : null;

const htmlLang = t('locale.full');
const ogLocale = t('locale.ogLocale');
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Martin Ševr" />
    <meta name="theme-color" content="#F1EEE5" />
    <meta name="google-site-verification" content="w_cLfqqzCP8FOZsrvN0fd6bWNChseWl2mlkZJxR3QoE" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- hreflang — obě varianty + x-default (CS = default); jen u stránek s reálným ekvivalentem -->
    {hasAlternate && (
      <Fragment>
        <link rel="alternate" hreflang="cs" href={csUrl} />
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="x-default" href={csUrl} />
      </Fragment>
    )}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle || title} />
    <meta property="og:description" content={ogDescription || description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={currentLocale === 'cs' ? 'en_GB' : 'cs_CZ'} />
    <meta property="og:site_name" content="Martin Ševr — Zlatnická dílna Praha" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle || title} />
    <meta name="twitter:description" content={ogDescription || description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- Favicon + Touch Icons
         Google Search Results vyžaduje multiples of 48 (48/96/192) v PNG.
         ?v=2 = cache-buster po výměně favicony 2026-05-17; bump při každé další změně. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png?v=2" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png?v=2" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png?v=2" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" sizes="32x32" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Fonts — Astro 6 Fonts API (self-hosted, metric-compatible fallbacky, preload) -->
    <Font cssVariable="--font-general-sans" preload />
    <Font cssVariable="--font-playfair" preload />

    <!-- LCP image preload — kritické pro FCP/LCP performance -->
    {lcpImageMobile && (
      <link
        rel="preload"
        as="image"
        href={lcpImageMobile}
        imagesrcset={lcpImageMobile2x ? `${lcpImageMobile} 1x, ${lcpImageMobile2x} 2x` : undefined}
        media="(max-width: 1023px)"
        fetchpriority="high"
      />
    )}
    {lcpImageDesktop && (
      <link
        rel="preload"
        as="image"
        href={lcpImageDesktop}
        imagesrcset={lcpImageDesktop2x ? `${lcpImageDesktop} 1x, ${lcpImageDesktop2x} 2x` : undefined}
        media="(min-width: 1024px)"
        fetchpriority="high"
      />
    )}

    <!-- Preconnect na Google Tag Manager (gtag.js se načte deferred po user interaction) -->
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />

    <!-- JSON-LD — escape `</` aby string uvnitř nikdy nemohl předčasně uzavřít <script>. -->
    {jsonLd && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
    )}

    <!-- Consent Mode v2 default = denied. Processed script (ne is:inline) — Astro CSP
         hashuje jen zpracované skripty; is:inline by striktní CSP zablokovala.
         Deferred provedení je v basic módu bezpečné: gtag.js se načítá až po souhlasu,
         do té doby gtag() jen řadí do dataLayer fronty. -->
    <script>
      window.dataLayer = window.dataLayer || [];
      // gtag.js vyžaduje v dataLayer `arguments` objekty — rest parametr (pole) by
      // commandy tiše zahodil. Proto klasická funkce s arguments.
      function gtag() {
        // eslint-disable-next-line prefer-rest-params
        window.dataLayer!.push(arguments);
      }
      window.gtag = gtag as Window['gtag'];
      window.gtag!('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500,
      });
      try {
        if (localStorage.getItem('cookie-consent') === 'granted') {
          window.gtag!('consent', 'update', { analytics_storage: 'granted' });
        }
      } catch {
        /* private mode bez localStorage — default denied zůstává */
      }
    </script>
  </head>
  <body class="bg-bg-primary text-text-primary font-sans">
    <a href="#main" class="skip-to-content">{t('common.skipToContent')}</a>
    <Nav overlay={navOverlay} locale={currentLocale} />
    <main id="main" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>
    <Footer locale={currentLocale} ctaHeading={ctaHeading} ctaSubtitle={ctaSubtitle} ctaPrimaryLabel={ctaPrimaryLabel} ctaPrimaryHref={ctaPrimaryHref} />
    <CookieBanner locale={currentLocale} />

    <!-- GA gtag.js — Consent Mode v2 BASIC: skript se načte VÝHRADNĚ po souhlasu.
         Bez souhlasu (nebo při odmítnutí) na Google neodejde jediný request.
         Po souhlasu se načítá deferred (interakce/idle) — kritické pro PageSpeed. -->
    <script>
      const GA_ID = 'G-4XK17M8XVJ';

      function loadGA() {
        if (window.__gaLoaded) return;
        window.__gaLoaded = true;
        const s = document.createElement('script');
        s.async = true;
        s.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
        document.head.appendChild(s);
        window.gtag?.('js', new Date());
        window.gtag?.('config', GA_ID, { anonymize_ip: true });
      }
      // Volá CookieBanner okamžitě po kliknutí na „Souhlasím".
      window.__loadGA = loadGA;

      // Deferred load jen pro vracející se návštěvníky s dříve uděleným souhlasem.
      let consent: string | null = null;
      try {
        consent = localStorage.getItem('cookie-consent');
      } catch {
        /* bez localStorage = bez souhlasu = GA se nenačte */
      }
      if (consent === 'granted') {
        const triggers = ['scroll', 'click', 'keydown', 'touchstart', 'mousemove'];
        const once = () => {
          triggers.forEach((e) => window.removeEventListener(e, once));
          loadGA();
        };
        triggers.forEach((e) => window.addEventListener(e, once, { passive: true, once: true }));
        window.addEventListener('load', () => {
          if ('requestIdleCallback' in window) {
            requestIdleCallback(loadGA, { timeout: 5000 });
          } else {
            setTimeout(loadGA, 3000);
          }
        });
        // Lazy-loaded module může běžet až po load eventu — pak naplánuj rovnou.
        if (document.readyState === 'complete') loadGA();
      }
    </script>

    <script>
      // Skip GSAP download entirely na stránkách bez animací (např. /ochrana-osobnich-udaju, /404).
      const hasAnims = document.querySelector('[data-anim],[data-float]');
      if (hasAnims) {
        const loadAnimations = () => import('../scripts/animations.ts');
        if ('requestIdleCallback' in window) {
          requestIdleCallback(loadAnimations, { timeout: 2500 });
        } else {
          setTimeout(loadAnimations, 800);
        }
      }
    </script>

    <script>
      // Core Web Vitals → GA4. Lazy-load až po idle — nesmí konkurovat LCP/INP měření samému.
      const loadVitals = () => import('../scripts/web-vitals.ts');
      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadVitals, { timeout: 4000 });
      } else {
        setTimeout(loadVitals, 1500);
      }
    </script>
  </body>
</html>
