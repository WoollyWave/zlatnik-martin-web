---
import Button from './Button.astro';
import { SITE } from '../data/site';
import type { Locale } from '../i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'cs' } = Astro.props;

const CONTACT_EMAIL = SITE.email;

const t = locale === 'en'
  ? {
      hpLabel: 'Website (leave empty)',
      name: 'Name',
      namePlaceholder: 'Your name',
      email: 'Email',
      emailPlaceholder: 'you@email.com',
      phone: 'Phone',
      message: 'Message',
      messagePlaceholder: 'Tell me your idea...',
      gdpr: 'I agree to the processing of personal data for the purpose of answering my enquiry. More in the',
      privacy: 'privacy policy',
      privacyHref: '/en/privacy/',
      submit: 'Send message',
      sending: 'Sending…',
      errorFallback: 'Could not send the message. Please write directly to',
    }
  : {
      hpLabel: 'Website (nechte prázdné)',
      name: 'Jméno',
      namePlaceholder: 'Vaše jméno',
      email: 'E-mail',
      emailPlaceholder: 'vas@email.cz',
      phone: 'Telefon',
      message: 'Zpráva',
      messagePlaceholder: 'Popište svou představu...',
      gdpr: 'Souhlasím se zpracováním osobních údajů za účelem odpovědi na můj dotaz. Více informací v',
      privacy: 'zásadách ochrany osobních údajů',
      privacyHref: '/ochrana-osobnich-udaju',
      submit: 'Odeslat zprávu',
      sending: 'Odesílám…',
      errorFallback: 'Zprávu se nepodařilo odeslat. Napište prosím přímo na',
    };
---

<form
  class="space-y-6"
  data-contact-form
  data-sending-text={t.sending}
  data-error-fallback={t.errorFallback}
  data-fallback-email={CONTACT_EMAIL}
  action="/send.php"
  method="POST"
  novalidate
>
  <div class="absolute left-[-9999px]" aria-hidden="true">
    <label>{t.hpLabel}
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <div>
    <label for="name" class="block body-md font-medium text-text-primary mb-2">{t.name}</label>
    <input
      type="text"
      id="name"
      name="name"
      autocomplete="name"
      required
      aria-required="true"
      class="w-full px-4 py-3 bg-white border border-border rounded-[2px] text-text-primary body-md focus:outline-none focus:ring-2 focus:ring-gold-primary/35 focus:border-gold-primary transition-colors duration-200"
      placeholder={t.namePlaceholder}
    />
  </div>

  <div>
    <label for="email" class="block body-md font-medium text-text-primary mb-2">{t.email}</label>
    <input
      type="email"
      id="email"
      name="email"
      autocomplete="email"
      required
      aria-required="true"
      class="w-full px-4 py-3 bg-white border border-border rounded-[2px] text-text-primary body-md focus:outline-none focus:ring-2 focus:ring-gold-primary/35 focus:border-gold-primary transition-colors duration-200"
      placeholder={t.emailPlaceholder}
    />
  </div>

  <div>
    <label for="phone" class="block body-md font-medium text-text-primary mb-2">{t.phone}</label>
    <input
      type="tel"
      id="phone"
      name="phone"
      autocomplete="tel"
      class="w-full px-4 py-3 bg-white border border-border rounded-[2px] text-text-primary body-md focus:outline-none focus:ring-2 focus:ring-gold-primary/35 focus:border-gold-primary transition-colors duration-200"
      placeholder="+420 ..."
    />
  </div>

  <div>
    <label for="message" class="block body-md font-medium text-text-primary mb-2">{t.message}</label>
    <textarea
      id="message"
      name="message"
      rows="5"
      class="w-full px-4 py-3 bg-white border border-border rounded-[2px] text-text-primary body-md focus:outline-none focus:ring-2 focus:ring-gold-primary/35 focus:border-gold-primary transition-colors duration-200 resize-vertical"
      placeholder={t.messagePlaceholder}
    ></textarea>
  </div>

  <div class="flex items-start gap-3">
    <input
      type="checkbox"
      id="gdpr"
      name="gdpr"
      required
      aria-required="true"
      class="mt-1 w-4 h-4 border-border rounded-[2px] accent-gold-deep focus:ring-2 focus:ring-gold-deep/40"
    />
    <label for="gdpr" class="body-md text-text-secondary leading-relaxed">
      {t.gdpr} <a href={t.privacyHref} class="underline hover:text-gold-on-light transition-colors">{t.privacy}</a>.
    </label>
  </div>

  <p data-form-status role="status" aria-live="polite" class="hidden body-md"></p>

  <Button type="submit" variant="primary">{t.submit}</Button>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const status = form.querySelector<HTMLParagraphElement>('[data-form-status]');
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const originalLabel = submitBtn?.textContent ?? '';
    const sendingText = form.dataset.sendingText || 'Odesílám…';
    const errorFallback = form.dataset.errorFallback || 'Zprávu se nepodařilo odeslat. Napište prosím přímo na';
    const fallbackEmail = form.dataset.fallbackEmail || '';

    function setStatus(message: string, kind: 'success' | 'error') {
      if (!status) return;
      status.textContent = message;
      status.classList.remove('hidden', 'text-success', 'text-error');
      status.classList.add(kind === 'success' ? 'text-success' : 'text-error');
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;

      const honeypot = form.elements.namedItem('website') as HTMLInputElement | null;
      if (honeypot?.value) return;

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = sendingText;
      }

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { 'Accept': 'application/json' },
        });
        const data = await res.json().catch(() => null) as { ok?: boolean; message?: string; error?: string } | null;

        if (res.ok && data?.ok) {
          setStatus(data.message || 'Děkuji, ozvu se vám co nejdříve.', 'success');
          form.reset();
        } else {
          const msg = data?.error || `${errorFallback} ${fallbackEmail}.`;
          setStatus(msg, 'error');
        }
      } catch {
        setStatus(`${errorFallback} ${fallbackEmail}.`, 'error');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = originalLabel;
        }
      }
    });
  }
</script>
