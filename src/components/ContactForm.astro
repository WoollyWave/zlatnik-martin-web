---
import Button from './Button.astro';
import { SITE } from '../data/site';
import type { Locale } from '../i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'cs' } = Astro.props;

const CONTACT_EMAIL = SITE.email;

const t = locale === 'en'
  ? {
      hpLabel: 'Website (leave empty)',
      name: 'Name',
      namePlaceholder: 'Your name',
      email: 'Email',
      emailPlaceholder: 'you@email.com',
      phone: 'Phone',
      message: 'Message',
      messagePlaceholder: 'Tell me your idea...',
      gdpr: 'I agree to the processing of personal data for the purpose of answering my enquiry. More in the',
      privacy: 'privacy policy',
      privacyHref: '/en/privacy/',
      submit: 'Send message',
      sending: 'Sending…',
      errorFallback: 'Could not send the message. Please write directly to',
      flashSuccess: 'Thank you, your message has arrived. I will reply within 24 hours. If it is urgent, call +420 774 598 181.',
      flashError: 'The message could not be sent. Please write to me directly at',
    }
  : {
      hpLabel: 'Website (nechte prázdné)',
      name: 'Jméno',
      namePlaceholder: 'Vaše jméno',
      email: 'E-mail',
      emailPlaceholder: 'vas@email.cz',
      phone: 'Telefon',
      message: 'Zpráva',
      messagePlaceholder: 'Popište svou představu...',
      gdpr: 'Souhlasím se zpracováním osobních údajů za účelem odpovědi na můj dotaz. Více informací v',
      privacy: 'zásadách ochrany osobních údajů',
      privacyHref: '/ochrana-osobnich-udaju/',
      submit: 'Odeslat zprávu',
      sending: 'Odesílám…',
      errorFallback: 'Zprávu se nepodařilo odeslat. Napište prosím přímo na',
      flashSuccess: 'Děkuji, zpráva dorazila. Ozvu se do 24 hodin. Když spěcháte, zavolejte na +420 774 598 181.',
      flashError: 'Zprávu se nepodařilo odeslat. Napište mi prosím přímo na',
    };
---

{/* No-JS fallback: send.php přesměruje nativní POST zpět s #form-sent / #form-error
    a blok se zobrazí čistě přes CSS :target. S JS vykresluje hlášku [data-form-status]. */}
<div id="form-sent" class="form-flash text-success body-md" role="status">
  {t.flashSuccess}
</div>
<div id="form-error" class="form-flash text-error body-md" role="alert">
  {t.flashError} <a href={`mailto:${CONTACT_EMAIL}`} class="underline">{CONTACT_EMAIL}</a>.
</div>

<form
  class="space-y-6"
  data-contact-form
  data-sending-text={t.sending}
  data-success-text={t.flashSuccess}
  data-error-fallback={t.errorFallback}
  data-fallback-email={CONTACT_EMAIL}
  action="/send.php"
  method="POST"
>
  <input type="hidden" name="locale" value={locale} />
  <div class="absolute left-[-9999px]" aria-hidden="true">
    <label>{t.hpLabel}
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <div>
    <label for="name" class="block body-md font-medium text-text-primary mb-2">{t.name}</label>
    <input
      type="text"
      id="name"
      name="name"
      autocomplete="name"
      required
      aria-required="true"
      class="w-full px-4 py-3 bg-white border border-border rounded-[2px] text-text-primary body-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-deep focus-visible:border-gold-deep transition-colors duration-200"
      placeholder={t.namePlaceholder}
    />
  </div>

  <div>
    <label for="email" class="block body-md font-medium text-text-primary mb-2">{t.email}</label>
    <input
      type="email"
      id="email"
      name="email"
      autocomplete="email"
      required
      aria-required="true"
      class="w-full px-4 py-3 bg-white border border-border rounded-[2px] text-text-primary body-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-deep focus-visible:border-gold-deep transition-colors duration-200"
      placeholder={t.emailPlaceholder}
    />
  </div>

  <div>
    <label for="phone" class="block body-md font-medium text-text-primary mb-2">{t.phone}</label>
    <input
      type="tel"
      id="phone"
      name="phone"
      autocomplete="tel"
      class="w-full px-4 py-3 bg-white border border-border rounded-[2px] text-text-primary body-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-deep focus-visible:border-gold-deep transition-colors duration-200"
      placeholder="+420 ..."
    />
  </div>

  <div>
    <label for="message" class="block body-md font-medium text-text-primary mb-2">{t.message}</label>
    <textarea
      id="message"
      name="message"
      rows="5"
      class="w-full px-4 py-3 bg-white border border-border rounded-[2px] text-text-primary body-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-deep focus-visible:border-gold-deep transition-colors duration-200 resize-vertical"
      placeholder={t.messagePlaceholder}
    ></textarea>
  </div>

  <div class="flex items-start gap-3">
    <input
      type="checkbox"
      id="gdpr"
      name="gdpr"
      required
      aria-required="true"
      class="mt-1 w-4 h-4 border-border rounded-[2px] accent-gold-deep focus:ring-2 focus:ring-gold-deep/40"
    />
    <label for="gdpr" class="body-md text-text-secondary leading-relaxed">
      {t.gdpr} <a href={t.privacyHref} class="underline hover:text-gold-on-light transition-colors">{t.privacy}</a>.
    </label>
  </div>

  <p data-form-status role="status" aria-live="polite" class="hidden body-md"></p>

  <Button type="submit" variant="primary">{t.submit}</Button>
</form>

<style>
  .form-flash {
    display: none;
    margin-bottom: 1.5rem;
    padding: 0.875rem 1.125rem;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.8);
  }
  .form-flash:target {
    display: block;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  /* `novalidate` nasazujeme až tady, ne v HTML. S JS si validaci řídí
     reportValidity() níž, ale BEZ JS je nativní kontrola prohlížeče jediná,
     která existuje — s natvrdo zapsaným novalidate projde odeslání bez GDPR
     souhlasu nebo s překlepem v e-mailu až na server, ten vrátí 422 a 303
     zpět na statickou stránku s PRÁZDNÝM formulářem. Vyplněná poptávka je
     pryč a zákazník ji podruhé nepíše. */
  form?.setAttribute('novalidate', '');
  if (form) {
    const status = form.querySelector<HTMLParagraphElement>('[data-form-status]');
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const originalLabel = submitBtn?.textContent ?? '';
    const sendingText = form.dataset.sendingText || 'Odesílám…';
    const successText = form.dataset.successText || '';
    const errorFallback = form.dataset.errorFallback || 'Zprávu se nepodařilo odeslat. Napište prosím přímo na';
    const fallbackEmail = form.dataset.fallbackEmail || '';

    function setStatus(message: string, kind: 'success' | 'error') {
      if (!status) return;
      status.textContent = message;
      status.classList.remove('hidden', 'text-success', 'text-error');
      status.classList.add(kind === 'success' ? 'text-success' : 'text-error');
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;

      const honeypot = form.elements.namedItem('website') as HTMLInputElement | null;
      if (honeypot?.value) return;

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = sendingText;
      }

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { 'Accept': 'application/json' },
        });
        const data = await res.json().catch(() => null) as { ok?: boolean; message?: string; error?: string } | null;

        if (res.ok && data?.ok) {
          setStatus(data.message || successText, 'success');
          // Konverze až po potvrzení od serveru — odeslaný formulář, který
          // spadl, není poptávka. Bez souhlasu gtag jen tiše zařadí do fronty.
          window.gtag?.('event', 'form_submit', {
            form_name: 'kontakt',
            page_path: window.location.pathname,
          });
          form.reset();
        } else {
          const msg = data?.error || `${errorFallback} ${fallbackEmail}.`;
          setStatus(msg, 'error');
        }
      } catch {
        setStatus(`${errorFallback} ${fallbackEmail}.`, 'error');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = originalLabel;
        }
      }
    });
  }
</script>
