---
import PhotoFrame from './PhotoFrame.astro';

interface Props {
  href: string;
  image: string;
  image2x: string;
  alt: string;
  label: string;
  title: string;
  description: string;
  tags: string[];
  loading?: 'eager' | 'lazy';
  /** `h2` na stránkách bez nadřazeného h1 v sekci, jinak `h3`. Default `h3`. */
  headingLevel?: 'h2' | 'h3';
  imageRatio?: 'tight' | 'wide';
  showCta?: boolean;
}

const {
  href,
  image,
  image2x,
  alt,
  label,
  title,
  description,
  tags,
  loading = 'lazy',
  headingLevel = 'h3',
  imageRatio = 'tight',
  showCta = false,
} = Astro.props;

const Heading = headingLevel;
const gridCols = imageRatio === 'wide' ? 'md:grid-cols-[0.5fr_1fr]' : 'md:grid-cols-[0.45fr_1fr]';
---

<a href={href} class="group block border-t border-border py-10 md:py-14" data-anim="up">
  <div class={`grid grid-cols-1 ${gridCols} gap-8 md:gap-12 lg:gap-16 items-center`}>

    <div class="relative aspect-[4/3] overflow-hidden">
      <img
        src={image}
        srcset={`${image} 800w, ${image2x} 1600w`}
        sizes="(min-width: 768px) 40vw, 100vw"
        width="800"
        height="600"
        alt={alt}
        loading={loading}
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700"
      />
      <PhotoFrame />
      <div class="absolute bottom-4 left-4 bg-bg-primary/90 backdrop-blur-md px-4 py-2.5 shadow-soft">
        <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-gold-on-light font-sans">{label}</span>
      </div>
    </div>

    <div class="flex items-start justify-between gap-6">
      <div>
        <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-gold-on-light font-sans">{label}</span>
        <Heading class="mt-2 group-hover:text-gold-deep transition-colors duration-300">{title}</Heading>
        <p class="body-md text-text-secondary leading-relaxed mt-3 max-w-lg font-sans">{description}</p>
        <div class="flex flex-wrap gap-3 mt-5">
          {tags.map((tag) => (
            <span class="text-[0.6875rem] uppercase tracking-wider text-text-muted font-sans border border-border px-3 py-1.5">{tag}</span>
          ))}
        </div>
        {showCta && (
          <div class="mt-6">
            <span class="text-[11px] text-text-secondary uppercase tracking-[0.2em] font-sans font-medium group-hover:text-gold-deep transition-colors duration-300 inline-flex items-center gap-2">
              Podrobnosti
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" /></svg>
            </span>
          </div>
        )}
      </div>
      <div class="hidden sm:flex flex-shrink-0 mt-2 h-10 w-10 rounded-full border border-border items-center justify-center group-hover:bg-text-primary group-hover:border-text-primary transition-colors duration-300">
        <svg class="w-4 h-4 text-text-primary group-hover:text-white transition-colors duration-300" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" /></svg>
      </div>
    </div>

  </div>
</a>
