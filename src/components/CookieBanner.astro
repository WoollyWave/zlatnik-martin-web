---
// Cookie banner: GDPR souhlas pro GA4 a PostHog (od 5. 10. 2026). Skrytý, dokud JS nezjistí,
// že rozhodnutí ještě neexistuje, nebo dokud ho neotevře Nastavení cookies v patičce.
import type { Locale } from '../i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'cs' } = Astro.props;

const t = locale === 'en'
  ? {
      heading: 'Cookies and analytics',
      body: 'I use Google Analytics and PostHog to improve this site: statistics about how you move around the pages, where you click and where you leave. What you type into forms is never recorded. No advertising cookies. More in the',
      privacyLabel: 'privacy policy',
      privacyHref: '/en/privacy/',
      decline: 'Decline',
      accept: 'Accept',
    }
  : {
      heading: 'Cookies a měření návštěvnosti',
      body: 'Pro zlepšování webu používám Google Analytics a PostHog: statistiky o tom, jak se po stránkách pohybujete, kam klikáte a kde odcházíte. Obsah vyplněných polí se nikdy nezaznamenává. Žádné reklamní cookies. Více v',
      privacyLabel: 'ochraně osobních údajů',
      privacyHref: '/ochrana-osobnich-udaju/',
      decline: 'Odmítnout',
      accept: 'Souhlasím',
    };
---

<!-- ph-no-capture: klik na Odmítnout by PostHog ještě stihl zaznamenat, lišta do měření nepatří. -->
<div
  id="cookie-banner"
  class="ph-no-capture fixed bottom-0 inset-x-0 z-[100] invisible opacity-0 translate-y-4 transition-all duration-500 px-4 sm:px-6 pb-4 sm:pb-6"
  aria-hidden="true"
>
  <div class="max-w-[1100px] mx-auto pointer-events-auto bg-bg-primary border border-border shadow-soft">
    <div class="grid lg:grid-cols-[1fr_auto] items-start gap-6 lg:gap-10 p-5 sm:p-6 lg:p-7">
      <div>
        <p class="font-serif text-[clamp(1.05rem,0.95rem+0.4vw,1.2rem)] text-text-primary leading-snug">
          {t.heading}
        </p>
        <p class="mt-2 body-md text-text-secondary leading-relaxed max-w-[640px]">
          {t.body}
          <a href={t.privacyHref} class="text-gold-deep hover:underline">{t.privacyLabel}</a>.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 lg:items-center lg:justify-end">
        <button
          type="button"
          id="cookie-decline"
          class="inline-flex items-center justify-center h-12 px-6 sm:px-8 rounded-full border border-border bg-white/80 text-text-primary text-[11px] uppercase tracking-[0.2em] font-medium font-sans hover:bg-white transition-colors duration-200"
        >
          {t.decline}
        </button>
        <button
          type="button"
          id="cookie-accept"
          class="inline-flex items-center justify-center h-12 px-6 sm:px-8 rounded-full bg-text-primary text-button-text text-[11px] uppercase tracking-[0.2em] font-medium font-sans hover:bg-gold-deep transition-colors duration-200"
        >
          {t.accept}
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { SOUHLAS_KLIC } from '../lib/souhlas';
  const banner = document.getElementById('cookie-banner');
  if (!banner) {
    // Banner missing — fail silently
  } else {
    // Banner překrývá (fixed) — NEměníme výšku dokumentu (body padding), jinak by
    // pozdní zobrazení po 600 ms způsobilo layout shift (CLS) na krátkých stránkách.
    const show = () => {
      banner.classList.remove('invisible', 'opacity-0', 'translate-y-4');
      banner.setAttribute('aria-hidden', 'false');
    };
    const hide = () => {
      banner.classList.add('invisible', 'opacity-0', 'translate-y-4');
      banner.setAttribute('aria-hidden', 'true');
    };

    let decided: string | null = null;
    try { decided = localStorage.getItem(SOUHLAS_KLIC); } catch (e) {}

    if (!decided) {
      // Drobné zpoždění aby se stránka načetla a nepřekrývala hero
      window.setTimeout(show, 600);
    }

    // Úložiště měření se maže při KAŽDÉM odmítnutí: mohla ho znovu založit jiná
    // záložka, která měřila ještě před odvoláním. GA4 má cookies _ga, _ga_<ID> na
    // doméně bez www, PostHog localStorage a sessionStorage pod ph_<token>_*.
    // Klíč __ph_opt_in_out_* zůstává: je to jen příznak odmítnutí bez identifikátoru.
    const smazUlozisteMereni = () => {
      const domena = location.hostname.replace(/^www\./, '');
      document.cookie
        .split(';')
        .map((c) => c.trim().split('=')[0])
        .filter((n) => /^(_ga|ph_)/.test(n))
        .forEach((n) => {
          ['', `; domain=.${domena}`, `; domain=${domena}`].forEach((d) => {
            document.cookie = `${n}=; Max-Age=0; path=/${d}`;
          });
        });
      (['localStorage', 'sessionStorage'] as const).forEach((druh) => {
        try {
          const u = window[druh];
          Object.keys(u).filter((k) => /^ph_/.test(k)).forEach((k) => u.removeItem(k));
        } catch (e) { /* zablokované úložiště: není co mazat */ }
      });
    };

    const grant = () => {
      try { localStorage.setItem(SOUHLAS_KLIC, 'granted'); } catch (e) {}
      window.gtag?.('consent', 'update', {
        analytics_storage: 'granted',
      });
      // Basic consent mode: gtag.js se načítá až teď — před souhlasem neexistuje.
      window.__loadGA?.();
      window.__zlPostHog?.start();
      hide();
    };
    const deny = () => {
      // ODVOLÁNÍ (čl. 7 odst. 3 GDPR) i první odmítnutí. PostHog NEJDŘÍV zastavit,
      // jinak při odchodu ze stránky pošle $pageleave a smazané úložiště zapíše znovu.
      window.__zlPostHog?.stop();
      window.__stopGA?.();
      smazUlozisteMereni();
      try { localStorage.setItem(SOUHLAS_KLIC, 'denied'); } catch (e) {}
      hide();
    };

    document.getElementById('cookie-accept')?.addEventListener('click', grant);
    document.getElementById('cookie-decline')?.addEventListener('click', deny);
    // Nastavení cookies (patička): lišta se otevře znovu a volbu jde změnit.
    document.querySelectorAll('[data-cookie-settings]').forEach((el) => el.addEventListener('click', show));
  }
</script>
