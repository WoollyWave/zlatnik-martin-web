---
/**
 * Language switcher [CS|EN].
 *
 * Best practices 2026:
 * - Plain anchor tags (no JS) — crawlable
 * - Links to equivalent page in other language (via slug mapping)
 * - aria-current="page" on active language
 * - Active state styled visibly (not just color)
 */
import { getLocaleFromUrl, getAlternateUrl, type Locale } from '../i18n';
import { buildSlugMaps } from '../lib/slug-maps';

interface Props {
  /** Tailwind classes for outer wrapper (positioning). */
  class?: string;
}

const { class: className = '' } = Astro.props;

const currentLocale: Locale = getLocaleFromUrl(Astro.url);

// Mapy slug ↔ slug (oba směry) — sdílené s Layoutem.
const { productSlugMap, portfolioSlugMap } = buildSlugMaps();

// 404 nemá vlastní servírovanou URL (odkaz na /404/ by znovu spadl na chybu),
// pill aktuálního jazyka proto na chybové stránce míří na jazykový kořen.
const is404 = Astro.url.pathname.replace(/\/$/, '') === '/404';

const csUrl = currentLocale === 'cs'
  ? (is404 ? '/' : Astro.url.pathname)
  : getAlternateUrl(Astro.url.pathname, 'en', productSlugMap, portfolioSlugMap);

const enUrl = currentLocale === 'en'
  ? (is404 ? '/en/' : Astro.url.pathname)
  : getAlternateUrl(Astro.url.pathname, 'cs', productSlugMap, portfolioSlugMap);
---

<div class={`inline-flex items-center gap-1 text-[11px] tracking-[0.15em] font-sans font-medium uppercase ${className}`} role="group" aria-label={currentLocale === 'cs' ? 'Přepínač jazyka' : 'Language selector'}>
  <a
    href={csUrl}
    hreflang="cs"
    lang="cs"
    aria-current={currentLocale === 'cs' ? 'page' : undefined}
    class={`px-2 py-1 rounded-full transition-colors ${
      currentLocale === 'cs'
        ? 'text-text-primary bg-bg-secondary'
        : 'text-text-muted hover:text-gold-deep'
    }`}
  >CS</a>
  <span class="text-text-muted/40" aria-hidden="true">/</span>
  <a
    href={enUrl}
    hreflang="en"
    lang="en"
    aria-current={currentLocale === 'en' ? 'page' : undefined}
    class={`px-2 py-1 rounded-full transition-colors ${
      currentLocale === 'en'
        ? 'text-text-primary bg-bg-secondary'
        : 'text-text-muted hover:text-gold-deep'
    }`}
  >EN</a>
</div>
