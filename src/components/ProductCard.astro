---
import PhotoFrame from './PhotoFrame.astro';
import IconArrowUpRight from './IconArrowUpRight.astro';
import type { Locale } from '../i18n';

interface Props {
  title: string;
  material: string;
  priceSilver: string;
  priceGold?: string;
  goldNote?: string;
  href: string;
  category?: string;
  image?: string;
  alt?: string;
  description?: string;
  stockBadge?: 'jediny-originalni-kus' | null;
  sold?: boolean;
  /** `h2` na stránkách bez nadřazeného section h2, jinak `h3`. Default `h3`. */
  headingLevel?: 'h2' | 'h3';
  locale?: Locale;
}

const categoryLabelsCs: Record<string, string> = {
  prsteny: 'Prsteny',
  nausnice: 'Náušnice',
  privesky: 'Přívěsky',
  retizky: 'Řetízky',
  sady: 'Sady',
};

const categoryLabelsEn: Record<string, string> = {
  prsteny: 'Rings',
  nausnice: 'Earrings',
  privesky: 'Pendants',
  retizky: 'Chains',
  sady: 'Sets',
};

const {
  title,
  material,
  priceSilver,
  priceGold,
  goldNote,
  href,
  category,
  image,
  alt,
  description,
  stockBadge,
  sold,
  headingLevel = 'h3',
  locale = 'cs',
} = Astro.props;
const Heading = headingLevel;
const categoryMap = locale === 'en' ? categoryLabelsEn : categoryLabelsCs;
const defaultLabel = locale === 'en' ? 'In stock' : 'Skladem';
const categoryLabel = category ? categoryMap[category] || category : defaultLabel;

const labels = locale === 'en'
  ? { unique: '✦ One of a kind', silver: 'Silver', gold: 'Gold', details: 'Details', sold: 'Sold' }
  : { unique: '✦ Jediný kus',    silver: 'Stříbro', gold: 'Zlato', details: 'Podrobnosti', sold: 'Prodáno' };
---

<a href={href} class="group flex flex-col h-full border border-border hover:border-text-muted/30 transition-all duration-300" data-category={category} data-sold={sold ? 'true' : undefined}>

  <!-- Photo — AVIF s WebP fallbackem (avif sourozence generuje process-images) -->
  <div class="relative aspect-[3/2] overflow-hidden">
    {image ? (
      <picture>
        {image.endsWith('.webp') && (
          <source type="image/avif" srcset={image.replace(/\.webp$/, '.avif')} />
        )}
        <img
          src={image}
          width="1200" height="800"
          sizes="(min-width: 1024px) 660px, 100vw"
          alt={alt || title}
          loading="lazy"
          decoding="async"
          class="absolute inset-0 w-full h-full object-cover object-center group-hover:scale-[1.03] transition-transform duration-700"
        />
      </picture>
    ) : (
      <div class="absolute inset-0 bg-bg-tertiary flex items-center justify-center">
        <svg class="w-12 h-12 text-text-muted/30" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0 0 22.5 18.75V5.25A2.25 2.25 0 0 0 20.25 3H3.75A2.25 2.25 0 0 0 1.5 5.25v13.5A2.25 2.25 0 0 0 3.75 21Z" />
        </svg>
      </div>
    )}
    <PhotoFrame />

    {sold ? (
      <div class="absolute top-4 left-4 bg-text-primary/90 text-button-text px-3 py-1.5 text-[10px] uppercase tracking-[0.15em] font-medium font-sans shadow-soft">
        {labels.sold}
      </div>
    ) : stockBadge === 'jediny-originalni-kus' && (
      <div class="absolute top-4 left-4 bg-gold-deep text-button-text px-3 py-1.5 text-[10px] uppercase tracking-[0.15em] font-medium font-sans shadow-soft">
        {labels.unique}
      </div>
    )}

    <div class="absolute bottom-4 left-4 bg-bg-primary/90 backdrop-blur-md px-4 py-2.5 shadow-soft">
      <span class="text-[11px] uppercase tracking-[0.15em] font-medium text-gold-on-light font-sans">{categoryLabel}</span>
    </div>
  </div>

  <!-- Info -->
  <div class="flex-1 flex flex-col px-5 sm:px-6 py-5 sm:py-6">
    <div class="flex items-start justify-between gap-4 pb-6">
      <div class="min-w-0">
        <Heading class="card-title group-hover:text-gold-deep transition-colors duration-300">{title}</Heading>
        <p class="body-md text-text-secondary mt-1.5 font-sans">{material}</p>
        {description && (
          <p class="body-md text-text-secondary mt-3 leading-relaxed font-sans line-clamp-2">{description}</p>
        )}
      </div>
      <div class="flex-shrink-0 text-right whitespace-nowrap">
        <div class="flex items-baseline justify-end gap-2">
          <span class="text-[10px] uppercase tracking-[0.15em] text-text-muted font-sans font-medium">{labels.silver}</span>
          <span class="font-sans font-medium text-[clamp(1rem,0.85rem+0.5vw,1.25rem)] text-gold-deep tracking-tight">{priceSilver}</span>
        </div>
        {priceGold && (
          <div class="mt-1 flex items-baseline justify-end gap-2">
            <span class="text-[10px] uppercase tracking-[0.15em] text-text-muted font-sans font-medium">{labels.gold}</span>
            <span class="font-sans text-[clamp(0.875rem,0.75rem+0.3vw,1rem)] text-text-secondary tracking-tight">{priceGold}</span>
          </div>
        )}
        {goldNote && priceGold && (
          <p class="mt-1 text-[10px] text-text-muted font-sans">({goldNote})</p>
        )}
      </div>
    </div>
    <div class="mt-auto pt-6 border-t border-border flex items-center justify-between">
      <span class="text-[clamp(0.6875rem,0.6rem+0.15vw,0.8125rem)] text-text-secondary uppercase tracking-[0.2em] font-sans font-medium group-hover:text-gold-deep transition-colors duration-300">{labels.details}</span>
      <div class="h-10 w-10 rounded-full border border-border flex items-center justify-center group-hover:bg-text-primary group-hover:border-text-primary transition-colors duration-300">
        <IconArrowUpRight class="w-4 h-4 text-text-primary group-hover:text-white transition-colors duration-300" />
      </div>
    </div>
  </div>

</a>
