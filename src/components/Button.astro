---
import IconArrowUpRight from './IconArrowUpRight.astro';
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'text';
  class?: string;
  type?: 'button' | 'submit';
  ariaLabel?: string;
}
const { href, variant = 'primary', class: className = '', type = 'button', ariaLabel } = Astro.props;

const base = 'inline-flex items-center justify-center font-sans font-medium transition-[background-color,color,border-color,box-shadow] duration-300 cursor-pointer';

const variants: Record<string, string> = {
  primary: `${base} gap-3 h-12 px-6 sm:px-8 bg-text-primary btn-text-light rounded-full text-[clamp(0.6875rem,0.6rem+0.15vw,0.8125rem)] uppercase tracking-[0.2em] shadow-md hover:bg-gold-deep hover:shadow-lg`,
  secondary: `${base} gap-2 h-12 px-5 sm:px-6 border border-border bg-white/80 text-text-primary rounded-full text-[clamp(0.6875rem,0.6rem+0.15vw,0.8125rem)] uppercase tracking-[0.2em] shadow-sm hover:bg-white hover:border-gold-deep/60 hover:shadow-md hover:text-gold-deep`,
  text: `${base} text-[clamp(0.6875rem,0.6rem+0.15vw,0.8125rem)] text-text-secondary uppercase tracking-[0.2em] hover:text-gold-deep gap-2`,
};

const classes = `${variants[variant]} ${className}`.trim();
---

{href ? (
  <a href={href} class={classes} aria-label={ariaLabel}>
    <slot />
    {variant === 'text' && <IconArrowUpRight class="w-3.5 h-3.5" />}
  </a>
) : (
  <button type={type} class={classes} aria-label={ariaLabel}>
    <slot />
  </button>
)}
