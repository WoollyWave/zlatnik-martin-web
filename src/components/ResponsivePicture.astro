---
// Responzivní <picture> wrapper. Na viewportech ≤640px servíruje mobilní variantu.
// AVIF má přednost před WebP (pořadí <source> rozhoduje) — typicky o 30–50 % menší.
// Vyžaduje sourozenecké soubory v `public/images/` (generuje `npm run images`,
// AVIF ke starším WebP dogeneruje `node scripts/process-images.mjs --backfill-avif`):
//   {base}.{avif,webp}, {base}@2x.*, {base}-mobile.*, {base}-mobile@2x.*
// Mobilní varianty vznikají pro zdroje s cílovou šířkou ≥1200px.
interface Props {
  base: string;            // např. "homepage--hero--ametystovy-cluster-na-ruce"
  alt: string;
  width: number | string;
  height: number | string;
  loading?: 'eager' | 'lazy';
  decoding?: 'sync' | 'async' | 'auto';
  class?: string;
  fetchpriority?: 'high' | 'low' | 'auto';
  mobileBreakpoint?: number; // default 640
}
const {
  base,
  alt,
  width,
  height,
  loading = 'lazy',
  decoding = 'async',
  fetchpriority,
  mobileBreakpoint = 640,
  class: className = '',
} = Astro.props;
const baseUrl = `/images/${base}`;
---
<picture>
  <source
    media={`(max-width: ${mobileBreakpoint}px)`}
    type="image/avif"
    srcset={`${baseUrl}-mobile.avif 1x, ${baseUrl}-mobile@2x.avif 2x`}
  />
  <source
    media={`(max-width: ${mobileBreakpoint}px)`}
    type="image/webp"
    srcset={`${baseUrl}-mobile.webp 1x, ${baseUrl}-mobile@2x.webp 2x`}
  />
  <source
    type="image/avif"
    srcset={`${baseUrl}.avif 1x, ${baseUrl}@2x.avif 2x`}
  />
  <img
    src={`${baseUrl}.webp`}
    srcset={`${baseUrl}.webp 1x, ${baseUrl}@2x.webp 2x`}
    width={width}
    height={height}
    alt={alt}
    loading={loading}
    decoding={decoding}
    fetchpriority={fetchpriority}
    class={className}
  />
</picture>
