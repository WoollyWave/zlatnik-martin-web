---
// Responzivní <picture> wrapper. Na viewportech ≤640px servíruje mobilní variantu.
// Vyžaduje sourozenecké soubory v `public/images/`:
//   {base}.webp, {base}@2x.webp, {base}-mobile.webp, {base}-mobile@2x.webp
// Mobilní varianty generuje `npm run images` pro zdroje s cílovou šířkou ≥1200px.
interface Props {
  base: string;            // např. "homepage--hero--ametystovy-cluster-na-ruce"
  alt: string;
  width: number | string;
  height: number | string;
  loading?: 'eager' | 'lazy';
  decoding?: 'sync' | 'async' | 'auto';
  class?: string;
  fetchpriority?: 'high' | 'low' | 'auto';
  mobileBreakpoint?: number; // default 640
}
const {
  base,
  alt,
  width,
  height,
  loading = 'lazy',
  decoding = 'async',
  fetchpriority,
  mobileBreakpoint = 640,
  class: className = '',
} = Astro.props;
const baseUrl = `/images/${base}`;
---
<picture>
  <source
    media={`(max-width: ${mobileBreakpoint}px)`}
    type="image/webp"
    srcset={`${baseUrl}-mobile.webp 1x, ${baseUrl}-mobile@2x.webp 2x`}
  />
  <img
    src={`${baseUrl}.webp`}
    srcset={`${baseUrl}.webp 1x, ${baseUrl}@2x.webp 2x`}
    width={width}
    height={height}
    alt={alt}
    loading={loading}
    decoding={decoding}
    fetchpriority={fetchpriority}
    class={className}
  />
</picture>
