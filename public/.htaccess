# ==========================================================================
# zlatnik-martin.cz — Hostinger LiteSpeed
# Static Astro build · SEO + Security + Performance (best practices 2026)
# Canonical origin: https://www.zlatnik-martin.cz/
# ==========================================================================

# --- 0) Server hardening ---------------------------------------------------
Options -Indexes -MultiViews
ServerSignature Off
AddDefaultCharset UTF-8
DirectoryIndex index.html

# --- 1) Canonical URL (HTTPS + www + bez index.html) -----------------------
# SEO/AEO: jeden URL = jeden zdroj, VŽDY jediným 301 skokem na kanonický origin
# (řetězené redirecty ředí crawl budget a zpomalují first-load). Pořadí pravidel
# je záměrné: apex se řeší PŘED obecným HTTPS upgradem, aby http://apex šel na
# https://www jedním skokem, ne dvěma.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1a) apex zlatnik-martin.cz (http i https) → https://www JEDNÍM skokem.
  # Záměrně host-scoped, ne catch-all: stejný build běží i na stagingu
  # (web.vilim.sbs), který musí zůstat na svém hostu (indexaci mu zakazuje
  # host-based robots.txt v pravidle 1d).
  RewriteCond %{HTTP_HOST} ^zlatnik-martin\.cz(:[0-9]+)?$ [NC]
  RewriteRule ^ https://www.zlatnik-martin.cz%{REQUEST_URI} [L,R=301,NE]

  # 1d) Staging guard — jiný host než *.zlatnik-martin.cz (např. web.vilim.sbs)
  # dostane zakazující robots-staging.txt místo produkčního robots.txt.
  # POZOR: řešit přes mod_rewrite, NE přes `Header ... env=` — LiteSpeed na
  # Hostingeru env= podmínku nerespektuje a X-Robots-Tag noindex se posílal
  # bezpodmínečně i na produkci (blokovaná indexace celého webu, 7/2026).
  # `(:[0-9]+)?` — HTTP_HOST je syrová hlavička Host a smí obsahovat port.
  # Bez toho by se `www.zlatnik-martin.cz:443` netrefil a produkce by servírovala
  # zakazující robots-staging.txt.
  RewriteCond %{HTTP_HOST} !(^|\.)zlatnik-martin\.cz(:[0-9]+)?$ [NC]
  RewriteRule ^robots\.txt$ /robots-staging.txt [L]

  # 1b) HTTP → HTTPS na aktuálním hostu (produkční www i staging; apex už
  # odbavilo 1a). X-Forwarded-Proto kvůli LiteSpeed/CDN proxy.
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]

  # 1c) Strip trailing /index.html → /
  RewriteCond %{THE_REQUEST} \s/+(.*)index\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301,NE]

  # 1e) Legacy URL z předchozího webu → nové ekvivalenty.
  # Obě adresy vracely 404, ale v GSC (7/2026) pořád rankovaly a nosily prokliky:
  # /retizky poz. 6,5 (líp než nová /retezy/) a /puncovni-znacky poz. 5,2.
  # Bez 301 se ta pozice zahodí. Volitelné trailing / kvůli oběma variantám v indexu.
  RewriteRule ^retizky/?$        /retezy/  [L,R=301,NE]
  RewriteRule ^puncovni-znacky/?$ /o-dilne/ [L,R=301,NE]
</IfModule>

# --- 2) Security headers (OWASP 2026) --------------------------------------
<IfModule mod_headers.c>
  # HSTS — HTTPS-only po 1 rok. Pro HSTS preload list později zvýšit max-age=63072000 a doplnit "preload".
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # CSP — hlavní policy generuje Astro jako <meta http-equiv> s SHA-256 hashi
  # inline skriptů/stylů (žádný 'unsafe-inline', viz security.csp v astro.config.mjs).
  # Header nese jen frame-ancestors — ten <meta> varianta CSP přenést neumí.
  Header always set Content-Security-Policy "frame-ancestors 'none'"

  # Anti-clickjacking (legacy + moderní)
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions-Policy — zakazuje vše, co nepotřebujeme. `unload=()` přidáno 2024
  # kvůli BFCache (zpětné šipky v prohlížeči). Bez něj se stránka po `back` načítá znovu = pomalé.
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=(), browsing-topics=(), accelerometer=(), gyroscope=(), magnetometer=(), midi=(), bluetooth=(), display-capture=(), fullscreen=(self), picture-in-picture=(), unload=()"

  # Cross-origin policies — povolujeme, aby Google obrázky / sociální sítě mohly preview
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "cross-origin"

  # DNS prefetch zapnutý — rychlejší navigace na externí (Maps, GTM)
  Header always set X-DNS-Prefetch-Control "on"

  # Odstranit identifikační hlavičky
  Header unset X-Powered-By
  Header unset Server
  Header always unset X-Powered-By
</IfModule>

# --- 3) MIME types ---------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType image/svg+xml .svg .svgz
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType application/manifest+json .webmanifest
  AddType application/xml .xml
  AddType text/plain .txt
</IfModule>

# --- 4) Cache: Expires (Last-Modified-based) -------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML — vždy revalidace (rychlé deploys bez stale cache)
  ExpiresByType text/html                       "access plus 0 seconds"
  ExpiresByType application/xhtml+xml           "access plus 0 seconds"

  # Hashované assety — 1 rok
  ExpiresByType text/css                        "access plus 1 year"
  ExpiresByType application/javascript          "access plus 1 year"
  ExpiresByType text/javascript                 "access plus 1 year"

  # Fonty — 1 rok
  ExpiresByType font/woff2                      "access plus 1 year"
  ExpiresByType font/woff                       "access plus 1 year"

  # Obrázky — 1 měsíc. Názvy fotek nejsou content-hashované (sémantické slugy),
  # delší cache znamenala, že vyměněná fotka zůstala vracejícím se návštěvníkům stará.
  ExpiresByType image/webp                      "access plus 1 month"
  ExpiresByType image/avif                      "access plus 1 month"
  ExpiresByType image/svg+xml                   "access plus 1 month"
  ExpiresByType image/png                       "access plus 1 month"
  ExpiresByType image/jpeg                      "access plus 1 month"
  ExpiresByType image/gif                       "access plus 1 month"
  ExpiresByType image/x-icon                    "access plus 1 month"
  ExpiresByType image/vnd.microsoft.icon        "access plus 1 month"

  # Sitemap / robots / manifest — krátký cache (mění se nezávisle na buildu)
  ExpiresByType application/manifest+json       "access plus 1 week"
  ExpiresByType application/xml                 "access plus 1 day"
  ExpiresByType text/xml                        "access plus 1 day"
  ExpiresByType text/plain                      "access plus 1 week"
</IfModule>

# --- 5) Cache-Control overlay (přesnější než Expires) ----------------------
<IfModule mod_headers.c>
  # Hashované assety od Astra → immutable (filename obsahuje hash, nikdy se nezmění)
  <FilesMatch "\.(css|js|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Obrázky → 30 dní, ne immutable. Názvy nejsou hashované — po výměně fotky
  # pod stejným slugem se změna propíše vracejícím se návštěvníkům do měsíce.
  <FilesMatch "\.(webp|avif|svg|jpg|jpeg|png|gif|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # Favicony — krátký cache (1 den), aby update favikony rychle prošel browsery.
  # MUSÍ být PO obecné image pravidle — pozdější Header set vyhrává.
  <FilesMatch "^(favicon\.ico|favicon\.svg|apple-touch-icon\.png)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>

  # HTML → fresh, ale využij ETag/304
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Sitemap / robots / llms.txt → krátký cache
  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # Manifest
  <FilesMatch "\.webmanifest$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# --- 6) ETags off ----------------------------------------------------------
# Cache-Control + Last-Modified stačí. ETags komplikují CDN/multi-server.
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>
FileETag None

# --- 7) Compression --------------------------------------------------------
# LiteSpeed na Hostinger má Brotli automaticky. mod_deflate = gzip fallback.
# NEKOMPRIMUJEME woff2 / webp / avif / jpg / png — už jsou komprimované (waste CPU).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/ld+json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/atom+xml
  AddOutputFilterByType DEFLATE application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/eot
</IfModule>

# --- 8) LiteSpeed cache (Hostinger native) ---------------------------------
<IfModule LiteSpeed>
  # Public cache pro statické HTML — 1h na edge, browser cache řízen Cache-Control výše.
  # PHP (send.php) z cache vynechat: `.*` do ní dřív pouštělo i skript, LiteSpeed držel jeho
  # odpověď hodinu navzdory `Cache-Control: no-store` a nerozlišoval ani hlavičku Accept
  # (11. 9. 2026: GET /send.php → X-LiteSpeed-Cache: hit, stará 405 místo 303).
  CacheLookup on
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !\.php$ [NC]
  RewriteRule .* - [E=Cache-Control:max-age=3600]
  RewriteRule \.php$ - [NC,E=Cache-Control:no-cache]
</IfModule>

# --- 9) Block dotfiles + citlivé soubory -----------------------------------
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<FilesMatch "\.(env|ini|log|sh|sql|conf|bak|backup|swp|fla|psd|ai|sketch|md|yml|yaml)$">
  Require all denied
</FilesMatch>

# PHP na hostingu píše chybový log jako `error_log` BEZ přípony do adresáře skriptu —
# pravidlo výš ho proto nechytí a byl by veřejně čitelný (cesty na disku, varování).
<Files "error_log">
  Require all denied
</Files>

# Povolit veřejné meta soubory
<Files "site.webmanifest">
  Require all granted
</Files>
<Files "robots.txt">
  Require all granted
</Files>
<Files "llms.txt">
  Require all granted
</Files>
<Files "sitemap.xml">
  Require all granted
</Files>
<Files "sitemap-en.xml">
  Require all granted
</Files>
<Files "sitemap-index.xml">
  Require all granted
</Files>
<Files "favicon.svg">
  Require all granted
</Files>
<Files "apple-touch-icon.png">
  Require all granted
</Files>

# --- 10) 404 (custom Astro 404 stránka) ------------------------------------
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
